{
  "expo": {
    "name": "Nenjukku Neethi",
    "slug": "nenjukku-neethi",
    "scheme": "nenjukkuneethi",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E5D63"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.nenjukkuneethi.app",
      "associatedDomains": [
        "applinks:nenjukkuneethi.org"
      ],
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "org.nenjukkuneethi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E5D63"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nenjukkuneethi.org"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      "expo-asset"
    ],
    "extra": {
      "origin": "https://nenjukkuneethi.org",
      "manifestPath": "/data/app/manifest.v1.json"
    }
  }
}
