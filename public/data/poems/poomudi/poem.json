 "tamil": {
  "elements": [
   {
    "kind": "line",
    "text": "அறிவுமணங் கமழுகின்ற அண்ணன் தலைமீது",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "பொன்வைத்தால் நோகுமென்று",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "பூவாலே முடி வைத்தார்.",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "பூவிதழின் மென்மையினும் மென்மையான",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "புனித உள்ளம் — அன்பு உள்ளம் —",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "அரவணைக்கும் அண்ணன் உள்ளம் — அவர்",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "மலர் இதழ்கள் தமிழ் பேசும் —",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "மா, பலா, வாழையெனும் முக்கனியும். தோற்றுவிடும்!",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "விழிமலர்கள் வேலாகும் — வாளாகும்",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "தீங்கொன்று தமிழ்த் தாய்க்கு வருகுதென்றால் !",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "கால்மலர்கள் வாடிடினும் — அவர்",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "கடும்பயணம் நிற்காது !",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "கைமலர்கள் பிணைத்து நிற்கும், தம்பியரை-கழகத்தை!",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "அம்மலரே எதிரிகளை மன்னித்து",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "நெற்கதிர் போல் தலைநாணச் செய்துவிடும்",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "மக்களாட்சி மலர் குலுங்க,",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "சமதர்மப் பூ மணக்க,",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "தாய்மொழி தமிழே வாழ்வுப் பொழிலாக,",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "ஆடிவரும் தென்றல்",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "நாடிவரும் பூ முடியே ! புகழ்முடியே ! உமைத்",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "தேடிவரும் வாழ்த்துக் குவியலிலே தினம்",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "பாடிவரும் வண்டாக நான் பறப்பேன்...",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "உனைக்காக்க எனைத் துறப்பேன்.",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   },
   {
    "kind": "stanza-break",
    "evidence": "source-blank-line",
    "sourceScan": 4
   },
   {
    "kind": "line",
    "text": "மு.கருணாநிதி",
    "indent": 0,
    "sourceScan": 4,
    "printedPage": null
   }
  ],
  "lineCount": 24,
  "inPageStanzaBreaks": 1,
