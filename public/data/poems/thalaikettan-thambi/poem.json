    "indent": 0,
    "sourceScan": 22,
    "printedPage": null
   },
   {
    "kind": "line",
    "text": "அடுத்தார் பேச்சால் அழிந்த தம்பி",
    "indent": 0,
    "sourceScan": 22,
    "printedPage": null
   },
   {
    "kind": "stanza-break",
    "evidence": "source-blank-line",
    "sourceScan": 22
   },
   {
    "kind": "line",
    "text": "*",
    "indent": 0,
