    "kind": "stanza-break",
    "evidence": "source-blank-line",
    "sourceScan": 22
   },
   {
    "kind": "line",
    "text": "பாலையிற் சோலையைக் கண்டது போலும்",
    "indent": 0,
    "sourceScan": 22,
    "printedPage": null
   },
