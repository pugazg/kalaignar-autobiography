    "segments": [
     {
      "text": "ஒரு பெண்ணைப் பார்த்து, ‘ஆலமரத்தடிப் பிள்ளையாரை ஆறு முறை சுற்றி வந்தால் உனக்குக் கர்ப்பம் தரிக்கும்’ என்று ஒருவன் சொன்னான்.",
      "sourceScan": 15,
      "printedPage": 14,
      "joinToNext": "end"
     }
    ]
   },
   {
    "kind": "paragraph",
    "segments": [
     {
      "text": "அந்தப் பெண், ‘இப்போதே எனக்கு ஆறு மாத கர்ப்பம்’ என்று சொன்னாள்.",
      "sourceScan": 15,
      "printedPage": 14,
      "joinToNext": "end"
     }
    ]
   }
  ]
 },
 "english": {
  "blocks": [
   {
    "kind": "heading",
    "text": "She Said",
    "sourceScan": 15,
    "printedPage": 14
   },
   {
    "kind": "paragraph",
    "segments": [
     {
      "text": "A man said to a woman, ‘If you go around the Pillaiyar beneath the banyan tree six times, you will become pregnant.’",
      "sourceScan": 15,
      "printedPage": 14,
      "joinToNext": "end"
     }
    ]
   },
   {
    "kind": "paragraph",
    "segments": [
     {
      "text": "The woman said, ‘I am already six months pregnant.’",
      "sourceScan": 15,
      "printedPage": 14,
      "joinToNext": "end"
     }
    ]
   }
  ]
