{
 "workId": "uyirukku-vilai-aimbathu-latcham",
 "slug": "uyirukku-vilai-aimbathu-latcham",
 "sourceRepo": "pugazg/kalaignar-short-stories",
 "sourcePath": "stories/uyirukku-vilai-aimbathu-latcham",
