  "sections": [
    {
      "ordinal": 1,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-043-s01-l001",
          "tamil": "“உங்கள் ஓட்டு கதிரவனுக்கா, எங்கள் ஓட்டு கதிரவனுக்கே",
          "english": "“Is your vote for the Rising Sun? Our vote is for the Rising Sun itself,"
        },
        {
          "id": "kalaignar-song-en-043-s01-l002",
          "tamil": "நாட்டு நடப்ப பார்த்து போடுங்கம்மா ஓட்டு”",
          "english": "Look at how the country is going and cast your vote, amma.”"
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-043-s02-l001",
          "tamil": "ஆற, அமர கொஞ்சம் யோசிச்சுப் பாரு",
          "english": "Calmly, at ease, think a little and see,"
        },
        {
          "id": "kalaignar-song-en-043-s02-l002",
          "tamil": "நீ அடுத்தவரும் தலைமுறையே சிந்தித்துப் பாரு",
          "english": "Think and see about the generation that comes next,"
        },
        {
          "id": "kalaignar-song-en-043-s02-l003",
          "tamil": "ஏற, இறங்க பாத்து எடைகளைப் போடு",
          "english": "Look at the rise and fall and place the weights,"
        },
        {
          "id": "kalaignar-song-en-043-s02-l004",
          "tamil": "நீ எத்தனுக்கும் பித்தனுக்கும் தடைகளைப் போடு",
          "english": "Put barriers before the trickster and the madman,"
        },
        {
          "id": "kalaignar-song-en-043-s02-l005",
          "tamil": "(ஆற, அமர)",
          "english": "(Calmly, at ease)."
        }
      ]
    },
    {
      "ordinal": 3,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-043-s03-l001",
          "tamil": "ஓட்டுக்கு உன்னிடத்தில் வருபவன் யாரு",
          "english": "Who is the one who comes to you for your vote?"
        },
        {
          "id": "kalaignar-song-en-043-s03-l002",
          "tamil": "உழைப்பவனா, ஊரை ஏய்ப்பவனா",
          "english": "A worker — or one who cheats the town?"
        },
        {
          "id": "kalaignar-song-en-043-s03-l003",
          "tamil": "தேர்தல் களத்தினிலே நிற்பவன் யாரு",
          "english": "Who is the one standing in the election field?"
        },
        {
          "id": "kalaignar-song-en-043-s03-l004",
          "tamil": "தியாகம் செஞ்ச வரை மோசம் செஞ்சவரு",
          "english": "Those who made sacrifice; those who committed fraud,"
        },
        {
          "id": "kalaignar-song-en-043-s03-l005",
          "tamil": "ஓட்டுக்கு பணம் கொடுக்கும் உலுத்தர்களை நம்பாதேப்பா",
          "english": "Do not trust the wretches who give money for votes, appa,"
        },
        {
          "id": "kalaignar-song-en-043-s03-l006",
          "tamil": "நாட்டுக்கு உயிர் கொடுக்கும் நல்லவரை தள்ளாதேப்பா",
          "english": "Do not push away the good one who gives his life for the country, appa,"
        },
        {
          "id": "kalaignar-song-en-043-s03-l007",
          "tamil": "லஞ்சப் பேய்களை வெறுக்கணுமே",
          "english": "We must hate the bribe-demons,"
        },
        {
          "id": "kalaignar-song-en-043-s03-l008",
          "tamil": "ஏழை துன்பம் தீர்ப்பவரே ஜெயிக்கணுமே... அதுக்கு",
          "english": "The one who ends the poor man's suffering must win... for that,"
        },
        {
          "id": "kalaignar-song-en-043-s03-l009",
          "tamil": "(ஆற அமர)",
          "english": "(Calmly, at ease)."
        }
      ]
    },
    {
      "ordinal": 4,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-043-s04-l001",
          "tamil": "என்ன விலை கேட்டு, போடுங்கம்மா ஓட்டு",
          "english": "Ask what price — cast your vote, amma,"
        },
        {
          "id": "kalaignar-song-en-043-s04-l002",
          "tamil": "அரிசி விலையை பாத்து போடுங்கம்மா ஓட்டு",
          "english": "Look at the price of rice and cast your vote, amma,"
        },
        {
          "id": "kalaignar-song-en-043-s04-l003",
          "tamil": "இந்த படை போதுமா, இன்னும் கொஞ்சம் வேணுமா",
          "english": "Is this force enough, or do you want a little more?"
        },
        {
          "id": "kalaignar-song-en-043-s04-l004",
          "tamil": "கொள்கையே இல்லாத கொடியவன் யாரு",
          "english": "Who is the cruel one with no principle at all?"
        },
        {
          "id": "kalaignar-song-en-043-s04-l005",
          "tamil": "கொடுமைக்குப் பணியா வீரனும் யாரு",
          "english": "Who is the warrior who will not bow to cruelty?"
        },
        {
          "id": "kalaignar-song-en-043-s04-l006",
          "tamil": "ஊழல் புரிஞ்சி வாழும் மனுஷன் யாரு",
          "english": "Who is the man who lives practising corruption?"
        },
        {
          "id": "kalaignar-song-en-043-s04-l007",
          "tamil": "அதை ஊருக்குச் சொல்லும் உயர்ந்தவன் யாரு",
          "english": "Who is the noble one who tells the town about it?"
        },
        {
          "id": "kalaignar-song-en-043-s04-l008",
          "tamil": "உறவுக்கு கரம் கொடுப்பான் எங்க வீட்டு தம்பியப்பா",
          "english": "For kinship he will give his hand — our house's thambi, appa,"
        },
        {
          "id": "kalaignar-song-en-043-s04-l009",
          "tamil": "உரிமைக்கு குரல் கொடுப்பான் தென்பாண்டி சிங்கமப்பா",
          "english": "For rights he will give his voice — the Thenpandi lion, appa,"
        },
        {
          "id": "kalaignar-song-en-043-s04-l010",
          "tamil": "உதயக் கதிருதான் உதிக்குது பாரு உடன் பிறப்பே நீ ஒன்றாக சேரு",
          "english": "See, the rising ray itself is rising — O udanpirappe, come together as one,"
        },
        {
          "id": "kalaignar-song-en-043-s04-l011",
          "tamil": "(ஆற, அமர)",
          "english": "(Calmly, at ease)."
        }
      ]
    }
  ]
}
