  "sections": [
    {
      "ordinal": 1,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-023-s01-l001",
          "tamil": "வீணா!...",
          "english": "Veena!..."
        },
        {
          "id": "kalaignar-song-en-023-s01-l002",
          "tamil": "வாலி!...",
          "english": "Vaali!..."
        },
        {
          "id": "kalaignar-song-en-023-s01-l003",
          "tamil": "அது போலி!...",
          "english": "That is fake!..."
        },
        {
          "id": "kalaignar-song-en-023-s01-l004",
          "tamil": "கண்ணற்ற தகப்பனுக்கு பெண்ணாகப் பிறந்தவளே!",
          "english": "O girl born to a blind father!"
        },
        {
          "id": "kalaignar-song-en-023-s01-l005",
          "tamil": "எண்ணற்ற பொய் சொல்லி என்னையே மாற்றிய என் தங்கமே!",
          "english": "My gold, who told countless lies and changed even me!"
        },
        {
          "id": "kalaignar-song-en-023-s01-l006",
          "tamil": "பூனை கண்ணை மூடிக்கொண்டால் பூலோகம் இருண்டு",
          "english": "If a cat closes its eyes, will the whole world turn dark,"
        },
        {
          "id": "kalaignar-song-en-023-s01-l007",
          "tamil": "போகுமோ? மியாவ் மியாவ்",
          "english": "Will it? Meow, meow,"
        },
        {
          "id": "kalaignar-song-en-023-s01-l008",
          "tamil": "வானை நோக்கித் திரையைப் போட்டால் வட்ட நிலவும்",
          "english": "If a curtain is drawn facing the sky, will the round moon,"
        },
        {
          "id": "kalaignar-song-en-023-s01-l009",
          "tamil": "மறைந்து போகுமோ?",
          "english": "Disappear?"
        },
        {
          "id": "kalaignar-song-en-023-s01-l010",
          "tamil": "(கண்)",
          "english": "(Kan)"
        },
        {
          "id": "kalaignar-song-en-023-s01-l011",
          "tamil": "கெட்டிக்காரன் பொய்யும் புரட்டும் எட்டு நாளைக்கு - இந்தக்",
          "english": "A clever man's lies and twists last eight days — but this,"
        },
        {
          "id": "kalaignar-song-en-023-s01-l012",
          "tamil": "கட்டிக் கரும்பின் பொய்யும் புரட்டும் எத்தனை நாளைக்கு? ஆ!",
          "english": "Bundled sugarcane's lies and twists — how many days will they last? Ah!"
        },
        {
          "id": "kalaignar-song-en-023-s01-l013",
          "tamil": "(கண்)",
          "english": "(Kan)"
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": "வசனம் : ராணி",
      "labelEn": "Dialogue: Rani",
      "lines": [
        {
          "id": "kalaignar-song-en-023-s02-l001",
          "tamil": "நான் ஒண்ணும் பொய் சொல்லலே",
          "english": "I didn't tell any lies at all,"
        },
        {
          "id": "kalaignar-song-en-023-s02-l002",
          "tamil": "எல்லாம் உண்மைதான்...",
          "english": "It is all true..."
        }
      ]
    },
    {
      "ordinal": 3,
      "sourceLabelTa": "பாட்டு: ராஜா",
      "labelEn": "Song: Raja",
      "lines": [
        {
          "id": "kalaignar-song-en-023-s03-l001",
          "tamil": "அரிச்சந்திரன் வீட்டுக்கு அடுத்த வீட்டுப் பெண்ணே!",
          "english": "O girl from the house next door to Harishchandra!"
        },
        {
          "id": "kalaignar-song-en-023-s03-l002",
          "tamil": "அநியாயமாய் உண்மை சொல்வதிலே உனக்கு",
          "english": "In speaking truth so unjustly, who,"
        },
        {
          "id": "kalaignar-song-en-023-s03-l003",
          "tamil": "அவனியிலே நிகர்யாரு கண்ணே!",
          "english": "On this earth can equal you, dear!"
        }
      ]
    },
    {
      "ordinal": 4,
      "sourceLabelTa": "வசனம்",
      "labelEn": "Dialogue",
      "lines": [
        {
          "id": "kalaignar-song-en-023-s04-l001",
          "tamil": "ராணி : ராஜா!",
          "english": "Rani: Raja!"
        },
        {
          "id": "kalaignar-song-en-023-s04-l002",
          "tamil": "ராஜா : ராணி!",
          "english": "Raja: Rani!"
        },
        {
          "id": "kalaignar-song-en-023-s04-l003",
          "tamil": "ராணி : ஆ!... (வியப்பு)",
          "english": "Rani: Ah!... (astonishment)"
        }
      ]
    },
    {
      "ordinal": 5,
      "sourceLabelTa": "பாட்டு: ராஜா",
      "labelEn": "Song: Raja",
      "lines": [
        {
          "id": "kalaignar-song-en-023-s05-l001",
          "tamil": "சீட்டுக் கட்டு ராணி போலே",
          "english": "Like the queen in a deck of cards,"
        },
        {
          "id": "kalaignar-song-en-023-s05-l002",
          "tamil": "சிக்கிவிட்டாய் பெண்மயிலே",
          "english": "You've been caught, peahen,"
        },
        {
          "id": "kalaignar-song-en-023-s05-l003",
          "tamil": "வாட்டமே இல்லாமலே வாழலாம்",
          "english": "We can live without distress,"
        },
        {
          "id": "kalaignar-song-en-023-s05-l004",
          "tamil": "பூங்குயிலே!",
          "english": "Flower-cuckoo!"
        },
        {
          "id": "kalaignar-song-en-023-s05-l005",
          "tamil": "கிளாவர் ராணி! உனக்கு என்ன வேணுமின்னு கேளு!...",
          "english": "Clavar Queen! Ask what you want!..."
        },
        {
          "id": "kalaignar-song-en-023-s05-l006",
          "tamil": "ஆட்டின் ராணி போல ஆடு",
          "english": "Dance like the queen of dance,"
        },
        {
          "id": "kalaignar-song-en-023-s05-l007",
          "tamil": "டைமன் ராணி போல பாடு",
          "english": "Sing like the Daiman Queen,"
        },
        {
          "id": "kalaignar-song-en-023-s05-l008",
          "tamil": "அட இஸ்பேட் ராணி!",
          "english": "Hey, Ispade Queen!"
        },
        {
          "id": "kalaignar-song-en-023-s05-l009",
          "tamil": "ஏனிந்த சோகமோ?",
          "english": "Why this sorrow?"
        },
        {
          "id": "kalaignar-song-en-023-s05-l010",
          "tamil": "என்மேல் என்ன கோபமோ?",
          "english": "What anger have you against me?"
        },
        {
          "id": "kalaignar-song-en-023-s05-l011",
          "tamil": "உண்மை சொன்ன பாபமோ?",
          "english": "Is it the sin of telling the truth?"
        },
        {
          "id": "kalaignar-song-en-023-s05-l012",
          "tamil": "உன் மனதில் என்ன தாபமோ?",
          "english": "What yearning is in your heart?"
        }
      ]
    }
  ]
}
