      "labelEn": "Madanan",
      "lines": [
        {
          "id": "kalaignar-song-en-030-s04-l001",
          "tamil": "கலகம் வருவது எதனாலே?",
          "english": "Why does kalagam — commotion — come?"
        },
        {
          "id": "kalaignar-song-en-030-s04-l002",
          "tamil": "கலயம் பொங்குது அதனாலே",
