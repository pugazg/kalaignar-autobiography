      "lines": [
        {
          "id": "kalaignar-song-en-042-s01-l001",
          "tamil": "சுருளு மீசைக்காரனடி வேலுத்தம்பி",
          "english": "Curled-moustached Veluthambi, di,"
        },
        {
          "id": "kalaignar-song-en-042-s01-l002",
          "tamil": "சூராதி சூரனடி வேலுத்தம்பி",
          "english": "Hero beyond heroes, Veluthambi, di,"
        },
        {
          "id": "kalaignar-song-en-042-s01-l003",
          "tamil": "சூரியனில் நெருப்பெடுப்பான், சூழ்ச்சிகளை கொளுத்திடுவான்",
          "english": "He will take fire from the sun and burn conspiracies,"
        },
        {
          "id": "kalaignar-song-en-042-s01-l004",
          "tamil": "சுருளு மீசைக்காரனடி வேலுத்தம்பி",
          "english": "Curled-moustached Veluthambi, di,"
        },
        {
          "id": "kalaignar-song-en-042-s01-l005",
          "tamil": "சூராதி சூரனடி வேலுத்தம்பி",
          "english": "Hero beyond heroes, Veluthambi, di,"
        },
        {
          "id": "kalaignar-song-en-042-s01-l006",
          "tamil": "ஏறிமலையில் அடுப்பெரிப்பான், ஏழையர்க்கு உணவளிப்பான்",
          "english": "On the eeri-malai he will light a stove and feed the poor,"
        },
        {
          "id": "kalaignar-song-en-042-s01-l007",
          "tamil": "எங்கள் குல தெய்வமாவான் அவன் தங்ககுல சிங்கமாவான்",
          "english": "He will become our clan-deity; he will become the golden-clan lion,"
        },
        {
          "id": "kalaignar-song-en-042-s01-l008",
          "tamil": "பூகம்ப மேடையிலே புரட்சி கீதம் பாடிடுவான்",
          "english": "On the earthquake-stage he will sing the song of revolution,"
        },
        {
          "id": "kalaignar-song-en-042-s01-l009",
          "tamil": "பொல்லாதோர் படையெல்லாம் பொடிப்பொடியா ஆக்கிடுவான்",
          "english": "He will make the whole army of the wicked into powder, powder,"
        },
        {
          "id": "kalaignar-song-en-042-s01-l010",
          "tamil": "(சுருளு மீசைக்காரனடி)",
          "english": "(Curled-moustached one, di)."
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": "குழு",
      "labelEn": "Group",
      "lines": [
        {
          "id": "kalaignar-song-en-042-s02-l001",
          "tamil": "கும்மியடிப் பெண்ணே கும்மியடி குலவைப் போட்டுக் கும்மியடி",
          "english": "Dance kummi, woman — dance kummi, raise the kulavai and dance kummi,"
        },
        {
          "id": "kalaignar-song-en-042-s02-l002",
          "tamil": "கும்மியடிப் பெண்ணே கும்மியடி குலவைப் போட்டுக் கும்மியடி",
          "english": "Dance kummi, woman — dance kummi, raise the kulavai and dance kummi."
        }
      ]
    },
    {
      "ordinal": 3,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-042-s03-l001",
          "tamil": "கடமைக்குத்தான் உயிர் கொடுப்பான்",
          "english": "He will give his life only for duty,"
        },
        {
          "id": "kalaignar-song-en-042-s03-l002",
          "tamil": "கண்ணியத்தைக் காத்து நிற்பான்",
          "english": "He will stand guarding dignity,"
        },
        {
          "id": "kalaignar-song-en-042-s03-l003",
          "tamil": "இந்த தம்பியிருந்தா படைக்கு பயமில்லே",
          "english": "If this thambi is here, the army has no fear,"
        },
        {
          "id": "kalaignar-song-en-042-s03-l004",
          "tamil": "இந்த தத்துவத்தைத்தான் மறந்து போனதில்லே",
          "english": "He has never forgotten this philosophy,"
        },
        {
          "id": "kalaignar-song-en-042-s03-l005",
          "tamil": "தனியுடைமைக்கு தடைவிதித்து பொதுவுடைமைக்கு போர்தொடுத்து",
          "english": "Placing a ban on private ownership, waging struggle for common ownership,"
        },
        {
          "id": "kalaignar-song-en-042-s03-l006",
          "tamil": "தும்பியைப் போல் பறந்து வந்து துன்பங்களை தீர்த்துவைப்பான்",
          "english": "Flying in like a thumbi, he will come and end suffering."
        }
      ]
    }
  ]
}
