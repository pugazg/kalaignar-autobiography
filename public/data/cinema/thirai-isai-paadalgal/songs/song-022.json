      "lines": [
        {
          "id": "kalaignar-song-en-022-s01-l001",
          "tamil": "மணிப் புறா!...",
          "english": "Jewel-dove!..."
        },
        {
          "id": "kalaignar-song-en-022-s01-l002",
          "tamil": "புது மணிப் புறா!... புத்தம்",
          "english": "New jewel-dove!... brand-new,"
        },
        {
          "id": "kalaignar-song-en-022-s01-l003",
          "tamil": "புது மணிப் புறா!... நானேதான்",
          "english": "New jewel-dove!... it is I,"
        },
        {
          "id": "kalaignar-song-en-022-s01-l004",
          "tamil": "மேவிடும் அன்பால்",
          "english": "Through the love that dwells,"
        },
        {
          "id": "kalaignar-song-en-022-s01-l005",
          "tamil": "தாவிடும் உன்பால் நெஞ்சம்",
          "english": "My heart leaps toward you,"
        },
        {
          "id": "kalaignar-song-en-022-s01-l006",
          "tamil": "பூ விரித்து அழைக்குது மஞ்சம்",
          "english": "The bed spreads flowers and calls,"
        },
        {
          "id": "kalaignar-song-en-022-s01-l007",
          "tamil": "பூமானே வாராய் கொஞ்சம்",
          "english": "Poomaane, come a little closer,"
        },
        {
          "id": "kalaignar-song-en-022-s01-l008",
          "tamil": "ரோஜாக் கொல்லை முல்லைத் தோட்டம்",
          "english": "A rose enclosure, a jasmine garden,"
        },
        {
          "id": "kalaignar-song-en-022-s01-l009",
          "tamil": "எந்தன் முகந்தானே",
          "english": "That is my very face,"
        },
        {
          "id": "kalaignar-song-en-022-s01-l010",
          "tamil": "ராஜா உமக்கு நான்தான் ராணி",
          "english": "Raja, for you I alone am the queen,"
        },
        {
          "id": "kalaignar-song-en-022-s01-l011",
          "tamil": "தருவேன் சுகந்தானே",
          "english": "I shall give you pleasure indeed."
        }
      ]
    }
  ]
}
