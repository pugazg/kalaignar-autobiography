  "songNumber": 49,
  "filmId": "kalaignar-song-film-020",
  "filmSlug": "film-20",
  "filmTitleTa": "கண்ணம்மா",
  "yearPrinted": 2005,
  "titleTa": "என் இரு விழி மழைதனை காணாதே",
  "titleEn": "Do not look at the rain of my two eyes",
  "authorship": {
    "decision": "established-kalaignar",
    "publicDisplay": true,
    "publicAuthorshipClaim": true,
    "authorshipNoticeRequired": false,
    "noticeGroupId": null
  },
  "sections": [
    {
      "ordinal": 1,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-049-s01-l001",
          "tamil": "என் இரு விழி மழைதனை காணாதே",
          "english": "Do not look at the rain of my two eyes,"
        },
        {
          "id": "kalaignar-song-en-049-s01-l002",
          "tamil": "என் இதயம் மகிழ்வதை காண்பீரே",
          "english": "Look instead at my heart rejoicing,"
        },
        {
          "id": "kalaignar-song-en-049-s01-l003",
          "tamil": "போர்வாள் ஏந்தி என் மகன் பொன்முடி",
          "english": "My son Ponmudi, bearing the battle-sword,"
        },
        {
          "id": "kalaignar-song-en-049-s01-l004",
          "tamil": "புல்லரை வீழ்த்தி உயிர்துறந்தான்",
          "english": "Struck down the base men and gave up his life,"
        },
        {
          "id": "kalaignar-song-en-049-s01-l005",
          "tamil": "புல்லரை வீழ்த்தி உயிர் துறந்தான்",
          "english": "Struck down the base men and gave up his life,"
        },
        {
          "id": "kalaignar-song-en-049-s01-l006",
          "tamil": "(என் இரு விழி)",
          "english": "(My two eyes)."
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-049-s02-l001",
          "tamil": "காதலுக்கு தடைசொல்லக் கூடாதென்று - ஒரு",
          "english": "Saying love must not be forbidden — I joined to him,"
        },
        {
          "id": "kalaignar-song-en-049-s02-l002",
          "tamil": "கட்டழகுப் பெட்டகத்தை துணைசேர்த்த - அவன்",
          "english": "A casket of sculpted beauty as his companion —"
        },
        {
          "id": "kalaignar-song-en-049-s02-l003",
          "tamil": "கருத்துக்கு ஏற்றவொரு கன்னி இளமானை",
          "english": "A maiden young-deer suited to his thought,"
        },
        {
          "id": "kalaignar-song-en-049-s02-l004",
          "tamil": "களம் சென்று திரும்பியபின் மணமுடிக்க காத்திருந்தேன்",
          "english": "I waited to marry them after he returned from the field."
        }
      ]
    },
    {
      "ordinal": 3,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-049-s03-l001",
          "tamil": "அவனோ களிறுகளை பந்தாடி",
          "english": "But he played ball with the tuskers,"
        },
        {
          "id": "kalaignar-song-en-049-s03-l002",
          "tamil": "புரவிகளை பஞ்சாக்கி",
          "english": "Turned the steeds to cotton,"
        },
        {
          "id": "kalaignar-song-en-049-s03-l003",
          "tamil": "கயவர்களின் வாள்முனையை நெஞ்சில் தாங்கி",
          "english": "Bore the sword-points of the vile upon his chest,"
        },
        {
          "id": "kalaignar-song-en-049-s03-l004",
          "tamil": "காதலியை தவிக்கவிட்டு காலத்தை நகர்த்துகின்ற",
          "english": "Leaving his beloved to suffer as time moves on,"
        },
        {
          "id": "kalaignar-song-en-049-s03-l005",
          "tamil": "இந்தக் கிழவியையும் கண்ணீரில் மிதக்கவிட்டு",
          "english": "Leaving this old woman too floating in tears,"
        },
        {
          "id": "kalaignar-song-en-049-s03-l006",
          "tamil": "கடமையினை முடித்து விட்டான்",
          "english": "He finished his duty."
        }
      ]
    },
    {
      "ordinal": 4,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-049-s04-l001",
          "tamil": "களிப்பொரு பக்கம் கண்ணில் நீர் ஒரு பக்கம்",
          "english": "Joy on one side, water in the eye on one side,"
        },
        {
          "id": "kalaignar-song-en-049-s04-l002",
          "tamil": "களப்புகழ் பெற்ற மகனை வாழ்த்துகின்றேன்",
          "english": "I praise the son who won fame on the battlefield,"
        },
        {
          "id": "kalaignar-song-en-049-s04-l003",
          "tamil": "கருவில் சுமந்த தாயல்லவோ",
          "english": "Am I not the mother who bore him in the womb?"
        },
        {
          "id": "kalaignar-song-en-049-s04-l004",
          "tamil": "அதனால் வாடுகிறேன்",
          "english": "That is why I wither,"
        },
        {
          "id": "kalaignar-song-en-049-s04-l005",
          "tamil": "(என் இரு விழி)",
          "english": "(My two eyes)."
        }
      ]
    }
  ]
}
