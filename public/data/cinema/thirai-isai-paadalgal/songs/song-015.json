  "sections": [
    {
      "ordinal": 1,
      "sourceLabelTa": "முத்தாயி சோக கீதம்",
      "labelEn": "முத்தாயி — song of sorrow",
      "lines": [
        {
          "id": "kalaignar-song-en-015-s01-l001",
          "tamil": "காதல் துறையே புதுமைக் கனவே - மன",
          "english": "O realm of love, O new dream — O blissful flame"
        },
        {
          "id": "kalaignar-song-en-015-s01-l002",
          "tamil": "மேவும் இன்ப ஜோதியே ஓடிவா",
          "english": "That dwells in the heart, come running."
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": "(கா)",
      "labelEn": "(Kaa — source refrain cue)",
      "lines": [
        {
          "id": "kalaignar-song-en-015-s02-l001",
          "tamil": "(கா)",
          "english": "(Kaa — source refrain cue)"
        }
      ]
    },
    {
      "ordinal": 3,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-015-s03-l001",
          "tamil": "வானில் உலாவும் மாமுகில் காணும்போதிலே...",
          "english": "When I see the great cloud roaming the sky..."
        },
        {
          "id": "kalaignar-song-en-015-s03-l002",
          "tamil": "சோலைக் கலாபம் ஆடுதே...",
          "english": "The grove's plumage dances..."
        }
      ]
    },
    {
      "ordinal": 4,
      "sourceLabelTa": "(கா)",
      "labelEn": "(Kaa — source refrain cue)",
      "lines": [
        {
          "id": "kalaignar-song-en-015-s04-l001",
          "tamil": "(கா)",
          "english": "(Kaa — source refrain cue)"
        }
      ]
    },
    {
      "ordinal": 5,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-015-s05-l001",
          "tamil": "அன்பில் விளைந்த மாமணி...",
          "english": "O great gem born of love..."
        },
        {
          "id": "kalaignar-song-en-015-s05-l002",
          "tamil": "ஆனந்த வாழ்வின் செல்வம் நீ",
          "english": "You are the treasure of a blissful life,"
        },
        {
          "id": "kalaignar-song-en-015-s05-l003",
          "tamil": "தென்றலில் வீசும் கானமே",
          "english": "O song that drifts upon the breeze,"
        },
        {
          "id": "kalaignar-song-en-015-s05-l004",
          "tamil": "தேன்மழையே என் ஜீவனே",
          "english": "O honey-rain, my life,"
        },
        {
          "id": "kalaignar-song-en-015-s05-l005",
          "tamil": "இன்பத்தின் எல்லை காணவே",
          "english": "To behold the boundary of bliss,"
        },
        {
          "id": "kalaignar-song-en-015-s05-l006",
          "tamil": "துன்பத்தில் மடியில் தூங்குவோம்",
          "english": "In sorrow, let us sleep in the lap."
        }
      ]
    }
  ]
}
