      "lines": [
        {
          "id": "kalaignar-song-en-033-s01-l001",
          "tamil": "கன்னம் கன்னம் கன்னம் - சந்தனக்",
          "english": "Cheek, cheek, cheek — sandalwood"
        },
        {
          "id": "kalaignar-song-en-033-s01-l002",
          "tamil": "கிண்ணம் கிண்ணம் கிண்ணம் - என்",
          "english": "Bowl, bowl, bowl — my"
        },
        {
          "id": "kalaignar-song-en-033-s01-l003",
          "tamil": "வண்ணம் வண்ணம் வண்ணம் - காதல்",
          "english": "Colour, colour, colour — love's"
        },
        {
          "id": "kalaignar-song-en-033-s01-l004",
          "tamil": "சின்னம் சின்னம் சின்னம்",
          "english": "Sign, sign, sign,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l005",
          "tamil": "(கன்னம்)",
          "english": "(Cheek)"
        },
        {
          "id": "kalaignar-song-en-033-s01-l006",
          "tamil": "வாலிப விருந்து வழங்குவேன் அருந்து",
          "english": "I shall serve a feast of youth — drink it,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l007",
          "tamil": "ஆயிரம் சாகசம் இருக்குது கைவசம்",
          "english": "A thousand adventures are in my hands,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l008",
          "tamil": "வலிய வருது பறவை",
          "english": "The bird comes forcefully,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l009",
          "tamil": "வளர்க்கப் போகுது உறவை",
          "english": "It is going to grow the bond,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l010",
          "tamil": "நிலவு எரிக்குது நெருப்பாய்",
          "english": "The moon burns like fire,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l011",
          "tamil": "நீயும் தழுவி அணைப்பாய்",
          "english": "You too will embrace and hold me,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l012",
          "tamil": "(கன்னம்)",
          "english": "(Cheek)"
        },
        {
          "id": "kalaignar-song-en-033-s01-l013",
          "tamil": "பார்வையில் மயக்கம் பாவையென் பழக்கம்",
          "english": "Dizziness in the gaze — enchantment is this maiden's habit,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l014",
          "tamil": "பழம்போல் மேனி பார்த்தும் ஏன் தயக்கம்",
          "english": "Even seeing a body like fruit, why this hesitation?"
        },
        {
          "id": "kalaignar-song-en-033-s01-l015",
          "tamil": "மீன் இரண்டு உருளுது - இதழ்த்",
          "english": "Two fish are rolling — from the lips,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l016",
          "tamil": "தேன் இரண்டு பெருகுது",
          "english": "Two honeys are swelling,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l017",
          "tamil": "மான் இரண்டு துள்ளுது",
          "english": "Two deer are leaping,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l018",
          "tamil": "வான் இரண்டு அழைக்குது",
          "english": "Two skies are calling,"
        },
        {
          "id": "kalaignar-song-en-033-s01-l019",
          "tamil": "(கன்னம்)",
          "english": "(Cheek)."
        }
      ]
    }
  ]
}
