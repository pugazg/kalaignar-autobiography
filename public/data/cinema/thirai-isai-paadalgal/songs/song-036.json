      "lines": [
        {
          "id": "kalaignar-song-en-036-s01-l001",
          "tamil": "நெஞ்சுக்கு நீதியும்",
          "english": "Justice for the heart,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l002",
          "tamil": "தோளுக்கு வாளும்",
          "english": "A sword for the shoulder,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l003",
          "tamil": "நிறைந்த சுடர்மணி",
          "english": "A radiant gem, filled full —"
        },
        {
          "id": "kalaignar-song-en-036-s01-l004",
          "tamil": "பூண் பஞ்சுக்கு நேர்",
          "english": "Wear it. Like cotton,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l005",
          "tamil": "பல துன்பங்களெல்லாம்",
          "english": "Are all the many sufferings;"
        },
        {
          "id": "kalaignar-song-en-036-s01-l006",
          "tamil": "உன் பார்வைக்கு நேர் பெரும் தீ",
          "english": "Before your gaze — a great fire,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l007",
          "tamil": "வஞ்சனையின்றி பகையின்றி சூதின்றி",
          "english": "Without deceit, without enmity, without gambling,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l008",
          "tamil": "வையக மாந்தரெல்லாம் வாழ்வதற்கே",
          "english": "So that all the people of the world may live,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l009",
          "tamil": "கவி பாரதி பாடிய நீதி",
          "english": "The justice poet Bharathi sang,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l010",
          "tamil": "வாய்மைசேர் நெஞ்சுக்கு நீதி",
          "english": "Justice for the heart joined with truth,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l011",
          "tamil": "ஒருவரைப் பற்றி குறை கூறும் முன்னாலே",
          "english": "Before you speak of another person's fault,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l012",
          "tamil": "உன் முதுகை கொஞ்சம் திரும்பி பாரு பின்னாலே",
          "english": "Turn your own back a little and look behind,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l013",
          "tamil": "உத்தமர்கள் அறிவுரையை",
          "english": "The counsel of the noble,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l014",
          "tamil": "உதட்டளவில் நிறுத்தாமல்",
          "english": "Do not stop it merely at the lips,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l015",
          "tamil": "உள்ளத்தில் பதித்திடுவாய் அண்ணே",
          "english": "Imprint it in your heart, anne,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l016",
          "tamil": "சிந்தனை செம்மல்கள் காட்டிய நெறிகளை",
          "english": "The paths shown by the great ones of thought,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l017",
          "tamil": "செயல்களாய் குவித்திடு அண்ணே",
          "english": "Heap them up as deeds, anne,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l018",
          "tamil": "(ஒருவர்)",
          "english": "(One person)"
        },
        {
          "id": "kalaignar-song-en-036-s01-l019",
          "tamil": "சாதி மதங்களை சாய்ப்போம் என்று",
          "english": "Saying, 'Let us bring down caste and religions,'"
        },
        {
          "id": "kalaignar-song-en-036-s01-l020",
          "tamil": "புத்தர் காந்தி போதனை புரிந்தார்",
          "english": "Buddha and Gandhi gave their teaching,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l021",
          "tamil": "ஏழையின் சிரிப்பில் இறைவனைக் காண",
          "english": "To see God in the poor person's smile,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l022",
          "tamil": "அறிஞர் அண்ணா இங்கே பிறந்தார்",
          "english": "Arignar Anna was born here,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l023",
          "tamil": "கடமையை செய்வோம் உரிமையை பெறுவோம்",
          "english": "Let us do our duty; let us gain our rights,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l024",
          "tamil": "மடமையை மாய்த்திடுவோம்",
          "english": "Let us wipe away folly,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l025",
          "tamil": "மனிதராய் வாழ்ந்திடுவோம்",
          "english": "Let us live as human beings,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l026",
          "tamil": "(ஒருவர்)",
          "english": "(One person)"
        },
        {
          "id": "kalaignar-song-en-036-s01-l027",
          "tamil": "ஊழல் ஊழல் என்று தினம் பாடினாயே பாட்டு",
          "english": "'Corruption, corruption' — every day you sang that song,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l028",
          "tamil": "உன் முகத்தை நீயே ஒரு கண்ணாடியில் காட்டு",
          "english": "Show your own face in a mirror yourself,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l029",
          "tamil": "வீண் பழிபோடும் வேலை உனக்கு",
          "english": "This work of casting empty blame is not for you,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l030",
          "tamil": "ஆகாதுடாங்கப்பா",
          "english": "It won't do, appa,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l031",
          "tamil": "பெரும் தூண் என்று உன் தலையில் வீழுமப்பா",
          "english": "It will fall on your head like a great pillar, appa,"
        },
        {
          "id": "kalaignar-song-en-036-s01-l032",
          "tamil": "(ஒருவர்)",
          "english": "(One person)."
        }
      ]
    }
  ]
}
