      "lines": [
        {
          "id": "kalaignar-song-en-044-s01-l001",
          "tamil": "காவலுக்கு கெட்டிக்காரன் இந்த காக்கிச்சட்டைக்காரன்",
          "english": "A tough one for guarding — this khaki-shirt man,"
        },
        {
          "id": "kalaignar-song-en-044-s01-l002",
          "tamil": "தஞ்சாவூரு ஜில்லாக்காரன் அவன்",
          "english": "He is a fellow from Thanjavur district,"
        },
        {
          "id": "kalaignar-song-en-044-s01-l003",
          "tamil": "அஞ்சாநெஞ்சம் படச்ச வீரன்",
          "english": "A warrior made with a fearless heart,"
        },
        {
          "id": "kalaignar-song-en-044-s01-l004",
          "tamil": "சொன்னதை செய்வோமென்பான்",
          "english": "He will say, 'We will do what we said,'"
        },
        {
          "id": "kalaignar-song-en-044-s01-l005",
          "tamil": "அப்படி செய்ததையே சொல்வோமென்பான்",
          "english": "He will say only what he actually did,"
        },
        {
          "id": "kalaignar-song-en-044-s01-l006",
          "tamil": "நம்பிக்கையா நடந்துக்குவான்",
          "english": "He will conduct himself so as to be trusted,"
        },
        {
          "id": "kalaignar-song-en-044-s01-l007",
          "tamil": "நம்ப நாட்டுக்காக உழைச்சிடுவான்",
          "english": "He will work for our country,"
        },
        {
          "id": "kalaignar-song-en-044-s01-l008",
          "tamil": "மாமூலு வாங்கமாட்டான்",
          "english": "He will not take mamool,"
        },
        {
          "id": "kalaignar-song-en-044-s01-l009",
          "tamil": "நல்ல மனுஷங்கள் வெறுக்க மாட்டான்",
          "english": "He will not hate good people,"
        },
        {
          "id": "kalaignar-song-en-044-s01-l010",
          "tamil": "மனசாட்சி கடவுளென்பான்",
          "english": "He will say conscience is God,"
        },
        {
          "id": "kalaignar-song-en-044-s01-l011",
          "tamil": "நம்ப மக்களுக்கு தொண்டு செய்வான்",
          "english": "He will serve our people,"
        },
        {
          "id": "kalaignar-song-en-044-s01-l012",
          "tamil": "(காவலுக்கு கெட்டிக்காரன்)",
          "english": "(A tough one for guarding)."
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-044-s02-l001",
          "tamil": "வேலியே பயிரை மேயும் - அந்த",
          "english": "When the fence itself grazes the crop — that,"
        },
        {
          "id": "kalaignar-song-en-044-s02-l002",
          "tamil": "வேதனையை பொறுக்க மாட்டான்",
          "english": "He will not bear that pain,"
        },
        {
          "id": "kalaignar-song-en-044-s02-l003",
          "tamil": "வெள்ளாட்டு மேலே பாயும் - ஒரு",
          "english": "He will not be a vengai,"
        },
        {
          "id": "kalaignar-song-en-044-s02-l004",
          "tamil": "வேங்கையாக இருக்க மாட்டான்",
          "english": "Pouncing upon a white goat,"
        },
        {
          "id": "kalaignar-song-en-044-s02-l005",
          "tamil": "சாராயம் காய்ச்சும் கூட்டம் - இவன்",
          "english": "If the gang that brews illicit liquor,"
        },
        {
          "id": "kalaignar-song-en-044-s02-l006",
          "tamil": "சப்போர்ட்டு கேட்டுதுன்னா",
          "english": "Comes asking him for support,"
        },
        {
          "id": "kalaignar-song-en-044-s02-l007",
          "tamil": "சத்தியமா துடிச்சிடுவான்",
          "english": "By truth, he will flare up,"
        },
        {
          "id": "kalaignar-song-en-044-s02-l008",
          "tamil": "சவுக்காலே அடிச்சிடுவான்",
          "english": "He will strike with the whip,"
        },
        {
          "id": "kalaignar-song-en-044-s02-l009",
          "tamil": "பதுக்கலையும் கடத்தலையும்",
          "english": "Hoarding and smuggling,"
        },
        {
          "id": "kalaignar-song-en-044-s02-l010",
          "tamil": "பஞ்சு பஞ்சா பிச்சிடுவான்",
          "english": "He will tear them into cotton-fluff, cotton-fluff,"
        },
        {
          "id": "kalaignar-song-en-044-s02-l011",
          "tamil": "(காவலுக்கு கெட்டிக்காரன்)",
          "english": "(A tough one for guarding)."
        }
      ]
    }
  ]
}
