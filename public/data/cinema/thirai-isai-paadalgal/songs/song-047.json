  },
  "sections": [
    {
      "ordinal": 1,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-047-s01-l001",
          "tamil": "லல்லல லல்லல்லா",
          "english": "Lallala lallallaa,"
        },
        {
          "id": "kalaignar-song-en-047-s01-l002",
          "tamil": "கண்ணின் மணிபோல",
          "english": "Like the jewel of the eye,"
        },
        {
          "id": "kalaignar-song-en-047-s01-l003",
          "tamil": "கனியின் விதைபோல",
          "english": "Like the seed of a fruit,"
        },
        {
          "id": "kalaignar-song-en-047-s01-l004",
          "tamil": "மண்ணின் மைந்தர் நமக்குள்ளே",
          "english": "We sons of the soil, among ourselves —"
        },
        {
          "id": "kalaignar-song-en-047-s01-l005",
          "tamil": "கசப்பும் வெறுப்பும் எதுக்காக",
          "english": "Why bitterness and hatred?"
        },
        {
          "id": "kalaignar-song-en-047-s01-l006",
          "tamil": "மண்ணின் மைந்தர் வாழ்வதற்கு - இந்த",
          "english": "For the sons of the soil to live — in this"
        },
        {
          "id": "kalaignar-song-en-047-s01-l007",
          "tamil": "மண்ணில் உரிமை இல்லையா",
          "english": "Soil, is there no right?"
        },
        {
          "id": "kalaignar-song-en-047-s01-l008",
          "tamil": "கண்ணை காக்கும் கடமைதான்",
          "english": "The duty is to guard the eye —"
        },
        {
          "id": "kalaignar-song-en-047-s01-l009",
          "tamil": "இமைக்கு பெரிய தொல்லையா",
          "english": "Is that such a great trouble for the eyelid?"
        },
        {
          "id": "kalaignar-song-en-047-s01-l010",
          "tamil": "கடமை தவறி நடப்பதற்கு",
          "english": "If one walks forsaking duty,"
        },
        {
          "id": "kalaignar-song-en-047-s01-l011",
          "tamil": "காவல் எதற்கு சொல்லையா",
          "english": "What is guarding for? Tell me, ayya."
        },
        {
          "id": "kalaignar-song-en-047-s01-l012",
          "tamil": "(கண்ணின்)",
          "english": "(Like the jewel of the eye)."
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-047-s02-l001",
          "tamil": "விண்ணில் ஏறவும் கடலைச்சாடவும்",
          "english": "To climb the sky and leap across the sea,"
        },
        {
          "id": "kalaignar-song-en-047-s02-l002",
          "tamil": "வீரம் வேண்டும் விவேகம் மிகவும் வேண்டும்",
          "english": "Courage is needed; wisdom is needed even more,"
        },
        {
          "id": "kalaignar-song-en-047-s02-l003",
          "tamil": "விண்ணில் ஏறவும் கடலைச்சாடவும்",
          "english": "To climb the sky and leap across the sea,"
        },
        {
          "id": "kalaignar-song-en-047-s02-l004",
          "tamil": "வீரம் வேண்டும் விவேகம் மிகவும் வேண்டும்",
          "english": "Courage is needed; wisdom is needed even more,"
        },
        {
          "id": "kalaignar-song-en-047-s02-l005",
          "tamil": "வேற்றுமையில் ஒற்றுமை காண வேண்டும்",
          "english": "We must see unity in difference,"
        },
        {
          "id": "kalaignar-song-en-047-s02-l006",
          "tamil": "விரோத உணர்வு வேரோடு சாய வேண்டும்",
          "english": "The feeling of enmity must fall by the roots,"
        },
        {
          "id": "kalaignar-song-en-047-s02-l007",
          "tamil": "உறவுக்கு கைகொடுப்போம் உரிமைக்கு குரல் கொடுப்போம்",
          "english": "Let us give a hand for kinship; let us give voice for rights,"
        },
        {
          "id": "kalaignar-song-en-047-s02-l008",
          "tamil": "நாம் என்று சொல்லிப்பாருங்கள்",
          "english": "Say `naam` — we — and see,"
        },
        {
          "id": "kalaignar-song-en-047-s02-l009",
          "tamil": "உதடுகள் ஒட்டும் உறவுகள் மலரும்",
          "english": "The lips meet; relationships bloom,"
        },
        {
          "id": "kalaignar-song-en-047-s02-l010",
          "tamil": "நான் என்று சொல்லிப்பாருங்கள்",
          "english": "Say `naan` — I — and see,"
        },
        {
          "id": "kalaignar-song-en-047-s02-l011",
          "tamil": "உதடுகள் இணையாது உறவும் பிரிவாது",
          "english": "The lips do not join; the relationship too does not part,"
        },
        {
          "id": "kalaignar-song-en-047-s02-l012",
          "tamil": "(கண்ணின்)",
          "english": "(Like the jewel of the eye)."
        }
      ]
    }
  ]
}
