      "lines": [
        {
          "id": "kalaignar-song-en-024-s01-l001",
          "tamil": "பொதுநலம் என்றும் பொதுநலம்",
          "english": "Public welfare — always public welfare,"
        },
        {
          "id": "kalaignar-song-en-024-s01-l002",
          "tamil": "புகழ் உடலைக் காக்கும் மிகபுனிதமான செயல்",
          "english": "A most sacred act that guards the body of fame,"
        },
        {
          "id": "kalaignar-song-en-024-s01-l003",
          "tamil": "பொது நலம் என்றும் பொதுநலம்",
          "english": "Public welfare — always public welfare,"
        },
        {
          "id": "kalaignar-song-en-024-s01-l004",
          "tamil": "வீடுவாசல் மாடு மனை மக்கள் சுற்றம் போலாலும்",
          "english": "House, threshold, cattle, home, people and kin though there may be,"
        },
        {
          "id": "kalaignar-song-en-024-s01-l005",
          "tamil": "நாடு நம்நாடு நந்நாடு நாடென்று",
          "english": "Country — our country, good country — saying 'country',"
        },
        {
          "id": "kalaignar-song-en-024-s01-l006",
          "tamil": "நாமெல்லோரும் கூடிச் செய்யும் தியாகமே",
          "english": "It is the sacrifice we all make together,"
        },
        {
          "id": "kalaignar-song-en-024-s01-l007",
          "tamil": "(பொதுநலம்)",
          "english": "(Public welfare)"
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-024-s02-l001",
          "tamil": "நாட்டிலே எதுக்கும் லாயக்கில்லாமல்",
          "english": "Fit for nothing in the country,"
        },
        {
          "id": "kalaignar-song-en-024-s02-l002",
          "tamil": "வீட்டிலே எதுவும் வேலை செய்யாமல் - உடல்",
          "english": "Doing no work at all in the house — into the body,"
        },
        {
          "id": "kalaignar-song-en-024-s02-l003",
          "tamil": "கூட்டிலே தீனியை அடைத்து வாழும்",
          "english": "As into a cage, stuffing food and living,"
        },
        {
          "id": "kalaignar-song-en-024-s02-l004",
          "tamil": "உருப்படா மனிதனுக்குயிர் கொடுக்கும் மருந்து - நல்ல மருந்து",
          "english": "A medicine that gives life to the useless man — a good medicine."
        }
      ]
    },
    {
      "ordinal": 3,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-024-s03-l001",
          "tamil": "திண்ணைத் தூங்கிப் பண்டாரம்",
          "english": "The pandaaram who sleeps on the front veranda,"
        },
        {
          "id": "kalaignar-song-en-024-s03-l002",
          "tamil": "திருவோடேந்தும் பரதேசி",
          "english": "The paradesi bearing the sacred begging bowl,"
        },
        {
          "id": "kalaignar-song-en-024-s03-l003",
          "tamil": "தெருவிலே உருளும் திருப்பதி கோவிந்தா - கோவிந்தா",
          "english": "The Tirupati Govinda rolling in the street — Govinda, Govinda,"
        },
        {
          "id": "kalaignar-song-en-024-s03-l004",
          "tamil": "இந்த சோம்பேறி நடைபிணத்துக்குயிர் கொடுக்கும் மருந்து",
          "english": "A medicine that gives life to this lazy walking corpse,"
        },
        {
          "id": "kalaignar-song-en-024-s03-l005",
          "tamil": "(பொதுநலம்)",
          "english": "(Public welfare)"
        }
      ]
    },
    {
      "ordinal": 4,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-024-s04-l001",
          "tamil": "நெற்றியிலே விழுகின்ற கோடுகளை",
          "english": "The lines that fall upon the forehead,"
        },
        {
          "id": "kalaignar-song-en-024-s04-l002",
          "tamil": "முதுமைக் கோடுகளை",
          "english": "The lines of old age,"
        },
        {
          "id": "kalaignar-song-en-024-s04-l003",
          "tamil": "புத்தியிலே விளைகின்ற கேடுகளை",
          "english": "The evils that grow in the mind,"
        },
        {
          "id": "kalaignar-song-en-024-s04-l004",
          "tamil": "கச்சிதமாய் அகற்றிவிடும் கைகண்ட மருந்து - நல்ல மருந்து",
          "english": "A proven medicine that removes them precisely — a good medicine,"
        },
        {
          "id": "kalaignar-song-en-024-s04-l005",
          "tamil": "அறிவுக்கோயில் வழிபாடு",
          "english": "Worship at the temple of knowledge,"
        },
        {
          "id": "kalaignar-song-en-024-s04-l006",
          "tamil": "உழைக்கும் தோழர் பண்பாடு",
          "english": "The culture of the working comrade,"
        },
        {
          "id": "kalaignar-song-en-024-s04-l007",
          "tamil": "அறநெறியோடு அன்புடன் வாழ்வோமே வாழ்வோமே",
          "english": "Let us live, let us live, with love along the path of virtue,"
        },
        {
          "id": "kalaignar-song-en-024-s04-l008",
          "tamil": "இந்த மேலான கடமைகளுக்கொளி கொடுக்கும் மருந்து",
          "english": "A medicine that gives light to these higher duties,"
        },
        {
          "id": "kalaignar-song-en-024-s04-l009",
          "tamil": "(பொதுநலம்)",
          "english": "(Public welfare)"
        }
      ]
    }
  ]
}
