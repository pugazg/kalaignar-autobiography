{
  "workId": "kalaignar-thirai-isai-paadalgal",
  "songId": "kalaignar-song-039",
  "slug": "song-039",
  "songNumber": 39,
  "filmId": "kalaignar-song-film-013",
  "filmSlug": "film-13",
  "filmTitleTa": "தூக்கு மேடை",
  "yearPrinted": 1982,
  "titleTa": "குறிஞ்சி மலரொன்று குலுங்கி அழைக்குது",
  "titleEn": "A kurinji flower sways and calls",
  "authorship": {
    "decision": "established-kalaignar",
    "publicDisplay": true,
    "publicAuthorshipClaim": true,
    "authorshipNoticeRequired": false,
    "noticeGroupId": null
  },
  "sections": [
    {
      "ordinal": 1,
      "sourceLabelTa": "பெண்",
      "labelEn": "Woman",
      "lines": [
        {
          "id": "kalaignar-song-en-039-s01-l001",
          "tamil": "ஆ-ஆ...ஆஆ...லாலலாலா...",
          "english": "Aa-aa... aaaa... laalalaa..."
        },
        {
          "id": "kalaignar-song-en-039-s01-l002",
          "tamil": "குறிஞ்சி மலரொன்று குலுங்கி அழைக்குது",
          "english": "A kurinji flower sways and calls,"
        },
        {
          "id": "kalaignar-song-en-039-s01-l003",
          "tamil": "குலவிட வருவாய் குளிர் தென்றலே",
          "english": "Come, cool breeze, to mingle and play,"
        },
        {
          "id": "kalaignar-song-en-039-s01-l004",
          "tamil": "தென்றலின் சுகத்தில் தேனிடை கலந்து",
          "english": "In the breeze's pleasure, honey-waist mingling,"
        },
        {
          "id": "kalaignar-song-en-039-s01-l005",
          "tamil": "தளிராய் வாழ்வோம் இன்பத்தில் மிதந்து",
          "english": "Let us live as tender shoots, floating in delight."
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": "ஆண்",
      "labelEn": "Man",
      "lines": [
        {
          "id": "kalaignar-song-en-039-s02-l001",
          "tamil": "கற்கண்டு தோட்டத்தில் பால் பாய்ந்து",
          "english": "In the rock-candy garden, milk flowing,"
        },
        {
          "id": "kalaignar-song-en-039-s02-l002",
          "tamil": "கரும்பு கலப்பையாய் ஏரோட்டி",
          "english": "Driving the plough with sugarcane as the ploughshare,"
        },
        {
          "id": "kalaignar-song-en-039-s02-l003",
          "tamil": "அற்புதமாய் விளைந்த கதிர்மணியே",
          "english": "O grain-gem, wondrously grown,"
        },
        {
          "id": "kalaignar-song-en-039-s02-l004",
          "tamil": "அற்புதமாய் விளைந்த கதிர்மணியே",
          "english": "O grain-gem, wondrously grown,"
        },
        {
          "id": "kalaignar-song-en-039-s02-l005",
          "tamil": "அணைத்து மகிழ்வோம் கண்மணியே!",
          "english": "Let us embrace and rejoice, eye-gem!"
        },
        {
          "id": "kalaignar-song-en-039-s02-l006",
          "tamil": "(குறிஞ்சி)",
          "english": "(Kurinji)."
        }
      ]
    },
    {
      "ordinal": 3,
      "sourceLabelTa": "ஆண்",
      "labelEn": "Man",
      "lines": [
        {
          "id": "kalaignar-song-en-039-s03-l001",
          "tamil": "இன்ப நாவுக்கு முன்னுரை எழுதிட வருக",
          "english": "Come write a preface for the tongue of pleasure,"
        },
        {
          "id": "kalaignar-song-en-039-s03-l002",
          "tamil": "இயல் இசை கூத்தென முத்தமிழ் சுவையை தருக",
          "english": "Give the taste of Muthamizh — iyal, isai, koothu,"
        },
        {
          "id": "kalaignar-song-en-039-s03-l003",
          "tamil": "முத்தமிழ் கயல்விழி முக்கனி உன் மொழி",
          "english": "Muthamizh, fish-eyed one — your speech is the three fruits,"
        },
        {
          "id": "kalaignar-song-en-039-s03-l004",
          "tamil": "முத்திக்கு ஒரு வழி நீ",
          "english": "You are a path to mukti,"
        },
        {
          "id": "kalaignar-song-en-039-s03-l005",
          "tamil": "முத்துமாரி பொழி நீ",
          "english": "Pour a pearl-rain."
        }
      ]
    },
    {
      "ordinal": 4,
      "sourceLabelTa": "பெண்",
      "labelEn": "Woman",
      "lines": [
        {
          "id": "kalaignar-song-en-039-s04-l001",
          "tamil": "அணைத்தால் விளக்கும் இரண்டு விடும்",
          "english": "If embraced, the two lamps will go out,"
        },
        {
          "id": "kalaignar-song-en-039-s04-l002",
          "tamil": "அஞ்சும் தேகம் துவண்டு விடும்",
          "english": "The trembling body will grow faint,"
        },
        {
          "id": "kalaignar-song-en-039-s04-l003",
          "tamil": "இணைத்தால் நம்மை தமிழன்னை",
          "english": "If Tamil Mother joins us,"
        },
        {
          "id": "kalaignar-song-en-039-s04-l004",
          "tamil": "இனி பிரிவதில்லை என்றும் நானுன்னை",
          "english": "From now on, never will I part from you,"
        },
        {
          "id": "kalaignar-song-en-039-s04-l005",
          "tamil": "(குறிஞ்சி)",
          "english": "(Kurinji)."
        }
      ]
    }
  ]
}
