{
  "workId": "kalaignar-thirai-isai-paadalgal",
  "songId": "kalaignar-song-051",
  "slug": "song-051",
  "songNumber": 51,
  "filmId": "kalaignar-song-film-021",
  "filmSlug": "film-21",
  "filmTitleTa": "பாசக் கிளிகள்",
  "yearPrinted": 2006,
  "titleTa": "கருத்த மச்சான் ஒனக்குத்தான்",
  "titleEn": "Dark machaan, this is for you",
  "authorship": {
    "decision": "established-kalaignar",
    "publicDisplay": true,
    "publicAuthorshipClaim": true,
    "authorshipNoticeRequired": false,
    "noticeGroupId": null
  },
  "sections": [
    {
      "ordinal": 1,
      "sourceLabelTa": "பெண்",
      "labelEn": "Woman",
      "lines": [
        {
          "id": "kalaignar-song-en-051-s01-l001",
          "tamil": "கருத்த மச்சான் ஒனக்குத்தான் ஆ...",
          "english": "Dark machaan, this is for you — aa..."
        },
        {
          "id": "kalaignar-song-en-051-s01-l002",
          "tamil": "வறுத்த மீன வச்சிருக்கேன் ம்ம்... ம்...",
          "english": "I've kept fried fish ready — mm... mm..."
        },
        {
          "id": "kalaignar-song-en-051-s01-l003",
          "tamil": "வாய்த்திறந்து வாங்கிக்க - நான்",
          "english": "Open your mouth and take it — I"
        },
        {
          "id": "kalaignar-song-en-051-s01-l004",
          "tamil": "பாய விரிச்ச படுத்துப்பேன் ம்... ம்...",
          "english": "Will spread the mat and lie down — mm... mm..."
        },
        {
          "id": "kalaignar-song-en-051-s01-l005",
          "tamil": "நீ பாஞ்சு வந்து கட்டிக்கோ",
          "english": "You leap over and hold me,"
        },
        {
          "id": "kalaignar-song-en-051-s01-l006",
          "tamil": "ஒஞ்சு போயி நிக்காத ஓடிவந்து சாஞ்சுக்கோ",
          "english": "Don't shrink away and stand there; run over and lean into me,"
        },
        {
          "id": "kalaignar-song-en-051-s01-l007",
          "tamil": "(ஏ கருத்த மச்சான்)",
          "english": "(Hey, dark machaan)."
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": "ஆண்",
      "labelEn": "Man",
      "lines": [
        {
          "id": "kalaignar-song-en-051-s02-l001",
          "tamil": "ஏ பச்சரிசி சிரிப்பே",
          "english": "Hey, raw-rice smile,"
        },
        {
          "id": "kalaignar-song-en-051-s02-l002",
          "tamil": "என்ன பத்திக்கொண்ட நெருப்பே",
          "english": "O fire that has caught hold of me,"
        },
        {
          "id": "kalaignar-song-en-051-s02-l003",
          "tamil": "நான் ஆண்டி என்ன தூண்டிப்போட்டு இழுக்காதே",
          "english": "I am an aandi — don't prod me and pull me."
        }
      ]
    },
    {
      "ordinal": 3,
      "sourceLabelTa": "பெண்",
      "labelEn": "Woman",
      "lines": [
        {
          "id": "kalaignar-song-en-051-s03-l001",
          "tamil": "ஏ... ஆண்டிக்குத்தான் தேவ ஆறுகால பூஜ",
          "english": "Hey... it is the aandi who needs six-time puja,"
        },
        {
          "id": "kalaignar-song-en-051-s03-l002",
          "tamil": "நானுமுத்த போற மெழுக பாக்காதே",
          "english": "Don't look at this `naanumuttha pora mezhugu`."
        }
      ]
    },
    {
      "ordinal": 4,
      "sourceLabelTa": "ஆண்",
      "labelEn": "Man",
      "lines": [
        {
          "id": "kalaignar-song-en-051-s04-l001",
          "tamil": "அடங்காத பொம்பளையே அழகான பூதகியே",
          "english": "Unruly woman, beautiful demoness."
        }
      ]
    },
    {
      "ordinal": 5,
      "sourceLabelTa": "பெண்",
      "labelEn": "Woman",
      "lines": [
        {
          "id": "kalaignar-song-en-051-s05-l001",
          "tamil": "ஏ... அடுப்பதும் பொண்ணுன்னு",
          "english": "Hey... saying `adupathum ponnu`,"
        },
        {
          "id": "kalaignar-song-en-051-s05-l002",
          "tamil": "அலட்சியமா கேலிபண்ணும்",
          "english": "Mocking carelessly,"
        },
        {
          "id": "kalaignar-song-en-051-s05-l003",
          "tamil": "ஆம்பளைங்க திருந்தவேணும்",
          "english": "Men must reform,"
        },
        {
          "id": "kalaignar-song-en-051-s05-l004",
          "tamil": "அடிமைத்தனம் போகவேணும்",
          "english": "Slavery must go,"
        },
        {
          "id": "kalaignar-song-en-051-s05-l005",
          "tamil": "தாலியத்தான் கட்டிப்புட்டு",
          "english": "After tying the thaali,"
        },
        {
          "id": "kalaignar-song-en-051-s05-l006",
          "tamil": "தவசிவேஷம் போட்டுக்கிட்ட",
          "english": "You put on an ascetic disguise,"
        },
        {
          "id": "kalaignar-song-en-051-s05-l007",
          "tamil": "(கருத்த)",
          "english": "(Dark one)."
        }
      ]
    },
    {
      "ordinal": 6,
      "sourceLabelTa": "ஆண்",
      "labelEn": "Man",
      "lines": [
        {
          "id": "kalaignar-song-en-051-s06-l001",
          "tamil": "ஏ... வறுத்த மீன தின்னா",
          "english": "Hey... if I eat fried fish,"
        },
        {
          "id": "kalaignar-song-en-051-s06-l002",
          "tamil": "சாமிகுத்தம் வந்து சேரும்",
          "english": "Saami-kutham will come upon me,"
        },
        {
          "id": "kalaignar-song-en-051-s06-l003",
          "tamil": "நான் சைவம் பெண்ணே",
          "english": "I am saivam, woman,"
        },
        {
          "id": "kalaignar-song-en-051-s06-l004",
          "tamil": "அசைவம் போட்டு கெடுக்காதே",
          "english": "Don't ruin me by putting asaivam before me."
        }
      ]
    },
    {
      "ordinal": 7,
      "sourceLabelTa": "பெண்",
      "labelEn": "Woman",
      "lines": [
        {
          "id": "kalaignar-song-en-051-s07-l001",
          "tamil": "ஆணு பொண்ணு உறவே",
          "english": "The bond of man and woman —"
        },
        {
          "id": "kalaignar-song-en-051-s07-l002",
          "tamil": "அசைவம்தானே மாமா",
          "english": "Isn't that itself asaivam, mama?"
        },
        {
          "id": "kalaignar-song-en-051-s07-l003",
          "tamil": "அருகில் வரும் மீன வெறுக்காதே",
          "english": "Don't reject the fish that comes near you."
        }
      ]
    },
    {
      "ordinal": 8,
      "sourceLabelTa": "ஆண்",
      "labelEn": "Man",
      "lines": [
        {
          "id": "kalaignar-song-en-051-s08-l001",
          "tamil": "அடங்காத பொம்பளையே",
          "english": "Unruly woman,"
        },
        {
          "id": "kalaignar-song-en-051-s08-l002",
          "tamil": "அழகான பூதகியே",
          "english": "Beautiful demoness."
        }
      ]
    },
    {
      "ordinal": 9,
      "sourceLabelTa": "பெண்",
      "labelEn": "Woman",
      "lines": [
        {
          "id": "kalaignar-song-en-051-s09-l001",
          "tamil": "எட்டுக்கால் லட்சணமே",
          "english": "O eight-legged beauty-mark,"
        },
        {
          "id": "kalaignar-song-en-051-s09-l002",
          "tamil": "எமனேறும் வாகனமே",
          "english": "O vehicle that Yama rides,"
        },
        {
          "id": "kalaignar-song-en-051-s09-l003",
          "tamil": "என்றுதான் நானும் மச்சான்",
          "english": "That is how I too, machaan,"
        },
        {
          "id": "kalaignar-song-en-051-s09-l004",
          "tamil": "ஏளனமே செய்வோனய்யா",
          "english": "Only mock you, ayya,"
        },
        {
          "id": "kalaignar-song-en-051-s09-l005",
          "tamil": "எந்நிலமை புரியலையா",
          "english": "Don't you understand my condition?"
        },
        {
          "id": "kalaignar-song-en-051-s09-l006",
          "tamil": "உன்மனசும் எங்களையா",
          "english": "Isn't your heart ours, ayya?"
        },
        {
          "id": "kalaignar-song-en-051-s09-l007",
          "tamil": "(கருத்த)",
          "english": "(Dark one)."
        }
      ]
    }
  ]
}
