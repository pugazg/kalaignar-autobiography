      "lines": [
        {
          "id": "kalaignar-song-en-038-s01-l001",
          "tamil": "ஆயிரம் பிறைகள் காணும் வரை",
          "english": "Until a thousand crescents are seen,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l002",
          "tamil": "அலைகடல் ஓசை அடங்கும் வரை",
          "english": "Until the roar of the wave-sea falls still,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l003",
          "tamil": "தமிழே உனக்காக நீ தனியே எனக்காக",
          "english": "O Tamil, for you — you alone, for me,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l004",
          "tamil": "காத்திருப்பேன் நான் காத்திருப்பேன்.....",
          "english": "I shall wait, I shall wait....."
        },
        {
          "id": "kalaignar-song-en-038-s01-l005",
          "tamil": "கதிரவன் ஊர்வலம் நிற்கும் வரை",
          "english": "Until the sun's procession stops,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l006",
          "tamil": "கனி வளம் உலகில் வற்றும் வரை",
          "english": "Until fruit-bounty dries up in the world,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l007",
          "tamil": "பொதிகைத் தென்றல் தூங்கும் வரை",
          "english": "Until the Podhigai breeze sleeps,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l008",
          "tamil": "பொன்னி நதியான் செழிக்கும் வரை",
          "english": "Until Ponni `nadiyaan` flourishes,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l009",
          "tamil": "தமிழே உனக்காக - நீ",
          "english": "O Tamil, for you — you,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l010",
          "tamil": "தனியே எனக்காக..",
          "english": "Alone, for me.."
        },
        {
          "id": "kalaignar-song-en-038-s01-l011",
          "tamil": "(ஆயிரம்)",
          "english": "(A thousand)"
        },
        {
          "id": "kalaignar-song-en-038-s01-l012",
          "tamil": "இயற்கை வளங்கள் நிலைக்கும் வரை",
          "english": "Until nature's riches endure,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l013",
          "tamil": "இலக்கிய செல்வம் வாழும் வரை",
          "english": "Until the wealth of literature lives,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l014",
          "tamil": "இளமை அழகு தீரும் வரை",
          "english": "Until the beauty of youth is spent,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l015",
          "tamil": "முதுமை உடலில் பாயும் வரை",
          "english": "Until old age surges into the body,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l016",
          "tamil": "தமிழே உனக்காக - நீ",
          "english": "O Tamil, for you — you,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l017",
          "tamil": "தனியே எனக்காக",
          "english": "Alone, for me,"
        },
        {
          "id": "kalaignar-song-en-038-s01-l018",
          "tamil": "(ஆயிரம்)",
          "english": "(A thousand)."
        }
      ]
    }
  ]
}
