      "lines": [
        {
          "id": "kalaignar-song-en-025-s01-l001",
          "tamil": "ஆயர்பாடி கண்ணா நீ",
          "english": "Ayarpadi Kanna, you,"
        },
        {
          "id": "kalaignar-song-en-025-s01-l002",
          "tamil": "ஆடவாராய் என்னோடு - மாயக்காரா வா வா வா - ஜாலக்காரா",
          "english": "Come dance with me — Mayakkara, come, come, come — Jaalakkara,"
        },
        {
          "id": "kalaignar-song-en-025-s01-l003",
          "tamil": "ஓஹோஹோ - ஏ பகவானே - பகவானே பகவானே",
          "english": "Ohoho — hey Bhagavane — Bhagavane, Bhagavane,"
        },
        {
          "id": "kalaignar-song-en-025-s01-l004",
          "tamil": "பாமாவைப் போலவே அழகான ராணி நான்",
          "english": "I am a queen beautiful like Bhama,"
        },
        {
          "id": "kalaignar-song-en-025-s01-l005",
          "tamil": "தாளாத காதலே தணலாக வீசுதே",
          "english": "Love I cannot bear blows like burning embers,"
        },
        {
          "id": "kalaignar-song-en-025-s01-l006",
          "tamil": "காணக்கிடைக்கா தங்கம் பார்",
          "english": "Look at this gold that cannot be found,"
        },
        {
          "id": "kalaignar-song-en-025-s01-l007",
          "tamil": "காதல் தெளிக்கும் அங்கம் பார்",
          "english": "Look at this body that sprinkles love,"
        },
        {
          "id": "kalaignar-song-en-025-s01-l008",
          "tamil": "மாயக்காரா-ஜாலக்காரா-ஏ பகவானே பகவானே-(பகவானே)",
          "english": "Mayakkara — Jaalakkara — hey Bhagavane, Bhagavane — (Bhagavane),"
        },
        {
          "id": "kalaignar-song-en-025-s01-l009",
          "tamil": "வானோடும் மின்னலே இடையாக ஆனதே",
          "english": "The lightning that races with the sky has become my waist,"
        },
        {
          "id": "kalaignar-song-en-025-s01-l010",
          "tamil": "தேனுறும் கன்னமே தெய்வீக பானமே",
          "english": "My honey-seeping cheek is a divine drink,"
        },
        {
          "id": "kalaignar-song-en-025-s01-l011",
          "tamil": "வேலைப் பழிக்கும் விழியைப் பார்",
          "english": "Look at these eyes that put the spear to shame,"
        },
        {
          "id": "kalaignar-song-en-025-s01-l012",
          "tamil": "ஆளை மயக்கும் மொழியைப் பார்",
          "english": "Look at this speech that enchants a person,"
        },
        {
          "id": "kalaignar-song-en-025-s01-l013",
          "tamil": "மாயக்காரா-ஜாலக்காரா-ஏ பகவானே பகவானே-(பகவானே)",
          "english": "Mayakkara — Jaalakkara — hey Bhagavane, Bhagavane — (Bhagavane)."
        }
      ]
    }
  ]
}
