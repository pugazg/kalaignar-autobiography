{
  "workId": "kalaignar-thirai-isai-paadalgal",
  "songId": "kalaignar-song-019",
  "slug": "song-019",
  "songNumber": 19,
  "filmId": "kalaignar-song-film-005",
  "filmSlug": "film-05",
  "filmTitleTa": "ராஜா ராணி",
  "yearPrinted": 1956,
  "titleTa": "வாங்க... வாங்க... வாங்க...",
  "titleEn": "Come... come... come...",
  "contentsTitleTa": "வாங்க வாங்க எல்லோரும்",
  "authorship": {
    "decision": "established-kalaignar",
    "publicDisplay": true,
    "publicAuthorshipClaim": true,
