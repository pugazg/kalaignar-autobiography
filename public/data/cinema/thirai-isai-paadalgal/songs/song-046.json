  "titleTa": "நீதிமன்றத் துலாக்கோலே சாயலாமா",
  "titleEn": "Can the court's balance-scale lean?",
  "authorship": {
    "decision": "established-kalaignar",
    "publicDisplay": true,
    "publicAuthorshipClaim": true,
    "authorshipNoticeRequired": false,
    "noticeGroupId": null
  },
  "sections": [
    {
      "ordinal": 1,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-046-s01-l001",
          "tamil": "நீதிமன்றத் துலாக்கோலே சாயலாமா",
          "english": "Can the court's balance-scale lean?"
        },
        {
          "id": "kalaignar-song-en-046-s01-l002",
          "tamil": "நிரபராதி நியாயமின்றிச் சாகலாமா சாகலாமா",
          "english": "Can an innocent person die without justice — die, die?"
        },
        {
          "id": "kalaignar-song-en-046-s01-l003",
          "tamil": "பாவமோரிடம் பழியோரிடம் என்பது இதுதானா",
          "english": "Is this what it means — sin with one, blame with another?"
        },
        {
          "id": "kalaignar-song-en-046-s01-l004",
          "tamil": "ஆதவன் ஒளியை அமாவாசை என்பதும் சரிதானா",
          "english": "Is it right to call the sun's light an amavasai?"
        },
        {
          "id": "kalaignar-song-en-046-s01-l005",
          "tamil": "இது நல்லோர் வாழ்ந்திடும் திருநாடா",
          "english": "Is this a sacred land where good people live?"
        },
        {
          "id": "kalaignar-song-en-046-s01-l006",
          "tamil": "இல்லை பொல்லா விலங்குகள் இருள் காடா",
          "english": "Or a dark forest of wicked beasts?"
        },
        {
          "id": "kalaignar-song-en-046-s01-l007",
          "tamil": "அராஜகம் என்பதற்கோ அளவே இல்லையா",
          "english": "Is there no limit at all to what is called lawlessness?"
        },
        {
          "id": "kalaignar-song-en-046-s01-l008",
          "tamil": "ஆண்டவா நீ இருந்தால் பதில் சொல்லைய்யா",
          "english": "Lord, if you exist, answer, ayya,"
        },
        {
          "id": "kalaignar-song-en-046-s01-l009",
          "tamil": "(பாவ)",
          "english": "(Sin)."
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-046-s02-l001",
          "tamil": "வேங்கையின் பிடியில் வெள்ளாடு",
          "english": "A white goat in the grip of the vengai —"
        },
        {
          "id": "kalaignar-song-en-046-s02-l002",
          "tamil": "சிக்கிய வேதனை பாரய்யா",
          "english": "Look, ayya, at the pain of being caught,"
        },
        {
          "id": "kalaignar-song-en-046-s02-l003",
          "tamil": "வேலியே பயிரை மேய்ந்திடும்",
          "english": "The fence itself grazes the crop —"
        },
        {
          "id": "kalaignar-song-en-046-s02-l004",
          "tamil": "கொடிய சாதனை கேளய்யா",
          "english": "Hear, ayya, of this cruel achievement,"
        },
        {
          "id": "kalaignar-song-en-046-s02-l005",
          "tamil": "அநியாயமாக ஒரு தமிழ் மகன் சாவது நன்றோ",
          "english": "Is it good that a Tamil son should die unjustly?"
        },
        {
          "id": "kalaignar-song-en-046-s02-l006",
          "tamil": "அன்னைத் தமிழகமே அமைதியைக் காண்பது என்றோ",
          "english": "O Mother Tamilagam, when will you see peace?"
        },
        {
          "id": "kalaignar-song-en-046-s02-l007",
          "tamil": "துரோகிகள் கூட்டம் பிடிபடவே",
          "english": "Let the band of traitors be caught,"
        },
        {
          "id": "kalaignar-song-en-046-s02-l008",
          "tamil": "தூயவர் துயரம் பொடிபடவே",
          "english": "Let the sorrow of the pure one be ground to powder,"
        },
        {
          "id": "kalaignar-song-en-046-s02-l009",
          "tamil": "தூக்கிடு கொடியை உன் தோளுக்கு மேலே",
          "english": "Raise the flag above your shoulder,"
        },
        {
          "id": "kalaignar-song-en-046-s02-l010",
          "tamil": "தோழா இனிதான் நம் அறப்போர் வாழுக்குவேலை",
          "english": "Comrade, only now comes our righteous struggle's `vaazhukku-velai`,"
        },
        {
          "id": "kalaignar-song-en-046-s02-l011",
          "tamil": "நம் அறப்போர் வாழுக்கு வேலை.",
          "english": "Our righteous struggle — `vaazhukku velai`."
        }
      ]
    }
  ]
}
