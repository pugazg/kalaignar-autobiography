  "filmTitleTa": "கண்ணம்மா",
  "yearPrinted": 2005,
  "titleTa": "இளைஞனே இளைஞனே நீ விழித்தெழு",
  "titleEn": "Young man, young man, wake and rise",
  "authorship": {
    "decision": "established-kalaignar",
    "publicDisplay": true,
    "publicAuthorshipClaim": true,
    "authorshipNoticeRequired": false,
    "noticeGroupId": null
  },
  "sections": [
    {
      "ordinal": 1,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-048-s01-l001",
          "tamil": "இளைஞனே இளைஞனே நீ விழித்தெழு",
          "english": "Young man, young man, wake and rise,"
        },
        {
          "id": "kalaignar-song-en-048-s01-l002",
          "tamil": "கலைஞன் நான் அழைக்கின்றேன் விழித்தெழு",
          "english": "I, the kalaignan, call you — wake and rise,"
        },
        {
          "id": "kalaignar-song-en-048-s01-l003",
          "tamil": "காற்றைப் போல விரைந்து வா",
          "english": "Come swiftly like the wind,"
        },
        {
          "id": "kalaignar-song-en-048-s01-l004",
          "tamil": "ஆற்றைப் போல பெருகி வா",
          "english": "Come swelling like the river,"
        },
        {
          "id": "kalaignar-song-en-048-s01-l005",
          "tamil": "உலகத்தைப் படித்து நீ உயர்ந்திடவே",
          "english": "So that, studying the world, you may rise,"
        },
        {
          "id": "kalaignar-song-en-048-s01-l006",
          "tamil": "உன்னை நீயே உணர்ந்திடவே",
          "english": "So that you may know yourself,"
        },
        {
          "id": "kalaignar-song-en-048-s01-l007",
          "tamil": "உழைப்பவர்க்கு துணை புரிந்திடவே",
          "english": "So that you may stand beside the working people,"
        },
        {
          "id": "kalaignar-song-en-048-s01-l008",
          "tamil": "உடன்பிறப்பே என் உடன்பிறப்பே",
          "english": "Udanpirappe, my udanpirappe,"
        },
        {
          "id": "kalaignar-song-en-048-s01-l009",
          "tamil": "(இளைஞனே)",
          "english": "(Young man)."
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-048-s02-l001",
          "tamil": "யுவனும் யுவதியும் ஆர்த்தெழுந்தால்",
          "english": "If young man and young woman rise roaring,"
        },
        {
          "id": "kalaignar-song-en-048-s02-l002",
          "tamil": "யுகத்தையே மாற்றலாம்",
          "english": "An age itself can be changed,"
        },
        {
          "id": "kalaignar-song-en-048-s02-l003",
          "tamil": "ஜாதி மத பேத சரித்திரத்தை",
          "english": "The history of caste and religious division,"
        },
        {
          "id": "kalaignar-song-en-048-s02-l004",
          "tamil": "சம்மட்டியால் அடித்து நொறுக்கலாம்",
          "english": "Can be struck and smashed with a sledgehammer,"
        },
        {
          "id": "kalaignar-song-en-048-s02-l005",
          "tamil": "ஆதிமகனாம் வள்ளுவர் குறளை",
          "english": "The Kural of Valluvar, the primordial son,"
        },
        {
          "id": "kalaignar-song-en-048-s02-l006",
          "tamil": "ஓதி உணர்ந்து ஒலித்திடக் கேட்கலாம்",
          "english": "May be read, understood, and heard resounding,"
        },
        {
          "id": "kalaignar-song-en-048-s02-l007",
          "tamil": "(இளைஞனே)",
          "english": "(Young man)."
        }
      ]
    },
    {
      "ordinal": 3,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-048-s03-l001",
          "tamil": "லட்சிய வேட்கை இடியாய் முழங்கிடவே",
          "english": "Let the hunger for the ideal thunder like lightning,"
        },
        {
          "id": "kalaignar-song-en-048-s03-l002",
          "tamil": "இடியோசை கேட்ட நாகமாய்",
          "english": "Like a cobra that has heard the thunderclap,"
        },
        {
          "id": "kalaignar-song-en-048-s03-l003",
          "tamil": "இன்பபகை மாய்ந்திடவே",
          "english": "Let `inba-pagai` vanish,"
        },
        {
          "id": "kalaignar-song-en-048-s03-l004",
          "tamil": "அலட்சியம் வேண்டாம் அன்பு இளைஞனே",
          "english": "No indifference, beloved young man,"
        },
        {
          "id": "kalaignar-song-en-048-s03-l005",
          "tamil": "ஆன்றோர்க்கு தலைவணங்கி",
          "english": "Bowing your head to the wise elders,"
        },
        {
          "id": "kalaignar-song-en-048-s03-l006",
          "tamil": "அறிஞர் வழியில் நடந்திடவே",
          "english": "Walk in the path of the learned,"
        },
        {
          "id": "kalaignar-song-en-048-s03-l007",
          "tamil": "(இளைஞனே)",
          "english": "(Young man)."
        }
      ]
    }
  ]
}
