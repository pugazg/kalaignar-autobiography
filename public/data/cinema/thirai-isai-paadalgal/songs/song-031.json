  "filmTitleTa": "காஞ்சித் தலைவன்",
  "yearPrinted": 1963,
  "titleTa": "வெல்க நாடு வெல்க நாடு வெல்க வெல்கவே",
  "titleEn": "May the land triumph, may the land triumph — triumph, triumph!",
  "authorship": {
    "decision": "established-kalaignar",
    "publicDisplay": true,
    "publicAuthorshipClaim": true,
    "authorshipNoticeRequired": false,
    "noticeGroupId": null
  },
  "sections": [
    {
      "ordinal": 1,
      "sourceLabelTa": null,
      "labelEn": null,
      "lines": [
        {
          "id": "kalaignar-song-en-031-s01-l001",
          "tamil": "வெல்க நாடு வெல்க நாடு வெல்க வெல்கவே",
          "english": "May the land triumph, may the land triumph — triumph, triumph!"
        },
        {
          "id": "kalaignar-song-en-031-s01-l002",
          "tamil": "வீர சங்க நாதம் கேட்டு செல்க செல்கவே",
          "english": "Hear the warrior-conch blast and go, go!"
        },
        {
          "id": "kalaignar-song-en-031-s01-l003",
          "tamil": "படைகள் செல்கவே - படைகள் செல்கவே...",
          "english": "Let the armies go — let the armies go..."
        },
        {
          "id": "kalaignar-song-en-031-s01-l004",
          "tamil": "(வெல்க நாடு)",
          "english": "(May the land triumph)"
        },
        {
          "id": "kalaignar-song-en-031-s01-l005",
          "tamil": "தாயின் ஆணை கேட்பதற்கு தலை வணங்கும் தங்கமே",
          "english": "Golden one who bows the head to heed the mother's command,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l006",
          "tamil": "தலைகொடுத்து தாயின் மானம் காத்திடுவாய் சிங்கமே",
          "english": "Give your head and guard the mother's honour, O lion,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l007",
          "tamil": "சென்று வா - வென்று வா...",
          "english": "Go and return — win and return..."
        },
        {
          "id": "kalaignar-song-en-031-s01-l008",
          "tamil": "(வெல்க நாடு)",
          "english": "(May the land triumph)"
        },
        {
          "id": "kalaignar-song-en-031-s01-l009",
          "tamil": "குமலைப் போல மழலை பேசும்",
          "english": "Speaking baby-talk like kumalai,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l010",
          "tamil": "குழந்தைகளின் முத்தமும்",
          "english": "the kisses of the children,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l011",
          "tamil": "கொஞ்சுகின்ற அஞ்சுகத்தின்",
          "english": "and the lovely-voiced sound"
        },
        {
          "id": "kalaignar-song-en-031-s01-l012",
          "tamil": "கோலமொழிச் சத்தமும்",
          "english": "of coaxing Anjugam,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l013",
          "tamil": "உன் குன்று தோளில் புது பலத்தை வழங்குமடா நித்தமும் சென்று வா -",
          "english": "will give new strength every day to your hill-like shoulder, da — go and return —"
        },
        {
          "id": "kalaignar-song-en-031-s01-l014",
          "tamil": "வென்று வா...",
          "english": "win and return..."
        },
        {
          "id": "kalaignar-song-en-031-s01-l015",
          "tamil": "(வெல்க நாடு)",
          "english": "(May the land triumph)"
        },
        {
          "id": "kalaignar-song-en-031-s01-l016",
          "tamil": "மகிமை கொண்ட மண்ணின் மீது எதிரிகளின் கால்கள்",
          "english": "Upon the glorious soil — the feet of enemies,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l017",
          "tamil": "எதிரிகளின் கால்கள்",
          "english": "the feet of enemies,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l018",
          "tamil": "மலர் பறிப்பதில்லையடா வீரர்களின் கைகள்",
          "english": "Warriors' hands do not pluck flowers, da,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l019",
          "tamil": "மாவீரர்களின் கைகள்",
          "english": "the hands of great warriors,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l020",
          "tamil": "சென்று வா - வென்று வா...",
          "english": "Go and return — win and return..."
        },
        {
          "id": "kalaignar-song-en-031-s01-l021",
          "tamil": "(வெல்க நாடு)",
          "english": "(May the land triumph)"
        },
        {
          "id": "kalaignar-song-en-031-s01-l022",
          "tamil": "ஓங்கிய வாள் போன்ற வடிவமடா - அவர்",
          "english": "His form is like an upraised sword, da — his,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l023",
          "tamil": "ஒளி விழிகள் உலகத்தின் படிவமடா",
          "english": "radiant eyes are the mould of the world, da,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l024",
          "tamil": "வேங்கைப் புலி மன்னனடா",
          "english": "He is the vengai-tiger king, da,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l025",
          "tamil": "வீரர்களின் தலைவனடா - அவர்",
          "english": "the leader of warriors, da — await his,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l026",
          "tamil": "கட்டளைக்குக் காத்திருந்து நல்லவனே",
          "english": "command, good one,"
        },
        {
          "id": "kalaignar-song-en-031-s01-l027",
          "tamil": "களம் நோக்கிப் புறப்படடா வல்லவனே..",
          "english": "Set out toward the battlefield, mighty one.."
        },
        {
          "id": "kalaignar-song-en-031-s01-l028",
          "tamil": "(வெல்க நாடு)",
          "english": "(May the land triumph)"
        }
      ]
    }
  ]
}
