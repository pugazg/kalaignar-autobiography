      "lines": [
        {
          "id": "kalaignar-song-en-032-s01-l001",
          "tamil": "ஒருவனுக்கு ஒருத்தி என்ற",
          "english": "Holding within it the life-breath,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l002",
          "tamil": "உயிர்மூச்சை உள்ளடக்கி",
          "english": "‘one woman for one man,’"
        },
        {
          "id": "kalaignar-song-en-032-s01-l003",
          "tamil": "அறன் எனப் பட்டதே இல்வாழ்க்கை அஃதும்",
          "english": "‘Domestic life is what is called virtue; even that,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l004",
          "tamil": "பிறன் பழிப்பதில்லாயின் நன்று - எனும்",
          "english": "is good if it brings no blame from another’ — says the,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l005",
          "tamil": "திருக்குறளை மறவாதே",
          "english": "Thirukkural; do not forget it,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l006",
          "tamil": "திசை தவறிப்போகாதே",
          "english": "do not stray from your direction,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l007",
          "tamil": "வாழ்க்கை எனும் ஓடம்",
          "english": "The boat called life,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l008",
          "tamil": "வழங்குகின்ற பாடம்",
          "english": "the lesson it gives,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l009",
          "tamil": "மானிடரின் மனதினிலே",
          "english": "within the human heart,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l010",
          "tamil": "மறக்க வொண்ணா வேதம்",
          "english": "is a Veda impossible to forget,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l011",
          "tamil": "(வாழ்க்கை)",
          "english": "(Life)"
        },
        {
          "id": "kalaignar-song-en-032-s01-l012",
          "tamil": "வாலிபம் என்பது கலைகின்ற வேடம் - அதில்",
          "english": "Youth is a costume that fades — in it,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l013",
          "tamil": "வந்தது வரட்டும் என்பவன் முழு மூடம்",
          "english": "the one who says ‘let whatever comes, come’ is a complete fool,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l014",
          "tamil": "வருமுன் காப்பவன் தான் அறிவாளி - புயல்",
          "english": "the one who guards before it comes is the wise one — before the storm,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l015",
          "tamil": "வருமுன் காப்பவன் தான் அறிவாளி",
          "english": "the one who guards before it comes is the wise one,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l016",
          "tamil": "வந்தபின்னே தவிப்பவன்தான் ஏமாளி",
          "english": "the one who suffers after it comes is the dupe,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l017",
          "tamil": "(வாழ்க்கை)",
          "english": "(Life)"
        },
        {
          "id": "kalaignar-song-en-032-s01-l018",
          "tamil": "துடுப்புகள் இல்லாப் படகு - அலைகள்",
          "english": "A boat without oars — the waves,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l019",
          "tamil": "அழைக்கின்ற திசையெல்லாம் போகும் - தீமையைத்",
          "english": "will take it in every direction they call — a life with no one,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l020",
          "tamil": "தடுப்பவன் இல்லாத வாழ்வும் - அந்தப்",
          "english": "to block evil — that life too,"
        },
        {
          "id": "kalaignar-song-en-032-s01-l021",
          "tamil": "படகின் நிலைபோலே ஆகும்.",
          "english": "will become like the state of that boat."
        }
      ]
    }
  ]
}
