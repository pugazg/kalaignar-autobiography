  "titleTa": "மாரி மகமாயி மாரி மகமாயி",
  "titleEn": "Mari Mahamayi, Mari Mahamayi",
  "authorship": {
    "decision": "established-kalaignar",
    "publicDisplay": true,
    "publicAuthorshipClaim": true,
    "authorshipNoticeRequired": false,
