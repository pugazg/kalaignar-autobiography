  "filmTitleTa": "மறக்க முடியுமா",
  "yearPrinted": 1966,
  "titleTa": "ஒண்ணு கொடுத்தா ஒன்பது கிடைக்கும்",
  "titleEn": "Give one, you get nine",
  "authorship": {
    "decision": "established-kalaignar",
    "publicDisplay": true,
    "publicAuthorshipClaim": true,
    "authorshipNoticeRequired": false,
    "noticeGroupId": null
  },
  "sections": [
    {
      "ordinal": 1,
      "sourceLabelTa": "ஆண்",
      "labelEn": "Man",
      "lines": [
        {
          "id": "kalaignar-song-en-035-s01-l001",
          "tamil": "ஒண்ணு கொடுத்தா ஒன்பது கிடைக்கும்",
          "english": "Give one, you get nine,"
        },
        {
          "id": "kalaignar-song-en-035-s01-l002",
          "tamil": "உனக்குத் தெரியுமா? உனக்குத் தெரியுமா?",
          "english": "Do you know? Do you know?"
        }
      ]
    },
    {
      "ordinal": 2,
      "sourceLabelTa": "பெண்",
      "labelEn": "Woman",
      "lines": [
        {
          "id": "kalaignar-song-en-035-s02-l001",
          "tamil": "ஒன்பதுக்கு வட்டி உடனே கொடுக்க",
          "english": "To give interest on the nine at once,"
        },
        {
          "id": "kalaignar-song-en-035-s02-l002",
          "tamil": "என்னால் முடியுமா? என்னால் முடியுமா?",
          "english": "Can I do it? Can I do it?"
        }
      ]
    },
    {
      "ordinal": 3,
      "sourceLabelTa": "ஆண்",
      "labelEn": "Man",
      "lines": [
        {
          "id": "kalaignar-song-en-035-s03-l001",
          "tamil": "பெண்ணுக்குச் சுவை வட்டியில் உண்டு",
          "english": "For a woman, the flavour lies in the interest,"
        },
        {
          "id": "kalaignar-song-en-035-s03-l002",
          "tamil": "அசலைப்போடம்மா அசலைப்போடம்மா",
          "english": "Put down the principal, amma, put down the principal, amma,"
        },
        {
          "id": "kalaignar-song-en-035-s03-l003",
          "tamil": "கண்ணுக்குள் ஆடும் கனியேமலரே -",
          "english": "O fruit-flower dancing within the eye —"
        },
        {
          "id": "kalaignar-song-en-035-s03-l004",
          "tamil": "கன்னம் இதுதாம்மா கன்னம் இதுதாம்மா",
          "english": "This is the cheek, amma, this is the cheek, amma."
        }
      ]
    },
    {
      "ordinal": 4,
      "sourceLabelTa": "பெண்",
      "labelEn": "Woman",
      "lines": [
        {
          "id": "kalaignar-song-en-035-s04-l001",
          "tamil": "கன்னத்தில் சித்திரம் கனியிதழ் முத்திரை",
          "english": "A picture on the cheek, the seal of fruit-lips,"
        },
        {
          "id": "kalaignar-song-en-035-s04-l002",
          "tamil": "எண்ணிக்கொள் தருகிறேன் திருமணம்",
          "english": "Count it and take it — I give it; marriage,"
        },
        {
          "id": "kalaignar-song-en-035-s04-l003",
          "tamil": "பண்ணிக்கொள் தருகிறேன்",
          "english": "Make it — I give it,"
        },
        {
          "id": "kalaignar-song-en-035-s04-l004",
          "tamil": "(இப்ப)",
          "english": "(Now)."
        }
      ]
    },
    {
      "ordinal": 5,
      "sourceLabelTa": "ஆண்",
      "labelEn": "Man",
      "lines": [
        {
          "id": "kalaignar-song-en-035-s05-l001",
          "tamil": "ஒண்ணு கொடுத்தா ஒன்பது கிடைக்கும்",
          "english": "Give one, you get nine,"
        },
        {
          "id": "kalaignar-song-en-035-s05-l002",
          "tamil": "உனக்குத் தெரியுமா? உனக்குத் தெரியுமா?",
          "english": "Do you know? Do you know?"
        }
      ]
    },
    {
      "ordinal": 6,
      "sourceLabelTa": "பெண்",
      "labelEn": "Woman",
      "lines": [
        {
          "id": "kalaignar-song-en-035-s06-l001",
          "tamil": "ஒன்பதுக்கு வட்டி உடனே கொடுக்க",
          "english": "To give interest on the nine at once,"
        },
        {
          "id": "kalaignar-song-en-035-s06-l002",
          "tamil": "என்னால் முடியுமா? என்னால் முடியுமா?",
          "english": "Can I do it? Can I do it?"
        }
      ]
    },
    {
      "ordinal": 7,
      "sourceLabelTa": "ஆண்",
      "labelEn": "Man",
      "lines": [
        {
          "id": "kalaignar-song-en-035-s07-l001",
          "tamil": "குளிப்பதில் சுகமோ? நினைவில் களிப்பதில்",
          "english": "Is pleasure in bathing? In rejoicing in memory,"
        },
        {
          "id": "kalaignar-song-en-035-s07-l002",
          "tamil": "சுகமோ? காதல் தளிர்ப்பதில் சுகமோ?",
          "english": "Is there pleasure? Is pleasure in love putting forth shoots?"
        },
        {
          "id": "kalaignar-song-en-035-s07-l003",
          "tamil": "கேட்டதை அளிப்பதில் சுகமோ",
          "english": "Is pleasure in giving what was asked?"
        }
      ]
    },
    {
      "ordinal": 8,
      "sourceLabelTa": "பெண்",
      "labelEn": "Woman",
      "lines": [
        {
          "id": "kalaignar-song-en-035-s08-l001",
          "tamil": "இருப்பது வீடு... வீணே பறப்பது ஏனோ?",
          "english": "There is a home... why fly about for nothing?"
        },
        {
          "id": "kalaignar-song-en-035-s08-l002",
          "tamil": "எனக்கும் துடிக்குது பருவம்... ஆனால்",
          "english": "My season too is throbbing... but,"
        },
        {
          "id": "kalaignar-song-en-035-s08-l003",
          "tamil": "தடுக்குது இதயம்...",
          "english": "The heart restrains it..."
        }
      ]
    }
  ]
}
