  "tamil": {
    "blocks": [
      {
        "kind": "prose",
        "text": "[மதுரையில் கல்யாணியும் கணவன் தங்கப்பனும்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "தங்",
        "text": "தங் : கல்யாணி!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "கல் : இதோ வந்துட்டேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "தங்",
        "text": "தங் : ஹூம்...புறப்படு சீக்கிரம்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "கல் : ஏன் பறக்கிறீங்க (ஆடை அணிந்து வரும் போது தந்தையைப் பார்த்து) அப்பா போய்விட்டு வர்றோம்......."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "மாணிக்",
        "text": "மாணிக் : சரியம்மா ஜாக்கிரதையா போயிட்டுவாங்க,"
      },
      {
        "kind": "prose",
        "text": "[இந்நேரம் எதிர்வீட்டு பார்வதி வருகிறாள்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பார்",
        "text": "பார் : கல்யாணி..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "கல் : வாங்க அக்கா"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பார்",
        "text": "பார் : நல்ல சமயத்திலேதான் வந்திருக்கேன்.. எங்கே பிரயாணம்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "மாணி",
        "text": "மாணி : ஒண்ணுமில்ல மாப்பிள்ளை எழுதின கதை படம் பிடிக்கப் போறாங்களாம்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "தங்",
        "text": "தங் : ஆமா! கல்யாணி ரொம்ப நாளா படம் பிடிக்கிறதை பார்க்கணும் பார்க்கணும்னு தொந்தரவு பண்ணுது."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பார்",
        "text": "பார் : போகவேண்டியது தான். முழுகாதிருக்கிற பெண்ணு இப்படி நேரம் காலம் இல்லாமல் வெளியே போனால் நல்லாவா இருக்கு."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "மாணி",
        "text": "மாணி : தப்புதான் குழந்தை ஆசைபடுதில்லே போயிட்டுத்தான் வரட்டுமே."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "கல் : இன்னைக்கு ஒரு நாளைக்குத்தானக்கா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பார்",
        "text": "பார் : ம்...போம்மா! போ! மாப்புள்ளே நீ சொன்ன படியெல்லாம் கேட்டிரு! பையன் வந்துல்ல அடக்கணும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "கல் : போங்க அக்கா"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "மாணி",
        "text": "மாணி : அதுக்குள்ளே பையனே தீர்மானம் பண்ணிட்டியா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பார்",
        "text": "பார் : நான் தீர்மானித்தாலும் தீர்மானிக்காவிட்டாலும் அவங்க ரெண்டு பேருமே தீர்மானம் பண்ணிட்டாங்களாம் பையனுக்கு பன்னீர் செல்வம்னு பெயர் வைக்கிறதா..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "தங்",
        "text": "தங் : அதுமட்டுமல்ல பெண் பிறந்தால் நாகம்மான்னு பெயர் வைக்கிறதா தீர்மானிச்சிருக்கோம்."
      },
      {
        "kind": "stage-direction",
        "text": "(புறப்படுகின்றனர்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "மணி",
        "text": "மணி : என் பொண்ணு புத்திசாலிதான். இந்த சந்தோஷத்தைப் பார்க்க மகன்களும் இருந்தால்..."
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "parasakthi-en-s006-u001",
        "kind": "stage-direction",
        "speakerLabel": null,
        "text": "[In Madurai, Kalyani and her husband Thangappan]",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u002",
        "kind": "dialogue",
        "speakerLabel": "தங்",
        "text": "Kalyani!",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u003",
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "Coming!",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u004",
        "kind": "dialogue",
        "speakerLabel": "தங்",
        "text": "Mm... hurry up and get going.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u005",
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "Why are you in such a rush? (As she comes out dressed, looking at her father.) Father, we're going out. We'll be back.......",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u006",
        "kind": "dialogue",
        "speakerLabel": "மாணிக்",
        "text": "All right, dear. Go carefully and come back safely.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u007",
        "kind": "stage-direction",
        "speakerLabel": null,
        "text": "[At this moment Parvathi from the house opposite arrives.]",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u008",
        "kind": "dialogue",
        "speakerLabel": "பார்",
        "text": "Kalyani...",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u009",
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "Come in, sister.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u010",
        "kind": "dialogue",
        "speakerLabel": "பார்",
        "text": "I've come at just the right time... Where are you off to?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u011",
        "kind": "dialogue",
        "speakerLabel": "மாணி",
        "text": "Nothing much. They're going to film a story written by the son-in-law, it seems.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u012",
        "kind": "dialogue",
        "speakerLabel": "தங்",
        "text": "Yes! For a long time Kalyani has been pestering me, saying she wants to watch a film being shot.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u013",
        "kind": "dialogue",
        "speakerLabel": "பார்",
        "text": "Of course she has to go. But does it look right for a woman in her condition to be going out like this at all hours?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u014",
        "kind": "dialogue",
        "speakerLabel": "மாணி",
        "text": "It is wrong, but the child is eager to go. Let her go and come back.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u015",
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "It's only for today, sister!",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u016",
        "kind": "dialogue",
        "speakerLabel": "பார்",
        "text": "Mm... go, dear, go! Son-in-law, keep listening to everything—just as you said! Once the boy comes, we'll have to rein her in.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u017",
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "Oh, go on, sister.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u018",
        "kind": "dialogue",
        "speakerLabel": "மாணி",
        "text": "Have you already decided it'll be a boy?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u019",
        "kind": "dialogue",
        "speakerLabel": "பார்",
        "text": "Whether I decide it or not, those two have apparently already decided—to name a boy Panneerselvam...",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u020",
        "kind": "dialogue",
        "speakerLabel": "தங்",
        "text": "Not only that. If it's a girl, we've decided to name her Nagamma.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u021",
        "kind": "stage-direction",
        "speakerLabel": null,
        "text": "(They leave.)",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s006-u022",
        "kind": "dialogue",
        "speakerLabel": "மணி",
        "text": "My daughter is clever indeed. If only my sons were here to see this happiness...",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      }
    ]
  },
