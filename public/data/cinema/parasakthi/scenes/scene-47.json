  "tamil": {
    "blocks": [
      {
        "kind": "dialogue",
        "speakerLabel": "சந்",
        "text": "சந் : கல்யாணி! கல்யாணி!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "கல் : அண்ணு! அண்ணு என்னைப் பாருங்கள்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "குண : அண்ணனுக்கு என்ன செய்யுது அண்ணி."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "சரஸ்",
        "text": "சரஸ் : இதோ உங்கள் தம்பி குணசேகரன், உங்கள் தங்கை கல்யாணி!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "சந்",
        "text": "சந் : இல்லை! அவன் அவள் அண்ணன் காலம் உதைத்து விட்டான், அவள் ஆற்றிலே விழுந்து விட்டாள் இல்லை அவளுக்கு அவள் அண்ணன் தூக்குத்தண்டனை விதித்துவிட்டான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "குண : அண்ணு!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "சந்",
        "text": "சந் : நான்தான் ஜட்ஜ்மெண்ட் எழுதினேன்; அண்ணனாக இருந்தால் என்ன தம்பியாக இருந்தால் என்ன? குற்றம் குற்றம்தான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "சர",
        "text": "சர : இதோ பாருங்கள் கல்யாணியின் குழந்தை."
      },
      {
        "kind": "stage-direction",
        "text": "(சேகருக்கு பைத்தியம் மாறுகிறது ஆனந்தக் கண்ணீர் வடிக்கின்றனர்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "சரஸ்",
        "text": "சரஸ் : யாரது?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "விம : நீங்க இருங்க! நான் போய்ப் பார்த்து வருகிறேன்! (ஞானசேகரிடம்) என்ன வேண்டும்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "ஞான",
        "text": "ஞான : அம்மா அய்யா இருக்காங்களா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "விம : ஏன்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "ஞான",
        "text": "ஞான : நாங்க ஒரு பிச்சைக்கார மகாநாடு நடத்த போகிறோம் அதற்கு நிதி கேட்க (விமலா சிரிக்கிறாள்) ஏம்மா சிரிக்கிறீங்க? இப்ப அப்படித்தான் இருக்கும்! இன்னும் கொஞ்ச நாள் போனால் பிச்சைக்காரனும் மந்திரி ஆகிடுவான்."
      },
      {
        "kind": "stage-direction",
        "text": "(வீட்டு வேலைக்காரன் மூலம் ஞானசேகரன் என அறிகின்றனர். சிதறிய குடும்பம் சிந்தை மகிழ்கிறது)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "விம : அப்போ நான் போயிட்டு வர்றேன்..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "குண : இத்தனை நாளாகவா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "விம : வீட்டிலே தேடுவாங்க!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "குண : அப்புறம் உன்னை எப்ப பார்க்கிறது?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "விம : இனிமேல் பார்க்கவே முடியாது!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "குண : ஏன்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "விம : அது அப்படித்தான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "குண : சரி அப்படியானால் போ... (விமலாவின் சேலை குணசேகரன் கட்டிய கயிற்றினால் நிறுத்தப்படுகிறது)"
      },
      {
        "kind": "verse",
        "text": "புதுப் பெண்ணின் மனதைத் தொட்டுப் போறவரே  \nஉங்க எண்ணத்தை சொல்லிவிட்டுப் போங்க  \nஇளம் மனசைத் தூண்டிவிட்டுப் போறவரே  \nஅந்த மார்பத்தைச் சொல்லிவிட்டுப் போங்க"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "சேகர்",
        "text": "சேகர் : என்னப்பா குணசேகரா"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "சரஸ்",
        "text": "சரஸ் : தம்பி இதுக்கு இவ்வளவு பெரிய கயிறு தேவை இல்லையே! சின்னக்கயிறு...கழுத்துக்கு பொருத்தமா இருந்தாலே போதும்! அதிலே ஒரு மஞ்சள்..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "குண : அதெல்லாம் இந்தக் காலத்துக்கு தேவையில்லை அண்ணி. ரெண்டு மாலை, ஒரு சொற்பொழிவாளர் விஷயம் முடிஞ்சது. (இந்நேரம் கல்யாணி வருகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "கல் : அதோமட்டும் போதாது. என் பையனுக்கு ஒரு பொண்ணு பெத்துக் கொடுக்கணும்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "குண : வாங்க...அம்மா! ஒரு காலணவுக்கு இட்லி தர்றீங்களா? ஏன் சிரிக்கிறீங்க? பைத்தியக்காரனு நினைச்சிட்டியா மந்திரி நமது மாநகர் தன்னிலே மாத மும்மாரி மழை பெய்கிறதா டும்! டும்! (பழையதை நினைவூட்டுகிறான்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "ஞான",
        "text": "ஞான : சரிதான்! அப்படியா நீங்களெல்லாம் இங்கேயே இருங்க. நான் வர்றேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "சேகர்",
        "text": "சேகர் : ஏன் தம்பி நீ எங்கே போறே"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "ஞான",
        "text": "ஞான : நமக்கும் உங்களுக்கும் சரிப்பட்டு வராது. நீங்க பங்களா ஆபீஸ்னு பழகிட்டீங்க. நான் பரதேசி மடம், ஆலமரத்தடி இப்படி பழகிட்டேன் அங்கேயே போகிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "கல் : அப்போ நானும் வர்றேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "குண : நானும் புறப்பட்டுட்டேன் அப்படின்னு."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "விம : எல்லோருமே பரதேசி மடத்துக்கு போறதுக்குப் பதில் பரதேசிகளெல்லாம் பங்களாவுக்கு அழைக்கிறது தான் நல்லது."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "சேகர்",
        "text": "சேகர் : ஆமாம்! அதுதான் சரியான யோசனை; ஞானசேகரா உன் கொள்கைப்படி பங்களாவாசி பரதேசியாக மாறக்கூடாது! பரதேசிகள் பூராவையும் பங்களாவாசியாக மாற்றுகிறதுதான் நல்லது."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "ஞான",
        "text": "ஞான : அப்படின்னு நான் போய் எல்லோரையும் கூட்டிட்டு வர்றேன். (பேதமின்றி பாடுகின்றனர்)"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "parasakthi-en-s047-u001",
        "kind": "dialogue",
        "speakerLabel": "சந்",
        "text": "Kalyani! Kalyani!",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u002",
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "Brother! Brother, look at me?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u003",
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "What's wrong with elder brother, sister-in-law?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u004",
        "kind": "dialogue",
        "speakerLabel": "சரஸ்",
        "text": "Here is your younger brother Gunasekaran, and your younger sister Kalyani!",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u005",
        "kind": "dialogue",
        "speakerLabel": "சந்",
        "text": "No! He... her elder brother—time kicked him away; she fell into the river. No, her elder brother sentenced her to death.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u006",
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "Brother!",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u007",
        "kind": "dialogue",
        "speakerLabel": "சந்",
        "text": "I am the one who wrote the judgment; what does it matter whether elder brother or younger brother? A crime is a crime.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u008",
        "kind": "dialogue",
        "speakerLabel": "சர",
        "text": "Here, look—Kalyani's child.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u009",
        "kind": "stage-direction",
        "speakerLabel": null,
        "text": "(Sekar's madness clears; they shed tears of joy.)",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u010",
        "kind": "dialogue",
        "speakerLabel": "சரஸ்",
        "text": "Who is it?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u011",
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "You stay here! I'll go and see. (To Gnana Sekaran.) What do you want?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u012",
        "kind": "dialogue",
        "speakerLabel": "ஞான",
        "text": "Amma, is sir here?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u013",
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "Why?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u014",
        "kind": "dialogue",
        "speakerLabel": "ஞான",
        "text": "We are going to hold a beggars' conference, and we came to ask for funds. (Vimala laughs.) Why are you laughing, amma? It may look like that now! A little while longer and even a beggar will become a minister.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u015",
        "kind": "stage-direction",
        "speakerLabel": null,
        "text": "(Through the house servant they learn that he is Gnana Sekaran. The scattered family rejoices.)",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u016",
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "Then I'll take leave...",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u017",
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "After all these days?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u018",
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "They'll be looking for me at home!",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u019",
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "Then when am I to see you?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u020",
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "From now on, you won't be able to see me at all!",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u021",
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "Why?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u022",
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "That's just how it is.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u023",
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "All right, then go... (Vimala's sari is stopped by the rope Gunasekaran tied.)",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u024",
        "kind": "song",
        "speakerLabel": null,
        "text": "You who touch the new bride's heart and go—\ntell me your thought before you go.\nYou who stir this young heart and go—\ntell me of that breast before you go.",
        "lines": [
          "You who touch the new bride's heart and go—",
          "tell me your thought before you go.",
          "You who stir this young heart and go—",
          "tell me of that breast before you go."
        ],
        "mode": "semantic-poetic",
        "sourceOccurrenceId": "parasakthi-song-013"
      },
      {
        "id": "parasakthi-en-s047-u025",
        "kind": "dialogue",
        "speakerLabel": "சேகர்",
        "text": "What is it, Gunasekaran?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u026",
        "kind": "dialogue",
        "speakerLabel": "சரஸ்",
        "text": "Younger brother, you don't need such a big rope for this! A small cord... just enough to fit the neck is enough! On it, a little turmeric...",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u027",
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "All that isn't needed in these times, sister-in-law. Two garlands, one orator—the matter is finished. (At this moment Kalyani arrives.)",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u028",
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "That alone isn't enough. You have to give birth to a girl for my boy!",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u029",
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "Come... Amma! Will you give idlis for a quarter anna? Why are you laughing? Did you think I was mad? Minister, in our great city does rain fall thrice a month—dum! dum! (He reminds them of the past.)",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u030",
        "kind": "dialogue",
        "speakerLabel": "ஞான",
        "text": "That's right! Is that so? You all stay here. I'll come back.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u031",
        "kind": "dialogue",
        "speakerLabel": "சேகர்",
        "text": "Why, younger brother, where are you going?",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u032",
        "kind": "dialogue",
        "speakerLabel": "ஞான",
        "text": "You and I won't fit together. You've become used to bungalow and office. I've become used to the `paradesi mutt`, the shade of the banyan tree, things like that. I'll go there.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u033",
        "kind": "dialogue",
        "speakerLabel": "கல்",
        "text": "Then I'll come too.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u034",
        "kind": "dialogue",
        "speakerLabel": "குண",
        "text": "Then I'm setting off too.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u035",
        "kind": "dialogue",
        "speakerLabel": "விம",
        "text": "Instead of everyone going to the `paradesi mutt`, it is better to invite all the `paradesis` to the bungalow.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u036",
        "kind": "dialogue",
        "speakerLabel": "சேகர்",
        "text": "Yes! That is the right idea. Gnana Sekaran, according to your principle, a bungalow-dweller should not become a `paradesi`; it is better to turn all the `paradesis` into bungalow-dwellers.",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      },
      {
        "id": "parasakthi-en-s047-u037",
        "kind": "dialogue",
        "speakerLabel": "ஞான",
        "text": "Then I'll go and bring everyone. (They sing without distinction.)",
        "lines": null,
        "mode": "prose-faithful",
        "sourceOccurrenceId": null
      }
    ]
  },
