  "songs": [
    {
      "id": "parasakthi-song-001",
      "canonicalScene": 1,
      "kind": "unlabelled-song",
      "openingLineTa": "வாழ்க வாழ்கவே வாழ்க வாழ்கவே",
      "lyricistTa": "பாரதிதாசன்",
      "evidenceBasis": "external-source",
      "evidenceReference": "tracklist-evidence.json: track 11 (`வாழ்க வாழ்கவே`)",
      "performanceContext": "Opening dance/song at the gathering before Thangappan speaks.",
      "reprisesId": null
    },
    {
      "id": "parasakthi-song-002",
      "canonicalScene": 4,
      "kind": "speaker-labelled-verse",
      "openingLineTa": "இவ்வாழ்வினிலே ஒளி ஏற்றும் தீபம்",
      "lyricistTa": "மு. கருணாநிதி",
      "evidenceBasis": "anthology-attributed",
      "evidenceReference": "works/kalaignar-thirai-isai-paadalgal/songs/song-002.md (kalaignar-song-002, anthology song 2, lyric PDF 29); anthology contents PDF 28 lists `இல் வாழ்வினிலே ஒளி ஏற்றும் தீபம்` beside `கலைஞர்`. Cross-witness comparison: songs/match-report-002-il-vaazhvinile.md",
      "performanceContext": "Thangappan and Kalyani alternate labelled sung/verse lines; `இரு` marks their joint closing line.",
      "reprisesId": null
    },
    {
      "id": "parasakthi-song-003",
      "canonicalScene": 8,
      "kind": "unlabelled-song",
      "openingLineTa": "ஓ ரசிகரும் சீமானே வா",
      "lyricistTa": "கே. பி. காமாட்சிசுந்தரம்",
      "evidenceBasis": "external-source",
      "evidenceReference": "tracklist-evidence.json: track 6 (`ஓ ரசிக்கும் சீமானே`)",
      "performanceContext": "Dance-house performance observed by Gunasekaran and Jolly.",
      "reprisesId": null
    },
    {
