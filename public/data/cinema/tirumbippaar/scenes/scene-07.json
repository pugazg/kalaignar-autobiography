  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[உள்ளே பெண்கள் பலர் திருமண வேளைகளில் ஈடுபட்டிருக்கின்றனர்.குமுதா வரல்- பூமாலை ஆவலுடன் ஓடிச்சென்று]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: குமுதா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: சின்னம்மா! (இருவரும் தழுவல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: ஏம்மா இவ்வளவு தாமதம்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: பரீட்சை சின்னம்மா. உடனே வரமுடியிலே..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : உட்காரு குமுதா. தம்பிக்கு உன்னை கல்யாணம் செஞ்சு வச்சு வீட்டோட இருப்பேன்னு நெனச்சேன்..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி : அதுக்குள்ளத்தான் அவரு காதல் திருமணம் பண்ணிட்டாரே."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: ஏய் குண்டுமணி."
      },
      {
        "kind": "stage-direction",
        "text": "(பரந்தாமன் வருகை)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : அடடே ! குமுதா தேவி எப்போது வந்தார்கள்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: மாமா, மாப்பிள்ளை முறுக்கிலேயே இருக்காரே! ஏன் மாமா, மாமி சிகப்பா கருப்பா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : அய்ய... படிச்ச பெண்ணுக்கு இதுகூட தெரியிலேயே. ஒரு பெண்ணு சிகப்பு நிறமாயிருந்த எவனாவது விரும்புவானா? ரத்தம், குங்குமம் இதெல்லாம் சிகப்பு - இந்த நிறத்தை எவன் தொடுவான். இனிமேல் இப்படிக் கேளு. எழுமிச்சம்பழ நிறமா,நாகற்பழ நிறமா,அல்லது இரண்டுங் கலந்ததா?"
      },
      {
        "kind": "stage-direction",
        "text": "(குமுதா சிரிக்கிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: கல்யாண உற்சாகத்திலே மாமாவுக்கு கவிதைகளால்ல ஊறுது !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி: அதுவும் கலர் கவிதைகளால்ல ஊறுது ! (சிரிப்பு)"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s007-u001",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
