  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[கருடன் பதிப்பகம்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : பரந்தாமனின் பாவ மன்னிப்புப் படலம்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : ம் பத்திரிகை காரனுங்க அப்படித்தான் எழுதுவானுங்க. அதுக்கெல்லாம் பயப்பட முடியுமா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : மன்னிப்புக் கேட்டதால் மானமே அழிந்துவிட்டதாமே ."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : நல்ல மானம்டா ! மன்னிப்புக் கேக்கறதாலேயே ஒரு மானம் அழிஞ்சிடும்னா அப்பேர்ப்பட்ட மானம் இருக்கவே வேண்டாமே."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: சபாஷ்."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
