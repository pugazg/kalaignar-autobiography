  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[சாப்பிட்டான கப் சாசர்களை ஒரு பெண் எடுத்துப் போகிறாள்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குணரத்தனம்",
        "text": "குணரத்தனம்: அப்ப சந்தோஷம். ஏழாந்தேதி ஒரு நல்ல நாள் இருக்கு ... ... ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: நாள் எதா இருந்தா என்ன!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குணரத்தனம்",
        "text": "குணரத்தனம்: இல்லம்மா! எனக்கு நாள் நக்ஷத்திரத்திலே கொஞ்சம் நம்பிக்கை."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: சரி சரி ... ... அதனால் என்ன!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "தங்கம்",
        "text": "தங்கம்: நீ ஏம்மா கல்யாணம் பண்ணிக்காம ... ... ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: இந்தக் குடும்பத்து பொறுப்பாளியே நான்தானே. தம்பி செல்வமாக வளர்ந்தவன், குடும்ப கஷ்டத்தை அவனுக்கு கொடுக்கக் கூடாதுன்னு அப்பா அம்மா உத்தரவு. அக்கா மகள், தாய் தந்தை இல்லாதவள் சென்னையில் படித்துக்கொண்டிருக்கிறாள், அவளுக்கு நான்தான் துணை."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குணரத்தனம்",
        "text": "குணரத்தனம்: இப்படி எல்லோருக்கும் அம்மா துணையா இருக்கிற தாலதான் அவங்க வாழ்க்கைத் துணைவரை வீட்டோட இருக்கிறவரா பாக்கிறாங்க!...... ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "தங்கம்",
        "text": "தங்கம்: ஏம்பா....அது மாதிரி புருஷன் கிடைக்காது ... லக்ஷிமி மாதிரி இருக்குது பொண்ணு!"
      },
      {
        "kind": "stage-direction",
        "text": "(பரந்தாமன் வருகிறான் குளித்து டிரஸ்.செய்துகொண்டு)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: வா தம்பி! இவங்கள்ளாம் தெரியுமா? (பரந்தாமன் முழித்தல்) ஓ! இவுங்க பெண்ணைமாத்திரந்தான் தெரியும் போலிருக்கு ... ... பாமாவோட பெற்றோர்!."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: ஒகோ! நமஸ்காரம்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: கல்யாணம் நிச்சயம் பண்ண வந்திருக்காங்க! என்ன ... ... சம்மதந்தானே உனக்கு ... ... ..."
      },
      {
        "kind": "stage-direction",
        "text": "(பரந்தாமன் மௌனம், நாணம்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குணரத்தனம்",
        "text": "குணரத்தனம்: என்ன கேக்கிறீங்க இதைப்போயி! வாழைப்பழம் வேண்டாங்கிற குழந்தை உண்டாங்கிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: என்ன பரந்தாமா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: சரிக்கா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குணரத்தனம்",
        "text": "குணரத்தனம்: அப்பசரி. நாங்க வரோம். சந்தோஷம். ஆக வேண்டியதைக் கவனிப்போம்."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s004-u001",
        "kind": "stage-direction",
