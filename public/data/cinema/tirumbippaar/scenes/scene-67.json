  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[புண்யகோடி வீடு - இரவு"
      },
      {
        "kind": "stage-direction",
        "text": "[புண்யகோடி கதவைத் தட்டல்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குரல்",
        "text": "குரல் : ராதா ராதா!"
      },
      {
        "kind": "stage-direction",
        "text": "(பரந்தாமன் வேறு பக்கமாக வெளியேறுகிறான். புண்யகோடி வருகிறான். பரந்தாமன் வந்ததைச் சொல்ல முனைகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : ராதா சாப்பாடு போடு சீக்கிரம்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "ராதா",
        "text": "ராதா : .........."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : என்னா... இன்னைக்கு நேரத்லயே சாப்ட்டு படுக்கணும்..."
      },
      {
        "kind": "stage-direction",
        "text": "(கிராமபோன் வைத்துப் பாடியதற்காக கிராமபோனைக் காட்டுகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : ஆமாம் ! இப்பதான் சங்கீதம் கேட்கிற வேளை! சாப்பாட்டைப் போடு நீ!"
      },
      {
        "kind": "stage-direction",
        "text": "(பரந்தாமன் போன ஜன்னலைக் காட்டுகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : ஜன்னல் திறந்திருந்தா சாத்துறதுதானே ..."
      },
      {
        "kind": "stage-direction",
        "text": "(இன்னும் ஏதோ சொல்லப் போகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : அது கெட்டுது போ ! நீ சாப்பாடு போடுறியா இல்லியா"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
