  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "(பையன் அழுதல்)"
      },
      {
        "kind": "stage-direction",
        "text": "[பாமாவின் தந்தை குணரத்னம் பூமாலையிடம் தன் மகளைப்பற்றி வருத்தமுடன் கூறிக்கொண்டிருக்கிறார்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குணரத்னம்",
        "text": "குணரத்னம் : அவள் மாத்திரமா போனாள்.வீட்டை அடமானம் வச்சு, செஞ்சுப்போட்ட ஆயிரம் ரூபாய் நகையோடவும் போய்ட்டா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: ஆயிர ரூபாய் நகைதானே.இந்தாருங்கள்... (தன் அணிகலன்களைக் கழற்றிக்கொடுத்து) இதை வைத்துக்கொள்ளுங்கள். (கொடுக்கிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குணரத்னம்",
        "text": "குணரத்னம் : (அதை வாங்கி) ஏன்? இதை நான் யாருக்குப் போட்டு அழகு பார்க்கப் போகிறேன். நீயே வச்சுக்க. (கீழே போட்டுவிட்டு) எனக்குத் துரோகம் பண்ணுனவுங்க தொலைஞ்சு போய்டுவாங்க !..."
      },
      {
        "kind": "stage-direction",
        "text": "(போகிறார். பூமாலை சோர்ந்து சோபாவில் உட்காருகிறாள். பரந்தாமன் வந்து கீழே கிடக்கும் நகைகளைப் பார்த்து)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: அக்கா. இது ஏது நகை?"
      },
      {
        "kind": "stage-direction",
        "text": "(பூமாலை மௌனம்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : ஏன் இப்படிக் கீழே கிடக்கிறது. (எடுக்கிறான்) எல்லாம் பொன்னகைதானே?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: இல்லை. துரோகத்தின் புன்னகை !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: (புரியாதவன்போல) என்னடா இது ! என்னக்கா விஷயம்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: மான் தோலிலே வேங்கை அதிக நாள் வாழமுடியாது பரந்தாமா ! அதையும் வேட்டையாட ஒரு வேடன் வந்துவிடுவான். ஊர்ப் பெண்களிடம் விளையாடுகிறவர்களை உயிரோடு விடுவதில்லை மக்கள் !... அதை ஞாபகம் வைத்துக்கொள்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: எப்போது வீட்டுக்கு வந்தாலும் இந்த ஒப்பாரிதானா ? மனிதன் நிம்மதியா வாழவே முடியாது போலிருக்கிறது!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: மனிதன் தான் மாத்திரம் வாழக்கூடாது. மற்றவரையும் வாழவிட வேண்டும்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: சரி போதும் போதும். காவியாடை கட்டிக்கொண்டு எங்கேயாவது தொலைய வேண்டியதுதான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : ஏன் ! அந்தத் திரைமறைவிலே சுலபமாக ஏமாற்ற முடியுமென்று கருதுகிறாயா? பெண் இனத்தை மண்ணில் நெளியும் புழுக் கூட்டமாக மதித்துவிட்ட பித்தனே ! எங்கு போனாள் பாமா? சொல். எங்கே அவளைத் தவிக்கவிட்டாய்? எரிமலைமீது விளையாட வந்த அந்த ஏழைச் சிறுமியின் கதி என்னவாயிற்று. சொல்! சொல்ல மாட்டாயா பாவி ! எங்கே பாமா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : பரலோகத்தில் போய் தேடிப்பார் !"
      },
      {
        "kind": "stage-direction",
        "text": "(போய்விடுகிறான்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: (கண்ணீர் பெருக) ஆ ! அம்மா ! அப்பா ! உங்களுக்குக் கொடுத்த உறுதிமொழியை என்னால் காப்பாற்ற முடியாது போலிருக்கிறதே!"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s030-u001",
        "kind": "stage-direction",
