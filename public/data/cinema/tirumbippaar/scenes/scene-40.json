          {
            "pdfPage": 52,
            "printedPage": 44
          }
        ],
        "text": "For our leader Paranthaman!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s040-u003",
        "kind": "dialogue",
        "speakerLabel": "மற்றவர்கள்",
