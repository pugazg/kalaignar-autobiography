            "pdfPage": 52,
            "printedPage": 44
          }
        ],
        "text": "Jai! Jai!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s040-u004",
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "sourceRecordId": "tirumbippaar-s040-d004",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 52,
            "printedPage": 44
          }
        ],
        "text": "Therefore, as your leader, I ask all of you to return peacefully to work. We will soon celebrate our victory in grand fashion.",
        "notes": []
      },
