  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "(கரகோஷம். புண்யகோடிக்கு ஒரே பூரிப்பு)"
      },
      {
        "kind": "stage-direction",
        "text": "[பூமாலை பிள்ளைகளுடன்!]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: ஜீவஹிம்சை கூடாதென்றவர்கள் இருவரைச் சொல்லு."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பையன்",
        "text": "பையன் : புத்தர், காந்தி"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: முகுந்தா! மூவேந்தர் யார்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பையன்",
        "text": "பையன் : சேரன், சோழன்.... (திணறுவது)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : உம். சொல்லு"
      },
      {
        "kind": "prose",
        "text": "பாண்டியன்"
      },
      {
        "kind": "stage-direction",
        "text": "(பாண்டியன் என்றதும் அவள் முகம் மாறுகிறது- உதடுகள் முணுமுணுக்கின்றன. பிறகு மாணவ - மாணவிகளிடம்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: சரி வீட்டுக்கு போய்ட்டு நாளைக்கு வாங்க"
      },
      {
        "kind": "stage-direction",
        "text": "(எல்லோரையும் அனுப்புகிறாள். அவர்கள் போனதும், தோட்டத்துப் பக்கம் போகிறாள்)"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
