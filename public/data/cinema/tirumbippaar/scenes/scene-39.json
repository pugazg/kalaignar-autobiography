  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "(பாண்டியன் நடக்கிறான் அவளுடன்)"
      },
      {
        "kind": "stage-direction",
        "text": "[ஊரெங்கும் சுவர்களில் மில் வேலைநிறுத்தப் போஸ்டர்கள் ஒட்டப்பட்டிருக்கின்றன ]"
      },
      {
        "kind": "stage-direction",
        "text": "(மில் முதலாளி அறை]"
      },
      {
        "kind": "stage-direction",
        "text": "[பரந்தாமனும் கருடனும் வர)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : வாருங்கள்.... உட்காருங்கள்!...."
      },
      {
        "kind": "stage-direction",
        "text": "(இருவரும் உட்காராமல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : அழைத்த காரியமென்ன?"
      },
      {
        "kind": "stage-direction",
        "text": "(இருவரும் உட்காருதல் )"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : ம்... இந்த வேலை நிறுத்தத்தைப்பற்றி...."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : எல்லாம் என் ஏற்பாடுதான் - நான் காட்டிய வழியில் செல்ல ஆயிரக் கணக்கான தொழிலாளர்கள் தயாராயிருக்கிறார்கள்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: மிஸ்டர் பரந்தாமன்! மில் தொழிலாளர்களின் கிளர்ச்சியை உங்களால்தான் நிறுத்த முடியுமென்று எனக்குத் தெரியும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : சந்தேகமா அதிலே! பரந்தாமன் மாத்திரம் இல்லாவிட்டால் இந்நேரம் மில்லையே அழித்திருப்பார்கள்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: அதோட, தங்கள் உயிருக்கே ஆபத்து ஏற்படுத்த இருந்தார்கள் ! நான்தான் தடுத்தேன்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : சந்தோஷம் ! ரொம்ப நன்றி! என் உயிரைக் காப்பாற்றியதற்காக ! தங்களுக்கு என்னுடைய சிறிய உதவியாக இந்த ஐயாயிர ரூபாயை அளிக்கிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : என்ன... பணமா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : வாங்கிக் கொள்ளப்பா ! தொழிலாளர் நிதியில் சேர்த்துவிடலாம்! ஏழைகளுக்காக உழைக்கவே ஜென்மம் எடுத்துட்டோம்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: நான் இதை லஞ்சமாக நினைத்துக் கொடுக்கவில்லை."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : நானும் இதை அப்படி நினைத்து வாங்கவில்லை."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : இந்த ஸ்டிரைக்கை எப்படியாவது நிறுத்திவிடுவீர்களானால்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : நிறுத்திவிடலாம். அதற்கு புண்யகோடியை மாற்றினால்தான் முடியும்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன்: புண்யகோடி.... அவன் மூவாயிரமாவது கேட்பான்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : தருகிறேன் ! இப்போதே தருகிறேன்."
      },
      {
        "kind": "stage-direction",
        "text": "(பணம் எடுத்துத் தருகிறார்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: தங்களுடைய நல்ல குணத்திற்காகவும்,நம்முடைய நட்பு நீடிக்க வேண்டும் என்பதற்காகவும், ஒரு பெரிய கிளர்ச்சியை விட்டுக்கொடுக்கிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: ரொம்ப நன்றி!"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
