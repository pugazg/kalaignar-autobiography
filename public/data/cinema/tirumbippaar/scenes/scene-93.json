  "tamil": {
    "blocks": [
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: சின்னம்மா ! சின்னம்மா !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : அழாதே குமுதா!..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : நீங்கள் கொல்லவில்லை உங்கள் தம்பியை ! அவனுடைய பழைய செயல்கள் அவனைப் பழிதீர்த்துக் கொண்டன !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: ஆரம்பத்திலிருந்தே அவன் நல்லவனாயிருந்தால் எனக்கேன் அவன்மீது ஆத்திரம் வரப்போகிறது. தொட்டுத் தொட்டு வளர்த்த என் செல்வத்தை துடிக்கத் துடிக்க ஏன் கொல்லப்போகிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: சின்னம்மா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : குமுதா ! உன் மாமன் உனக்கும் ஊராருக்கும் தந்த உபத்திரவங்களுக்கு உகந்த பரிசு வாங்கிக்கொண்டான் !\nஉன்னால் சந்தேகிக்கப்பட்ட நானும் களங்கமற்றவள் என்று காட்டிக்கொண்டேன், இந்தக் காரியத்தைச் செய்து !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: என்னை மன்னித்துவிடு சின்னம்மா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : அழாதே கண்ணே அழாதே ! சரி நேரமாகிறது ! குமுதா! பாண்டியன் ! வருகிறேன்."
      },
      {
        "kind": "stage-direction",
        "text": "(மாணவிகளின் கண்களில் நீர். அதைக்கண்ட பூமாலை)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : குமுதா ! என் ஒரே வேண்டுகோளை நிறைவேற்று!"
      },
      {
        "kind": "stage-direction",
        "text": "(மாணவிகளைக் காட்டி) இதோ புதிய ஜெகத்தின் பூங்கொத்துகள்! இந்த இளம் இதயங்களிலே அறிவு விளக்கேற்றி வைக்கப் பாடுபடு. திரும்பிப்பார் என்னும் அறிவுரையை, நன்றாக வாழ்பவர்கள், நலிந்து கிடப்பவர்கள் நாசவேலையில் ஈடுபட்டிருப்பவர்கள் அத்தனை பேருக்கும் தேவையான அறிவுரையாக்க நீயும் பாண்டியனும் முயற்சியுங்கள் ! வருகிறேன்.. (மாணவிகளிடம்) என் சிங்காரச் சிட்டுகளே ! எல்லோருக்கும் வாழ்த்து ! திரும்பிப்பார் உபதேசத்தை மறந்துவிடாதீர்கள், நான் திரும்பாத இடத்திற்குச் செல்கிறேன்."
      },
      {
        "kind": "stage-direction",
        "text": "(குழந்தைகள் கண்ணீருடன் நிற்கிறார்கள். பூமாலை வார்டர்கள் கூட்டிப் போகிறார்கள்)"
      },
      {
        "kind": "prose",
        "text": "வணக்கம்."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
