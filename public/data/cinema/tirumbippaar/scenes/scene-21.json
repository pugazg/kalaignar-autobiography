  "tamil": {
    "blocks": [
      {
        "kind": "dialogue",
        "speakerLabel": "சமையல்காரன்",
        "text": "சமையல்காரன்: அம்மா ! சின்னம்மா வர்றாங்க!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: சின்னம்மா!"
      },
      {
        "kind": "stage-direction",
        "text": "(குமுதா ஓடி வருகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: குமுதா! (தழுவிக் கொள்ளல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: (பாண்டியனைப் பார்த்து) சின்னம்மா இவுரு .."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: சொன்னால் தெரியுமா உனக்கு ?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: சொல்லாமலே தெரியும். “வாழு, வாழ விடு” மன்னிக்கவும். தங்கள் பெயர் பாண்டியன்தானே!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : ஆமாம்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "சமையல்காரன்",
        "text": "சமையல்காரன்: யாருங்க. அந்த கோவலனைக் கொன்னாரே அந்தப் பாண்டியனா .."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி: ஆக்கும்... சௌந்தர பாண்டியன். ஆளைப்பாரு !..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: வாருங்கள் முதலில் காபி சாப்பிடுவோம்...."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s021-u001",
