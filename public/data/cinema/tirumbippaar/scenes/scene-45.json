  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[மில் முதலாளி வீடு"
      },
      {
        "kind": "stage-direction",
        "text": "(மில் முதலாளியும், உஷாவும்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : ஒருவன் தொலைந்தானென்று பெருமூச்சு விட்டேன். இன்னொருவன் முளைக்கிறான். பாண்டியன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "text": "உஷா: எல்லோரையும் பரந்தாமனைப்போல நினைத்து பணத்தால் அடித்துவிட முடியுமா ! லட்சியத்தில் உறுதி உள்ளவர்கள் இரும்புப் பெட்டிக்குத் தலை வணங்க மாட்டார்களப்பா !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : நீ சும்மாகிட உஷா ! உனக்கு ஒன்றும் தெரியாது!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "text": "உஷா: ஏம்ப்பா லேடி டாக்டருக்கு உலக விஷயம் தெரியாதுன்னு உங்கள் அபிப்ராயமா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : லேடி டாக்டர் !... தொழிலாளர் தொழிலாளர் என்று தொல்லை கொடுத்து ஆயிரக் கணக்கில் எனக்கு நஷ்டம் உண்டாக்குகிறார்களே அந்த மனவேதனைக்கு மருந்து கொடுக்க முடியுமா உன்னால்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "text": "உஷா: ஓ! கொடுக்க முடியும். ஆனால் இந்த மருந்தை இருதயம் என்ற இலையில் வைத்து, இரக்கம் என்ற தேனில் கலந்து சாப்பிட வேண்டும். மருந்துக்குப் பெயர் என்ன தெரியுமா அப்பா ? சமதர்மம்.சமத்துவம். முதலில் கொஞ்சம் கசப்பாயிருக்கும். பிறகு சரியாகி விடும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : உஷா !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "text": "உஷா: ஏன் ஆத்திரப்படுகிறீர்கள். தொழிலாளியின் குறைகளை கவனியுங்கள். எல்லாம் அடங்கிவிடும்."
      },
      {
        "kind": "stage-direction",
        "text": "(பியூன் வந்து )"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பியூன்",
        "text": "பியூன்: பாண்டியனாம். உங்களைப் பார்க்க வந்திருக்கிறார்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : பாண்டியன் ! வரச்சொல் ! வரச்சொல் ! பார்த்தாயா உஷா ! எல்லாம் பண வேட்டைக்குத்தான் பயல்கள் தலைவர் வேஷம் போடுகிறார்கள்."
      },
      {
        "kind": "stage-direction",
        "text": "(பாண்டியன் வருதல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: (உட்காந்து) உங்களிடம் ஒரு முக்கியமான செய்தி பற்றி"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : சொல்லு ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : தொழிலாளர்கள்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : தெரியும். அவர்களை அடக்க எவ்வளவு பணம் வேண்டுமானாலும் கேள் தருகிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : அய்யா! ''மஞ்சத்திலே முதலாளி - பஞ்சத்திலே பாட்டாளி \" என்று முழங்கிவிட்டு, லஞ்சத்திலே நீச்சலடிக்-"
      },
      {
        "kind": "prose",
        "text": "கும் பரந்தாமனல்ல நான். பாண்டியன். பாட்டாளிகளின் தோழன் ...."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : பாண்டியா என் பேச்சைக் கேள்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: உங்கள் பேச்சை நான் கேட்க வேண்டாம். உழைப்பவர்களின் பெருமூச்சை நீங்கள் கவனியுங்கள்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : பெருமூச்சு, உழைப்பு, வியர்வை, ரத்தம் எல்லாம் கேட்டுக்கேட்டு காது அடைத்து விட்டதப்பா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : காது அடைத்துவிடும்,கண் இருட்டிவிடும், வாய் மூடிவிடும். கைகால் அசையாது ! கடைசியில் இருதயமே நின்றுவிடும். அந்தப் பரிதாபகரமான நிலைமை ஏற்பட வேண்டாமென எச்சரிக்கிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : ஏ, இங்கென்ன பிரசங்கமா செய்ய வந்தாய்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: இல்லை. பின்னடைந்துபோன தொழிலாளர் நிலை கண்டு, மனம் புண்ணடைந்து புலம்ப வந்தேன் ."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: புலம்புவதற்கு சுடுகாட்டுக்குப் போ."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : சுகபோகியே! ஞாபகமிருக்கட்டும்."
      },
      {
        "kind": "stage-direction",
        "text": "(போய்விடுகிறான் - முதலாளி ஆத்திரமுடன் உலாவுகிறார்)"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s045-u001",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 58,
            "printedPage": 50
          }
        ],
        "text": "(The mill owner and Usha.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u002",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s045-d001",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 58,
            "printedPage": 50
          }
        ],
        "text": "I heaved a sigh of relief thinking one fellow was gone. Now another one sprouts up—Pandiyan.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u003",
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "sourceRecordId": "tirumbippaar-s045-d002",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 58,
            "printedPage": 50
          }
        ],
        "text": "Can you think everyone is like Paranthaman and knock them down with money? People firm in their ideals will not bow their heads before the safe, Appa!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u004",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s045-d003",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "Keep quiet, Usha! You don't know anything!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u005",
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "sourceRecordId": "tirumbippaar-s045-d004",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "What, Appa? Is it your opinion that a lady doctor knows nothing about the world?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u006",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s045-d005",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "Lady doctor!... These workers keep tormenting me with 'workers, workers' and cause me losses running into thousands. Can you give medicine for that mental anguish?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u007",
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "sourceRecordId": "tirumbippaar-s045-d006",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "Oh! I can. But this medicine must be placed on the leaf called the heart, mixed with the honey called compassion, and taken. Do you know the name of the medicine, Appa? Egalitarianism. Equality. It will taste a little bitter at first. Then it will become all right.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u008",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s045-d007",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "Usha!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u009",
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "sourceRecordId": "tirumbippaar-s045-d008",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "Why are you getting angry? Attend to the workers' grievances. Everything will settle down.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u010",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "(The peon enters.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u011",
        "kind": "dialogue",
        "speakerLabel": "பியூன்",
        "sourceRecordId": "tirumbippaar-s045-d009",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "It's Pandiyan. He has come to see you.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u012",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s045-d010",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "Pandiyan! Tell him to come! Tell him to come! Did you see, Usha? These fellows put on the costume of leaders only to hunt for money.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u013",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "(Pandiyan enters.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u014",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s045-d011",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "(Sitting down) I came about an important matter....",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u015",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s045-d012",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "Tell me....",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u016",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s045-d013",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "The workers.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u017",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s045-d014",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          }
        ],
        "text": "I know. Ask for however much money you want to suppress them; I'll give it.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u018",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s045-d015",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 59,
            "printedPage": 51
          },
          {
            "pdfPage": 60,
            "printedPage": 52
          }
        ],
        "text": "Sir! I am not Paranthaman, who thunders, 'The owner on the bed—the toiler in famine,' and then swims in bribes. I am Pandiyan—a comrade of the toilers....",
        "notes": [
          "This source-labelled utterance crosses PDF 59→60 and remains one English unit.",
          "The Tamil deliberately plays on `மஞ்சம் / பஞ்சம் / லஞ்சம்`; the semantic contrast is preserved, but the exact sound pattern cannot be reproduced naturally in English."
        ]
      },
      {
        "id": "tirumbippaar-en-s045-u019",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s045-d016",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 60,
            "printedPage": 52
          }
        ],
        "text": "Pandiyan, listen to me.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u020",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s045-d017",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 60,
            "printedPage": 52
          }
        ],
        "text": "I need not listen to your words. You pay attention to the sighs of those who labour!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u021",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s045-d018",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 60,
            "printedPage": 52
          }
        ],
        "text": "Sighs, labour, sweat, blood—I've heard all this so much that my ears are blocked!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u022",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s045-d019",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 60,
            "printedPage": 52
          }
        ],
        "text": "Your ears will become blocked, your eyes will go dark, your mouth will close. Your hands and legs will not move! In the end, even your heart will stop. I am warning you so that such a pitiable state does not come about.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u023",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s045-d020",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 60,
            "printedPage": 52
          }
        ],
        "text": "Hey, did you come here to deliver a sermon?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u024",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s045-d021",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 60,
            "printedPage": 52
          }
        ],
        "text": "No. Seeing how far the condition of the workers has fallen behind, I came to lament with a wounded heart.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u025",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s045-d022",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 60,
            "printedPage": 52
          }
        ],
        "text": "Go to the cremation ground if you want to lament.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u026",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s045-d023",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 60,
            "printedPage": 52
          }
        ],
        "text": "You man of luxury! Remember this.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s045-u027",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 60,
            "printedPage": 52
          }
        ],
        "text": "(Pandiyan leaves. The mill owner paces about angrily.)",
        "notes": []
      }
    ]
  }
}
