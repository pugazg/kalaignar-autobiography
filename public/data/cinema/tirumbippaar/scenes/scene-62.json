          }
        ],
        "text": "(Behind a house.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s062-u002",
        "kind": "dialogue",
        "speakerLabel": "அம்மாமி",
        "sourceRecordId": "tirumbippaar-s062-d001",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 79,
            "printedPage": 71
          }
        ],
        "text": "What a fine job you're doing, girl! It looks as though you'll smash all the things in our house!... Go, go! Enough—enough of you and your work. That's why I said we shouldn't take a pregnant woman on for work.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s062-u003",
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "sourceRecordId": "tirumbippaar-s062-d002",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 79,
            "printedPage": 71
          }
        ],
        "text": "Amma! Think of me as your own daughter...",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s062-u004",
        "kind": "dialogue",
        "speakerLabel": "அம்மாமி",
        "sourceRecordId": "tirumbippaar-s062-d003",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 79,
            "printedPage": 71
          }
        ],
        "text": "Daughter, indeed! I've already got nine girls born here! Do I need you too? I said go—go!",
        "notes": []
      }
    ]
  }
