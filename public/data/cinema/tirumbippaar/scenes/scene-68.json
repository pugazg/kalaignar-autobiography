  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "(போலீஸ் ஸ்டேஷன் - இரவு"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "போலீஸ்",
        "text": "போலீஸ்: போலீஸார் மீது கல்வீச்சு!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "II போலீஸ்",
        "text": "II போலீஸ்: மில்லின் கதவையே தூள் தூளாக உடைத்து விட்டார்கள். மில் முதலாளி வீட்டிலும் கல் வீசினார்கள்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "போலீஸ்",
        "text": "போலீஸ்: தெருவில் ஜனங்கள் நடமாடவே பயப்படுகிறார்கள்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "போலீஸ்",
        "text": "போலீஸ்: நாளைக்கு காலையிலே பெரிய ஊர்வலம் ஒண்ணு இருக்காம்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "சப்- இன்ஸ்பெக்டர்",
        "text": "சப்- இன்ஸ்பெக்டர்: (வந்து) சரி, முக்கியஸ்தர்களை யெல்லாம் கைதுசெய்ய உத்திரவு வந்திருக்கு. புறப்படுங்க!"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
