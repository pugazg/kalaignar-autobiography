  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "(பூமாலை ரயிலில் உட்கார்ந்திருக்கிறாள்.)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி : அம்மா ! அப்ப நான் அடுத்த வண்டீல ஏறிக்கிறேன்."
      },
      {
        "kind": "stage-direction",
        "text": "(போகிறான். பாண்டியன் வந்து அதே Carriageல் ஏறுகிறான். அவன் எழுதிய புத்தகமான 'வாழு வாழவிடு' என்பதின் மூலம் பூமாலை அவனை அடையாளம் புரிந்துகொள்கிறாள். பிறகு டிபனை எடுத்து)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: சாப்பிடுங்கள் ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : இல்லை வேண்டாம்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: கொஞ்சம் எடுத்துக் கொள்ளுங்கள்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : ரொம்ப நன்றி ! நீங்கள் சாப்பிடுங்கள் !...."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : நீங்கள் எந்த ஊருக்குப் போகிறீர்கள்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: நானா எனக்கே தெரியவில்லை."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: மிகவும் மனவேதனை அடைந்திருக்கிறீர்கள். இதெல்லாம் உலகத்தில் சகஜம். பொருட்படுத்தக் கூடாது."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : என்னைத் தெரியுமா உங்களுக்கு !.."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : தெரியும்... இதோ. (புத்தகத்தைக் காட்டுதல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : (தலையைத் தாழ்த்தியபடி) வெட்கக் கேடு அய்யோ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : வருத்தப்படாதீர்கள்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: என் கதை முழுதும் புரியுமா உங்களுக்கு."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: (சஞ்சலமுடன்) புரியும். இன்று மணமகனாய் இருக்க வேண்டிய நீங்கள்........"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : போதும் உலகத்தின் முகத்திலேயே நான் விழிக்கக் கூடாது!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : நீங்கள் ஒரு தவறும் செய்யவில்லையே."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : நானா தவறு செய்யவில்லை. மானம் மரியாதைக்குக் கட்டுப்பட்டு வாழ்ந்த நான், இன்று அவமானச் சின்னமாக மாறிவிட்டேன், என் அறிவீனத்தால், கண்டவர் காரி உமிழ, காணாதவர் கேலி பேச, கண்ணிருந்தும் குருடனாய், காதிருந்தும் செவிடனாய் கள்ளி யொருத்தியைப் பற்றி தீர விசாரிக்காமல் கல்யாண மாப்பிள்ளையாக வேஷங் கட்டிக்கொண்டு ஓடி வந்தேனே முட்டாள். நானா தவறு செய்யவில்லை."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : சும்மாயிருங்கள். சென்னைக்கு வந்து எங்கள் வீட்டில் கொஞ்சம் ஓய்வு எடுத்துக் கொள்ளலாம்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: ஓய்வு. இந்த வேதனையை விரட்ட எந்த ஓய்வாலும் முடியாது."
      },
      {
        "kind": "stage-direction",
        "text": "(ரயில் போகிறது)"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s020-u001",
