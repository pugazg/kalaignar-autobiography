  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "(கார் போய் நிற்கிறது.பரந்தாமனும் புண்யகோடியும் இறங்குகிறார்கள்]."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : வாங்க ! உள்ளே வாங்க."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : கல்யாணத்தை ரொம்ப சிக்கனமாத்தான் செய்து விட்டீர்கள் இல்லையா..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி: ஆமாம்.. (உள்ளே திரும்பி) ராதா ராதா கொஞ்சம் வந்துட்டுப் போ."
      },
      {
        "kind": "stage-direction",
        "text": "(ராதா வந்து நிற்கிறாள் - அவளைக் காட்டி)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : இதுதான் .."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: ஓ.... பாண்டியனுக்கு தங்கச்சிவேறெ இருக்கா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : தங்கச்சியா ! இது அவனுக்கு சின்னம்மா ! என் சம்சாரம்..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: ஓ ... அப்படியா..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : (அசட்டு சிரிப்பு) ராதா ! டீ,காப்பி ஏதாச்சும் இருந்தா கொண்டா சீக்கிரம் ..."
      },
      {
        "kind": "stage-direction",
        "text": "(ராதா உள்ளே போகிறாள்)."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : ரொம்ப தங்கமான பொண்ணு! ஒரே ஒரு குறை வாய்தான் ஊமை ! ஆனா சுமாரா படிச்சிருக்கு ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : பாடுமா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : எப்படித் தம்பி பாடும் ஊமைங்கிறேன் ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: ஒகோ...... ஏன் குயிலு வார்த்தையை சொல்லியா கூவுது. என்னமோ கத்துது. அதையுந்தான் குயில் பாடுதுங்கிறான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : ஹி ஹி ஹி ..ஆமா... ஆமாம். நல்லாசொன்னீங்க ஒரு வார்த்தை."
      },
      {
        "kind": "stage-direction",
        "text": "(ராதா காப்பியுடன் வருகிறாள் மேசையிடம்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : வயதான காலத்தில் கல்யாணம் செய்துகொள்வதே... சமையல் செய்யச் சொல்லி சாப்பிட, சங்கீதம் பாடச் சொல்லி ரசிக்கதானே ."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : உங்களுக்குத்தான் தெரியுமே. அந்தப் பாழாப்போன மில்லுக்கு உழைக்கவே சரியாயிருக்கு நேரம்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : பாவம்... அதுவும் வயதான காலத்திலே..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : என்னா தம்பி சும்மா வயசாயிட்டு, வயசாயிட்டுங்கிறிங்க... (காபியை ராதையிடம் வாங்கியபடியே) தம்பி! தொழிலாளர் விஷயமெல்லாம் எப்படி யோசனை பண்ணியிருக்கீங்க ... அதை மறந்திடாதீங்க..."
      },
      {
        "kind": "stage-direction",
        "text": "(காபி அருந்தல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : மறப்பேனா. மறக்கவே மாட்டேன். நினைத்ததை முடிக்காமல் விட்டதில்லை இந்தப் பரந்தாமன் ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : எங்கே முடிக்காம விட்டுடுறீங்களோன்னு பார்த்தேன்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : அப்ப வர்ரேன்..."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s049-u001",
        "kind": "stage-direction",
