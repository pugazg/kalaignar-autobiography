  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[கருடன் பதிப்பகம்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: (வாழு புத்தகத்தைக் காட்டியபடி)கருடா! புத்தகம் எப்படி?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன்: ரொம்ப பிரமாதம்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பையன்",
        "text": "பையன் : இந்த புஸ்தகத்திலே ரொம்ப நல்லாயிருக்கிறது...."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : என்னடா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பையன்",
        "text": "பையன் : மேல் அட்டைங்க."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : சீ | அட்டை மாத்திரந்தான் நல்லா இருக்கா? அச்சு கூடத்தான் மணி மணியா இருக்கு."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : கருடா / அச்சு எப்படி, அட்டை எப்படி என்று விமர்சனம் கேட்கவில்லை : அறிவுரைகள் தந்திருக்கிறேனே, அது எப்படி என்றுதான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : ஆஹா / அதைக் கேக்கணுமா ..."
      },
      {
        "kind": "stage-direction",
        "text": "(புத்தகத்தைப் பிரித்துப் பாடல்)"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
