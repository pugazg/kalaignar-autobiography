{
  "workId": "tirumbippaar",
  "slug": "scene-77",
  "canonicalScene": 77,
  "sourceHeading": 77,
  "headingTa": "காட்சி 77] [மில் முதலாளி வீடு",
  "canonicalPart": "part-05",
  "continuationNotes": [],
  "pageProvenance": [
