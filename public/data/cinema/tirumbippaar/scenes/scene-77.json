    }
  ],
  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[முதலாளி காரைவிட்டு இறங்கிப் போக -பூமாலை \"ஐயா ஐயா\" என ஓடுதல்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : யார்ரா இது?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பையன்",
        "text": "பையன் : இவங்கதான் பரந்தாமனின் அக்காள் !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : பரந்தாமன் அக்காள் ... இங்க எங்க வந்தே ... போ- போ"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : கோபிக்காதீர்கள்... நான் வந்த விஷயம்..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : பரந்தாமனுக்கு பெண் கேட்க ... இல்லியா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : பரந்தாமனுக்கு பெண் கேட்க அல்ல - பாட்டாளிகளுக்கு வாழ்வு கேட்க!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : என்ன உளர்றே?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : பல தொழிலாளிகளை கிளர்ச்சியில் ஈடுபட்டார்கள் என்பதற்காக வேலையைவிட்டு நீக்கிவிட்டீர்கள், அவர்கள் எல்லாம் வேதனை தாங்காமல் வாடுகிறார்கள். அவர்களை மறுபடியும்..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : சரிதான். இப்ப தலைமைப்பதவி மாறியிருக்கோ - தம்பி போயி அக்காள் ! குடும்பத்துக்குள்ளேயே சுத்துதோ தலைமைப் பதவி."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: தவிப்பவர்கள் குறையைச் சொல்ல தலைவியாகத்தான் வரவேண்டுமோ? அய்யா அப்படியொன்றும் நான் வரவில்லை. ஏழைத் தொழிலாளிகளின் ஏக்கத்தைப் போக்குகிறேன் என்று சொல்லுங்கள் - போதும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : இந்தப் புத்தியை முன்னமேயே உன் தம்பிகிட்ட சொல்லியிருக்கணும் நீ."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : தம்பி செய்த பாபத்திற்குத்தான் அக்காள் பிராயச்சித்தம் செய்ய வந்திருக்கிறாள். தயவுசெய்யுங்கள் அய்யா."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : முடியாது... போ.... போய்விடு."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: (காலில் விழுந்து) அய்யா! உங்கள் காலைப்பிடித்துக் கொள்கிறேன், கதியற்றவரின் கண்ணீரைத் துடையுங்கள். பசி, பட்டினி, பஞ்சத்தில் பாட்டாளிகளைத் தள்ளாதீர்கள். என்ன இருந்தாலும் அவர்கள் உங்களிடம் வேலை செய்தவர்கள். உங்களுக்கு குழந்தைகள் மாதிரி ஐயா !..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : விடு காலை."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: விட முடியாது. வேதனைக்குரலுக்கு நீங்கள் செவி சாய்க்கும் வரையில், வாழ முடியாதவர்களுக்கு நீங்கள் வகைசெய்யும் வரையில் விட முடியாது."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : சீ மூதேவி."
      },
      {
        "kind": "stage-direction",
        "text": "(காலை உதறி போதல்- பூமாலை காயமடைதல்- அப்போது வந்த உஷா)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "text": "உஷா : அடெடெ! பூமாலையா.... பலமாக அடிபட்டுவிட்டதே. டேய்...யார் அங்கே?"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s077-u001",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "(The mill owner gets out of his car and walks away. Poomaalai runs after him calling, 'Ayya! Ayya!')",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u002",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s077-d001",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "Who is this?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u003",
        "kind": "dialogue",
        "speakerLabel": "பையன்",
        "sourceRecordId": "tirumbippaar-s077-d002",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "She is Paranthaman's elder sister!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u004",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s077-d003",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "Paranthaman's sister... what have you come here for... go—go....",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u005",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s077-d004",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "Please don't be angry... the reason I came...",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u006",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s077-d005",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "To ask for my daughter for Paranthaman... isn't that it?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u007",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s077-d006",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "Not to ask for a bride for Paranthaman—to ask for a life for the workers!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u008",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s077-d007",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "What are you babbling about?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u009",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s077-d008",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "You dismissed many workers because they took part in the agitation. They are all wasting away, unable to bear the suffering. If only you would take them back....",
        "notes": [
          "The corrected Tamil ends this utterance unfinished at `அவர்களை மறுபடியும்...`; the English preserves that incompletion rather than supplying an action."
        ]
      },
      {
        "id": "tirumbippaar-en-s077-u010",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s077-d009",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "Very good. So the leadership has changed now—the younger brother has gone and the elder sister has taken over! The leadership keeps circling within the family itself.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u011",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s077-d010",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "Must one come as a leader simply to speak of the suffering people's grievances? Ayya, I have not come as any such thing. Just say that you will relieve the anguish of the poor workers—that is enough.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u012",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s077-d011",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 93,
            "printedPage": 85
          }
        ],
        "text": "You should have given this advice to your younger brother long ago.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u013",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s077-d012",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 93,
            "printedPage": 85
          }
        ],
        "text": "The elder sister has come to make atonement for the sin committed by the younger brother. Please show mercy, ayya.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u014",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s077-d013",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 93,
            "printedPage": 85
          }
        ],
        "text": "Impossible... go.... go away.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u015",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s077-d014",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 93,
            "printedPage": 85
          }
        ],
        "text": "(Falling at his feet.) Ayya! I am holding your feet—wipe away the tears of those who have no refuge. Do not push the workers into hunger, starvation and famine. Whatever else, they are people who worked for you. They are like your own children, ayya!...",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u016",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s077-d015",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 93,
            "printedPage": 85
          }
        ],
        "text": "Let go of my leg.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u017",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s077-d016",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 93,
            "printedPage": 85
          }
        ],
        "text": "I cannot let go. Until you listen to the voice of suffering, until you make a way for those who cannot live, I cannot let go.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u018",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s077-d017",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 93,
            "printedPage": 85
          }
        ],
        "text": "Ugh, you wretched woman!",
        "notes": [
          "The source insult is `மூதேவி`; the English renders its abusive force without replacing the Tamil record."
        ]
      },
      {
        "id": "tirumbippaar-en-s077-u019",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 93,
            "printedPage": 85
          }
        ],
        "text": "(He jerks his leg free and leaves. Poomaalai is injured. Usha arrives at that moment.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s077-u020",
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "sourceRecordId": "tirumbippaar-s077-d018",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 93,
            "printedPage": 85
          }
        ],
        "text": "Oh! Poomaalai.... You've been badly hurt. Hey.... who's there?",
        "notes": []
      }
    ]
  }
}
