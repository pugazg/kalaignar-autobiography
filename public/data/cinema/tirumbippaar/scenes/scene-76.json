  "tamil": {
    "blocks": [
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி: ஏ .. பரந்தாமன் எங்கே?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி: என்னய்யா ஒதற்றே."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : அந்த பரந்தாமன் எங்கேடா."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி: என்னய்யா ஒதற்றே."
      },
      {
        "kind": "stage-direction",
        "text": "(ஓடுகிறான்)"
      },
      {
        "kind": "stage-direction",
        "text": "[பூமாலை வருகிறாள்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : யார் நீங்கள்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி: யாரா? மோசக்காரனை நம்பிய முட்டாள். தருதலைப் பயலைப் போயி தலைவன்னு தலையிலே தூக்கிவச்சுகிட்டு ஆடிய மடையன்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: என்ன சொல்றீங்க...."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : என்னம்மா சொல்லணும்? உன் தம்பி செஞ்ச வேலைக்கு - நூத்துக் கணக்கான தொழிலாளர்ங்க வயத்ல மண்ணைப் போட்டுவிட்டானம்மா !..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : எல்லோரையுந்தான் விடுதலைசெய்து விட்டார்களே."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : கோர்ட்ல விடுதலை செஞ்சாங்க. கிளர்ச்சிக்கு முக்யமானவங்களையெல்லாம் மில் முதலாளி வேலையை விட்டு நீக்கிட்டாரு என்னையும் சேத்து. நூற்றுக்கணக்கான குடும்பம் தவிக்குதுன்னா யாராலம்மா வந்தது இந்த அநியாயம்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : பொறுங்கள் பதறாதீர்கள்........"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி: பதறாம என்ன பண்றது. சொந்த விஷயத்துக்காக புரட்சி பண்ணச் சொல்லி இவ்வளவு ஏழைகளோட"
      },
      {
        "kind": "prose",
        "text": "சோத்ல மண்ணைப் போட்டுட்டானே பாவி. நாங்கல்லாம் நிழல் மாடு - காடு கழனிலே வேலை செய்யத் தெரியாது- எங்களுக்கு வேற என்ன வேலை தெரியும் பிச்சை எடுக்கலாம் அவ்வளவுதான்...ம் எங்கம்மா உன் தம்பி?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : அவன் வீட்டில் இல்லை."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி: ம்... அக்ரமக்காரன். அநியாயக்காரன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : ஐயா, நானே போயி மில் முதலாளியைப் பார்த்து உங்களுக்கெல்லாம் திரும்பவும் வேலை தரும்படி கேட்கிறேன். நீங்கள் போங்கள் தயவு செய்து."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : அந்தப் பய மட்டும் கண்ல அகப்பட்டான்னா ..."
      },
      {
        "kind": "stage-direction",
        "text": "(போகிறான்)"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s076-u001",
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "sourceRecordId": "tirumbippaar-s076-d001",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "Hey... where is Paranthaman?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u002",
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "sourceRecordId": "tirumbippaar-s076-d002",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "Why are you shouting, ayya?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u003",
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "sourceRecordId": "tirumbippaar-s076-d003",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "Where is that Paranthaman, da?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u004",
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "sourceRecordId": "tirumbippaar-s076-d004",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "Why are you shouting, ayya?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u005",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "(Gundumani runs away.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u006",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "(Poomaalai comes.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u007",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s076-d005",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "Who are you?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u008",
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "sourceRecordId": "tirumbippaar-s076-d006",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "Who am I? A fool who trusted a cheat. An idiot who hoisted a worthless fellow onto my head as a leader and danced around....",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u009",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s076-d007",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "What are you saying...",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u010",
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "sourceRecordId": "tirumbippaar-s076-d008",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "What am I to say, amma? What your younger brother has done has ruined the livelihood of hundreds of workers!...",
        "notes": [
          "The source uses a colloquial dirt/food image (`வயத்ல மண்ணைப் போட்டுவிட்டான்`) for destroying the workers' livelihood; the English preserves the supported sense without normalizing the Tamil record."
        ]
      },
      {
        "id": "tirumbippaar-en-s076-u011",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s076-d009",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "But they released everyone, didn't they?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u012",
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "sourceRecordId": "tirumbippaar-s076-d010",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "The court released us. But the mill owner dismissed all the important people in the agitation from their jobs, including me. Hundreds of families are suffering. Who brought this injustice upon us, amma?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u013",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s076-d011",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          }
        ],
        "text": "Wait. Don't be agitated....",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u014",
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "sourceRecordId": "tirumbippaar-s076-d012",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 91,
            "printedPage": 83
          },
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "What else can I do but be agitated? For his own private affair, the sinner made us stage a revolution and ruined the livelihood of all these poor people. We are all 'shade cattle'—we don't know how to work in forests or fields. What other work do we know? We can beg; that's all.... Hmm, where is your younger brother, amma?",
        "notes": [
          "This source utterance genuinely crosses PDF 91→92. The printed expression `நிழல் மாடு` is unusual; it is retained literally as 'shade cattle' rather than silently normalized."
        ]
      },
      {
        "id": "tirumbippaar-en-s076-u015",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s076-d013",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "He isn't at home.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u016",
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "sourceRecordId": "tirumbippaar-s076-d014",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "Hmm... lawless fellow. Unjust fellow.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u017",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s076-d015",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "Ayya, I myself will go and see the mill owner and ask him to give all of you your jobs back. Please go now.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u018",
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "sourceRecordId": "tirumbippaar-s076-d016",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "If only that fellow falls into my sight...",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s076-u019",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 92,
            "printedPage": 84
          }
        ],
        "text": "(He leaves.)",
        "notes": []
      }
    ]
  }
}
