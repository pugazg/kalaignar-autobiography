  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "(போகிறாள்)"
      },
      {
        "kind": "stage-direction",
        "text": "[புண்யகோடி வீடு"
      },
      {
        "kind": "stage-direction",
        "text": "[புண்யகோடி ஸ்ட்ரைக் நோட்டீஸ்களை பையனிடம் கொடுத்து]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : ராத்ரியோட ராத்ரியா ஊர்முழுக்க ஓட்டணும்! ஒரு சுவரு பாக்கி இருக்கக்கூடாது ! தெரியுமா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பையன்",
        "text": "பையன் : சரிங்க!..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : ஆமாம் போ !"
      },
      {
        "kind": "stage-direction",
        "text": "(பையன் போகிறான் - பாண்டியன் உள்ளே நுழைகிறான் - பாண்டியனின் சோகமுகத்தைப் பார்த்து புண்யகோடி அருகே வந்து)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : ஏம்ப்பா தம்பீ. ஏன் வருத்தமாயிருக்கே!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : ஒண்ணுமில்லப்பா !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : நேத்தியெல்லாம் சந்தோஷமாயிருந்தே! மறுபடியும் என்னா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : ஒரு கவலையுமில்லை."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : ம்... பாண்டியா! உன்கிட்டே ஒரு விஷயம் சொல்லணும்னு இருந்தேனே!.. உம் ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : (சிறிது திகைத்து) என்னப்பா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : அது... அது..."
      },
      {
        "kind": "stage-direction",
        "text": "(ஒரு பெண்ணின் போட்டோவைக் காட்டி)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : இதபாரு !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: (படத்தைப் பார்த்து) அப்பா ! எனக்கு கல்யாணமே வேண்டாமப்பா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : உனக்கு வேண்டாம் சரி... இந்தப் பெண்ணு"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : யாராயிருந்தாலும் சரி தேவையில்லை."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : நீ என்னப்பா அவசரக்காரனாயிருக்கே ! அந்தப் பெண்ணு துடியா துடிக்குது!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : துடிக்கட்டும்! அதற்காக !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : பெண்ணுக்கு இஷ்டம் இருக்குன்னு சொல்றேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : ஐயோ இது என்னா வம்பு !..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : வம்பு ஒண்ணும் இல்லடா ... வயசானவன் கல்யாணம் பண்ணிக்கக்கூடாதுன்னு ஊர்ல கத்துவாங்களே ... அதுக்குத்தான் இவ்வளவும் சொல்றேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : எனக்கு இப்பவும் கல்யாணம் வேண்டாம்! வயசான பிறகும் கல்யாணம் வேண்டாம்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : அட உனக்கு இல்லடா உனக்கு இல்ல! அது கெட்டுது போ! என்னைப்பத்தி சொல்றேன் நான் !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : அப்பா ! திருமணம் உங்களுக்கா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : ஏன் ஆச்சரியப்படுறே ! இது என்னா உலகத்திலே எட்டாவது அதிசயமா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : எப்போதப்பா உங்களுக்கு இந்த ஆசை வந்தது !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : ஆமாண்டா! நல்ல கேள்விடா ! எப்ப ஆசை வந்ததாம்? நான் வருஷம்,மாதம்,தேதி குறிச்சா வைத்திருக்கேன். ஆசைக்கு ஜாதகம் கேக்கிறான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : ஆசைக்கு ஜாதகம் இல்லாவிட்டாலும், அறுபது வயதை நீங்கள் கடந்துவிட்டீர்கள் என்பதற்கு ஜாதகம் இருக்கிறதப்பா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : அதிகப்பிரசங்கி!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : அப்பா ! ஒரு இளம் பெண்ணின் வாழ்வைக் கெடுக்காதீர்கள்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : முட்டாள்! இளம் பெண்ணுக்கு வாழ்வை கொடுக்கப் போகிறேன்! விஷயம் புரியாமல் உளறாதே! இந்தப் பெண்ணை யாரும் கல்யாணம் பண்ணிக்கமாட்டேங்கிறான். இது ஒரு ஊமை!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : பேசத் தெரிந்த பெண்களையே பேசாமடந்தையாக்கிவிடும் பைத்தியக்கார சமூகம், ஊமைகளையா உயிரோடு விடப்போகிறது."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : இப்ப என்னடா சொல்றே !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : உங்கள் முடிவை மாற்றிக்கொள்ள வேண்டுகிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : முடியாது! உன் முடிவைத்தான் மாற்றிக்கொள்ள வேண்டும். உனக்கு முன்னாடி பிறந்தவன் நான்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : யார் மறுக்கிறார்கள் ! பேரன் பேத்தியை கொஞ்சவேண்டிய வயது !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : உன்னைப் பெத்து வளர்த்து பாதுகாத்து மனுஷனாக்கி விட்டதுக்கு, இப்படி எதிர்த்துத்தாண்டா பேசணும்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : அதற்காக ஆயிரம் வணக்கம் செலுத்துகிறேன். ஆனால் மகன் கல்யாணத்தில், மாலை எடுத்துத் தரவேண்டிய பருவத்தில், மாப்பிள்ளையாக மாறுகிறேன் என்கிறீர்களே ; அதை என்னால் அனுமதிக்கவே முடியாது!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : சீ ! நீ என்னடா அனுமதிக்கிறது. என் இஷ்டம் நான் செய்கிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : வேண்டாமப்பா இந்த விபரீத முடிவு!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : சீ ! என்கிட்ட பேசாதே !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : உங்கள் கல்யாணத்தை ?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : நடத்தத்தான் போறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : என்னை வெறுத்துவிட்டா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : உன்னை விரட்டிவிட்டு."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : நீங்கள் விரட்டவேண்டாம். நானே போகிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : போடா ! என் முகத்திலேயே முழிக்காதே! போடா போ!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : போகிறேன். உங்கள் போதை விரைவில் தெளியட்டும். ( போகிறான்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : போடா போ ! போதை தெளியட்டுமாமில்ல. இங்க என்ன குடிச்சிபிட்டா உட்கார்ந்திருக்காங்க."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
