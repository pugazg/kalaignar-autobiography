  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[மில் முதலாளி ரூம்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : (பரந்தாமனிடம்) உஷாவின் இஷ்டத்துக்கு விரோதமா திருமணம் செய்ய மாட்டேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : பெண்புத்தி பின்புத்தி என்பார்கள். இந்த ஒரு விஷயத்தில் பெற்றோர்கள் அபிப்ராயத்திற்குத்தான் பெண்கள் நடக்க வேண்டும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : பெற்றோர்கள் இஷ்டமே வேறு மாப்பிள்ளைக்கு அவளைக் கொடுக்க வேண்டும் என்று தானே....."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : அப்படியானால் முடியாது. இல்லையா? உம்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: இது என்னய்யா கேள்வி! நல்லாயிருக்கு ....."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : கடைசியாகச் சொல்கிறேன், உஷாவை எனக்குக் கொடுத்தால் சரி ; இல்லாவிட்டால் பெரியதொரு புரட்சியை சமாளிக்க நேரிடும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: என்னய்யா பூச்சி காட்ற..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : இந்தத் தடவை பணத்தைக் கொடுத்து ஏமாற்ற முடியாது பரந்தாமனை !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: பெண்ணைக் கொடுத்து ஏமாறச் சொல்றியா? முடியாது ! எது வேண்டுமானால் செய்துக்கொள் போ !"
      },
      {
        "kind": "stage-direction",
        "text": "(பரந்தாமன் கோபமாக வெளியேறுகிறான்)"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
