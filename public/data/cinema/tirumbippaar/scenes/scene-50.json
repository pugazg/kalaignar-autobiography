  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[குமுதா பாண்டியன் இருக்க குண்டுமணி வருதல் ]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : குண்டுமணி எல்லாம் பிரின்ட் ஆயிட்டுதா..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி: ஆயிட்டுதுங்க. இதோ மூணு காப்பி எடுத்தாந்திருக்கேன். (கொடுக்க)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: இந்தப் புஸ்தகத்தைப் பார்த்தா பரந்தாமனுக்கு ஆத்திரம் வரும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : ஆத்திரம் வருவதற்கு இதை எழுதவில்லை. பரந்தாமன் போன்ற போலித் தலைவர்கள் அறிவு பெறுவதற்காக. அப்பாவி மக்களை ஏமாற்றுவதை நிறுத்துவதற்காக. குமுதா! இனியும் இந்த பூமியில் ஏமாளிகளும் இருக்கக் கூடாது ! இளிச்சவாயர்களும் இருக்கக்கூடாது."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி : இளிச்சவாயர் என்றால் எப்ப பாத்தாலும் சிரிச்சிக்கிட்டே இருக்காங்களே அவங்களாங்க? (குமுதா சிரிப்பு )"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : இளிச்சவாயர் என்றால் அவர்களல்ல. புரட்டுக்காரர்களின் புன்சிரிப்பிலே புத்தியை பறிகொடுத்து, எந்த இழிவு வந்தாலும் எமக்கு என்னவென்று கவலைப்படாமல், ஏன், எப்படி என்று கேட்க தைரியமில்லாமல் வாயை இறுக மூடிக்கொண்டு கிடக்கிறார்களே அவர்கள் தான் இளிச்சவாயர்கள்!"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
