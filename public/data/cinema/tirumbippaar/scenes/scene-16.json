            "pdfPage": 24,
            "printedPage": 16
          }
        ],
        "text": "(Paranthaman abruptly snatches the invitation, crumples it and throws it away.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s016-u004",
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "sourceRecordId": "tirumbippaar-s016-d002",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 24,
            "printedPage": 16
          }
        ],
        "text": "That fellow Pandiyan keeps interfering in our affairs. The other day he staged a play and mocked our doctrine. And today, the woman we were supposed to marry....",
        "notes": [
          "Garudan's colloquial first-person plural is retained because Paranthaman immediately interrupts and forces him to correct it in the next line."
        ]
      },
