  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[கருடன் திருமணப் பத்திரிகை படிக்கிறான்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : சிங்க நல்லூர் சிவசக்தி மில்ஸ் மேஸ்திரி புண்யகோடியின் மகன் எழுத்தாளர் பாண்டியனுக்கும், கோவை மெர்ச்சண்ட் குணரத்னம் திருச் செல்வி பாமாவுக்கும் திருமண விழா மணமகள் இல்லத்தில் சிறப்பாக நடைபெறும். தங்கள் சுற்றமும்....."
      },
      {
        "kind": "stage-direction",
        "text": "(பரந்தாமான் பத்திரிகையை வேகமாகப் பிடுங்கி கசக்கி எறிதல் )"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : அந்தப் பயல் பாண்டியன் நம்ப விஷயத்திலே குறுக்கிட்டு கொண்டேயிருக்கிறான். அன்னைக்கு என்னடான்னா நாடகம் நடத்தி நம்ம கொள்கையை கிண்டல் பண்றான். இன்னைக்கு என்னடான்னா நம்ப கல்யாணம் பண்ணிக்க வேண்டிய பெண்ணை .."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: ஏய் ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : இல்லை. நீ கல்யாணம் பண்ணிக்க வேண்டிய பெண்ணை ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : யார் விட்டார்கள்."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
