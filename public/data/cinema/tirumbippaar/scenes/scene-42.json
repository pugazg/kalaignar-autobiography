        ],
        "text": "(Pandiyan is rapidly writing page after page. Kumudha comes near eagerly and watches.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s042-u002",
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "sourceRecordId": "tirumbippaar-s042-d001",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 57,
            "printedPage": 49
          }
        ],
        "text": "Why have you suddenly started writing?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s042-u003",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s042-d002",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 57,
            "printedPage": 49
          }
        ],
        "text": "I found a good situation; I'm writing a song.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s042-u004",
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "sourceRecordId": "tirumbippaar-s042-d003",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 57,
            "printedPage": 49
          }
        ],
        "text": "For which magazine?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s042-u005",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s042-d004",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 57,
            "printedPage": 49
          }
        ],
        "text": "Which magazine would I write for....",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s042-u006",
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "sourceRecordId": "tirumbippaar-s042-d005",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 57,
            "printedPage": 49
          }
        ],
        "text": "Well then, let's hear the song.",
