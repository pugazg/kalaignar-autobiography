  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "(பூமாலை வீடு - மாடி அறை"
      },
      {
        "kind": "stage-direction",
        "text": "[பாண்டியன் ஏதோ மளமளவென்று எழுதி எழுதித் தள்ளுகிறான். குமுதா அருகே ஆவலுடன் சென்று கவனிக்கிறாள்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: என்ன திடீரென்று எழுத ஆரம்பித்துவிட்டீர்கள்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : நல்ல சிச்சுவேஷன் கிடைத்தது பாட்டு எழுதுகிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: எந்தப் பத்திரிகைக்கு?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : நான் எந்தப் பத்திரிகைக்கு எழுதுவேன்..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: எங்கே பாட்டைக் கேட்கலாம்."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
