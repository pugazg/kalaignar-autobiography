          }
        ],
        "text": "(Kumudha starts and rises.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s061-u004",
        "kind": "dialogue",
        "speakerLabel": "மேனேஜர்",
        "sourceRecordId": "tirumbippaar-s061-d002",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 79,
            "printedPage": 71
          }
        ],
        "text": "Pandiyan! Pandiyan! Enough of the work you've done. Get out!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s061-u005",
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
