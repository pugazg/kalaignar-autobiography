  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[டைப்ரைட்டிங் ஆபீஸ்"
      },
      {
        "kind": "stage-direction",
        "text": "[அங்கே பல கிளர்க்குகள். குமுதாவும் டைப் செய்து கொண்டிருக்கிறாள். எல்லா மேஜையிடமும் கவனித்து வந்த மேனேஜர் குமுதாவுக்கு பின்புறம்"
      },
      {
        "kind": "prose",
        "text": "வந்து நிற்கிறார்.குமுதா பாண்டியன் பாண்டியன் என்று அதே வார்த்தையை டைப் செய்து கொண்டிருக்கிறாள்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "மேனேஜர்",
        "text": "மேனேஜர்: ரொம்ப ஒழுங்காயிருக்கு டைப் பண்ற லக்ஷணம்!"
      },
      {
        "kind": "stage-direction",
        "text": "(குமுதா திடுக்கிட்டு எழுதல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "மேனேஜர்",
        "text": "மேனேஜர்: பாண்டியன்! பாண்டியன்! போதும் நீ செஞ்ச வேலை. வெளியே போ!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: சார் தயவு செய்து ......."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "மேனேஜர்",
        "text": "மேனேஜர்: ஊஹும். போன்னா போ !"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
