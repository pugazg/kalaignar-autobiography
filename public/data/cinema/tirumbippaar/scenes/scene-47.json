  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "(மேஜையைத் திறந்து ரிவால்வாரை எடுக்கிறான்)"
      },
      {
        "kind": "stage-direction",
        "text": "[பூமாலை வீடு. மாடி - இரவு"
      },
      {
        "kind": "stage-direction",
        "text": "[பாண்டியன் குமுதா இருவரும் அயர்ந்து தூங்கிக் கொண்டிருக்கிறார்கள். பரந்தாமன் வந்து சுட்டுவிட்டு ஓடிப்போகிறான். ஆனால் அவன் சுட்டது அங்குள்ள பெரிய கண்ணாடியை. பாண்டியன் குமுதா இருவரும் எழுந்து கட்டிக்கொள்கின்றனர் பயத்தால்.]"
      },
      {
        "kind": "stage-direction",
        "text": "[பரந்தாமன் மாடிப்படிகளில் இறங்கி கீழே ஓடுகிறான். சப்தம் கேட்டு,'குமுதா,குமுதா' எனக் கதறி வரும் பூமாலை மாடிப்படியில் பரந்தாமனை சந்திக்கிறாள்.]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: பரந்தாமன்! அடப்பாவி ! என்ன செய்தாய்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : விடு. பரந்தாமனுக்கு இந்த உலகத்தில் பகைவர்களும் இருக்கக்கூடாது, பயன்படாதவர்களும் இருக்கக்கூடாது!"
      },
      {
        "kind": "stage-direction",
        "text": "(சொல்லிவிட்டு ஆத்திரமுடன் போய்விடுகிறான்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: குமுதா! குமுதா!"
      },
      {
        "kind": "stage-direction",
        "text": "(என்று மேலே ஓடுகிறாள்)"
      },
      {
        "kind": "stage-direction",
        "text": "[குமுதா அறை]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : (அலறல்) குமுதா..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: சின்னம்மா... (தழுவுதல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: என்னைக்கொல்ல முயற்சித்திருக்கிறார்கள் யாரோ."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: வேறு யார்,எல்லாம் நம் வீட்டு விரோதிதான், சின்னம்மா! இந்த வீட்டைவிட்டு நாங்கள் வெளியேற வேண்டும். அல்லது உன் தம்பி வெளியேற வேண்டும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : அவனை வெளியேறச் சொல்ல உனக்கும் எனக்கும் என்ன உரிமை இருக்கிறது."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: என் கணவனை கொலை செய்யச் சொல்லத்தான் உனக்கு உரிமை இருக்கிறதாக்கும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : குமுதா! என்ன இது !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : பேசட்டும் அவளைப் பேச விடுங்கள். அவள் தானே பாக்கி ! அவளும் பேசிவிட்டால் பிறகு எனக்கென்ன குறையிருக்கிறது."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: பாண்டியன்! நான் சொல்வதை தயவுசெய்து கேளுங்கள். நீங்களும் குமுதாவும் இந்த ஊரைவிட்டே கொஞ்சநாள்....."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : சாவுக்கு பயந்தா, ஊஹும்..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: என் குமுதாவிற்காக. அவள் கூந்தலிலே குலுங்கும் மலர்க்காடு அழிந்துவிடாமல் இருப்பதற்காக, இந்த ஒரே ஒரு வரத்தைக் கொடுங்கள் பாண்டியன். என் குமுதா துன்பத்தைத் தொட்டும் பாராதவள். எனக்குத் தெரியும், அவளைத் துண்டு துண்டாக வெட்டிப் போட்டாலும், தொடர்ச்சி கெடாமல் ஒட்டிவிடக் கூடிய மாமருந்து நீங்கள். அந்த மருந்தை, குமுதாவின் இன்ப விருந்தை நான் அழியவிட மாட்டேன். தயவு செய்யுங்கள். நான் உங்களுக்காக தியாகம் செய்தேனே காதல். (குமுதா action) அந்த தியாகத்தின் பெயரால், அந்தக் காதலின் பெயரால் கேட்கிறேன். கெஞ்சுகிறேன், சம்மதியுங்கள்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: சின்னம்மா... (ஓடிவரல்)."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: பாருங்கள் பாண்டியன் என் குமுதாவை, அவள் வாழ்வு வளைந்து விடாமல் காப்பாற்றுங்கள். இருவரும் சென்னைக்குச் சென்று விடுங்கள், உங்கள் பகைவனின் ஆத்திரம் தீர்ந்த பிறகு திரும்பலாம்...."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : சரி, உங்களிஷ்டப்படியே செய்கிறோம் ....."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
