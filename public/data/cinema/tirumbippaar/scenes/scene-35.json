  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "(தோட்டம்- மாலை"
      },
      {
        "kind": "stage-direction",
        "text": "[இயற்கையை ரசித்துக் கொண்டிருக்கும் பாண்டியனிடம் பூமாலை நெருங்கி]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : சிந்தனைக்கு இடையூறு ஒன்றும் இல்லையே..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : இல்லை, இல்லை...."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: எதிலே பறிகொடுத்திருக்கிறீர்கள் மனதை ! வானத்தின் அழகிலா - மேகத்தின் அசைவிலா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : மோனத்திருக்கும் முதிர் சோலையில், கானத்தால் களிப்பூட்டும்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : வானம்பாடியின் வரவை எதிர்ப்பார்த்து ஏக்கமா? பாண்டியன்! சிரிக்கும் முல்லையும், சிங்காரக் கொல்லையும் உங்கள் சிந்தைக்கு விருந்தளிக்கப் போதவில்லை என்பதை உணர்ந்துதான் வானம்பாடி பறந்து வந்திருக்கிறது !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: எங்கே?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: தெரியவில்லை.விழியாலும் காணலாம். ஆனால் முதலில் நெஞ்சத்தால்தான் காண முயலவேண்டும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: (சந்தேகத்தோடு) பூமாலை ......."
      },
      {
        "kind": "stage-direction",
        "text": "(சொல்லிக் கொண்டிருக்கும்போது அக்கா என்ற குரல் கேட்டு திடுக்கிட்டுத் திரும்புகிறாள். பரந்தாமன் வருகிறான்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : யார் இவன்?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: பரந்தாமா, இவர்தான் .."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : சொல்லவேண்டாம் தெரிகிறது.இந்த அயோக்யனை வீட்டுக்குள்ளே யார் அனுமதித்தது?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : (கோபமாக) பரந்தாமா.."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : அதட்டாதே ! நீ செய்ததும் ஒரு நல்ல காரியம்தான் ! இவனை நான் பலநாளாகத் தேடிக்கொண்டிருக்கிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: எதற்கு என்னைத் தேடுகிறாய்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : ஆ! பரிசு கொடுக்க. இந்தா பதிலுக்குப் பதில் வாங்கிக்கொள்!"
      },
      {
        "kind": "stage-direction",
        "text": "(அறைகிறான்- அங்கு வந்த குமுதா பரந்தாமன் கன்னத்தில் அறைகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : ஆ ...என்ன !...குமுதா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: முட்டாள் !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: (குமுதாவை அறைந்து) சீ ! வாயை மூடு."
      },
      {
        "kind": "stage-direction",
        "text": "(பல அறைகள் கொடுத்துவிடுகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: சின்னம்மா ! சின்னம்மா!"
      },
      {
        "kind": "stage-direction",
        "text": "(உள்ளே ஓடிப்போய் விம்மி விம்மி அழுகிறாள்- பரந்தாமன் ஆத்திரத்தோடு வெளியே போகிறான். பாண்டியன் திகைத்து நின்று மெதுவாக நகருகிறான்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: என் வாழ்க்கை ஒரு போட்டி மேடை!..."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s035-u001",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "(Poomalai approaches Pandiyan, who is enjoying nature.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u002",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s035-d001",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "I hope I'm not disturbing your thoughts....",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u003",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s035-d002",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "No, no....",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u004",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s035-d003",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "To what have you lost your heart? To the beauty of the sky—or the movement of the clouds?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u005",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s035-d004",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "In the mature grove that dwells in silence, delighting with song....",
        "notes": [
          "The source line is syntactically incomplete and is preserved as an unfinished poetic utterance."
        ]
      },
      {
        "id": "tirumbippaar-en-s035-u006",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s035-d005",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "Are you yearning for the skylark's arrival? Pandiyan! Realising that the smiling jasmine and charming grove are not enough to feast your thoughts, the skylark itself has flown here!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u007",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s035-d006",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "Where?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u008",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s035-d007",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "It isn't visible. It can be seen with the eyes too. But first you must try to see it with the heart.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u009",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s035-d008",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "(Suspiciously) Poomalai......",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u010",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "(As he speaks, she hears a voice call ‘Akka!’ and turns with a start. Paranthaman enters.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u011",
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "sourceRecordId": "tirumbippaar-s035-d009",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "Who is he?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u012",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s035-d010",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "Paranthama, this is....",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u013",
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "sourceRecordId": "tirumbippaar-s035-d011",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "Don't tell me; I know. Who let this scoundrel into the house?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u014",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s035-d012",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "(Angrily) Paranthama....",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u015",
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "sourceRecordId": "tirumbippaar-s035-d013",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 43,
            "printedPage": 35
          }
        ],
        "text": "Don't snap at me! What you've done is actually a good thing! I've been searching for him for many days.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u016",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s035-d014",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 44,
            "printedPage": 36
          }
        ],
        "text": "Why are you looking for me?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u017",
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "sourceRecordId": "tirumbippaar-s035-d015",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 44,
            "printedPage": 36
          }
        ],
        "text": "Ah! To give you a gift. Here—take this, one in return for the other!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u018",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 44,
            "printedPage": 36
          }
        ],
        "text": "(He slaps Pandiyan. Kumudha, who has arrived there, slaps Paranthaman across the cheek.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u019",
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "sourceRecordId": "tirumbippaar-s035-d016",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 44,
            "printedPage": 36
          }
        ],
        "text": "Ah...what!...Kumudha!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u020",
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "sourceRecordId": "tirumbippaar-s035-d017",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 44,
            "printedPage": 36
          }
        ],
        "text": "Fool!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u021",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s035-d018",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 44,
            "printedPage": 36
          }
        ],
        "text": "(Slapping Kumudha) Tch! Shut your mouth.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u022",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 44,
            "printedPage": 36
          }
        ],
        "text": "(She slaps her several times.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u023",
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "sourceRecordId": "tirumbippaar-s035-d019",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 44,
            "printedPage": 36
          }
        ],
        "text": "Chinnamma! Chinnamma!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u024",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 44,
            "printedPage": 36
          }
        ],
        "text": "(She runs inside sobbing uncontrollably. Paranthaman leaves in fury. Pandiyan stands stunned, then slowly moves away.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s035-u025",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s035-d020",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 44,
            "printedPage": 36
          }
        ],
        "text": "My life is an arena of contests!....",
        "notes": []
      }
    ]
  }
}
