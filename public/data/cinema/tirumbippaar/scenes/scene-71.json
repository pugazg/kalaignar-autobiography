  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[ஹோட்டல்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : எல்லாம் அரேஞ்ச் பண்ணிட்டேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: ஆள் எப்படி அழகிதானா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன்: முப்பத்தி மூணு லட்சணம் பொருந்தியவள்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: என்னப்பா ஒரு லட்சணம் புதுசா சொல்றே !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : அவ லட்சணத்தெ நீ நேரா பாத்தா தெரியும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : ஆ !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன்: தாஸியாகப் பொறந்தாலும், நீ வர்ணிப்பியே ; அது மாதிரி தங்கக் கொடி பரந்தாமா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : கருடா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன்: அவளெப் பாத்தோன்ன எனக்கு ஒரு ஐடியா தோணுச்சி !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : என்ன?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : நம்ப 'வாழு' புஸ்தகத்தின் இரண்டாம் பதிப்புக்கு அவளை அட்டைப் படமா போடலாம்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : ஏ சும்மாயிருடா பிஸ்னஸ்!"
      },
      {
        "kind": "stage-direction",
        "text": "(பரந்தாமன் தாசி வீட்டுக்குப் புறப்படுகிறான்)"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s071-u001",
