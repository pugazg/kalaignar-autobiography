  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[கருடன் பதிப்பகம்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: (கருடனிடம்) கூட்டத்தில் அவ்வளவு பேசினான். கேட்டுக்கொண்டு வந்தாய்...ம்..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன் : நான் என்னப்பா செய்றது. தனி மனுஷன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன் : படாடோபம்,பத்திரிகை விளம்பரம், பரந்தாமனுக்கு ஜே...நேரிடையாகவே தாக்கியிருக்கிறான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன்: தாக்கினாலும் பரவாயில்லை. அந்த ஐயாயிரம் விஷயத்தையும் சொல்லிவிட்டான்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: பாண்டியன்! என் வீட்டுக்குள்ளேயே எதிரி! உயிரோடு உலவக்கூடாது அவன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "கருடன்",
        "text": "கருடன்: பிணமா உலவினால்கூட உன்பெருமைக்கு ஆபத்துதான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
        "text": "பரந்தாமன்: முடிவு கட்டுகிறேன். இன்றைக்கே முடிவு கட்டுகிறேன்."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s046-u001",
