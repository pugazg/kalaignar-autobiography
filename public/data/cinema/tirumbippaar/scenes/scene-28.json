          {
            "pdfPage": 33,
            "printedPage": 25
          }
        ],
        "text": "(Taking the camera) Hmm...steady please....",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s028-u009",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 33,
            "printedPage": 25
          }
        ],
        "text": "(Kumudha stands posing like Nataraja.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s028-u010",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s028-d007",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 33,
            "printedPage": 25
          }
        ],
        "text": "What's this!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s028-u012",
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "sourceRecordId": "tirumbippaar-s028-d008",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 33,
            "printedPage": 25
          }
        ],
        "text": "Chinnamma!",
        "notes": []
      },
      {
