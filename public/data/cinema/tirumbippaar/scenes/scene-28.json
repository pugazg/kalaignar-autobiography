        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s028-d004",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 33,
            "printedPage": 25
          }
        ],
        "text": "I mean I'll take your picture.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s028-u007",
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "sourceRecordId": "tirumbippaar-s028-d005",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 33,
            "printedPage": 25
          }
        ],
        "text": "That's what I thought! (Shyly)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s028-u008",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
