  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[பாண்டியனை நிற்கவைத்து குமுதா போட்டோ எடுக்கிறாள்]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: நில்லுங்க சரியா—ஆங்—கொஞ்சம் சிரிங்க... கொஞ்சம் கொஞ்சம்... ஸ்டடி பிளீஸ், ரைட்... தேங்க்ஸ்..."
      },
      {
        "kind": "stage-direction",
        "text": "(போட்டோ எடுத்துவிடுகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: இங்கே கொடு. நான் உன்னைப் பிடிக்கிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: என்னாது .."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : படம் பிடிக்கிறேங்கிறேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: அதானே! (வெட்கமுடன்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : (கேமராவை வாங்கி) ம்... ஸ்டடி பிளீஸ்...."
      },
      {
        "kind": "stage-direction",
        "text": "(குமுதா நடராஜர் போல அபிநயம் பிடித்து நிற்கிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : இது என்னா இது !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: சின்னம்மா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : ஏங்கண்ணு!"
      },
      {
        "kind": "stage-direction",
        "text": "(அப்போது பூமாலை வருகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: நாங்க தனித்தனியா போட்டோ எடுத்துட்டோம். ரெண்டுபேரும் நிக்கிறோம் நீ எடு!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : ஊஹும் குமுதா! எனக்கு எடுக்கத் தெரியிலே நீயே எடு!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: போ சின்னம்மா! (சிணுங்கியபடி கேமராவை வாங்கிக்கொண்டு) சரி சின்னம்மா ! நீங்க ரெண்டுபேரும் நில்லுங்க நான் எடுக்கிறேன். (களங்கமில்லாமல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : நானா."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா : போய் நில்லு சின்னம்மா!"
      },
      {
        "kind": "stage-direction",
        "text": "(பூமாலை பாண்டியன் அருகே போய் நிற்கிறாள். குமுதா போட்டோ எடுக்கப் போகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: ஸ்டடி பிளீஸ்..."
      },
      {
        "kind": "stage-direction",
        "text": "(குண்டுமணியின் சந்தோஷ கூச்சல்—குமுதா நடுங்கியபடி கேமராவைக் கீழே போட்டுவிடுகிறாள்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : ஏ...என்ன... என்ன?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி : (பேப்பரைக் காட்டி) குமுதாம்மா பாஸ் ! பாஸ் ! பாஸ்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: பாஸா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : பாஸ் ! குமுதா நீ கெட்டிக்காரி!"
      },
      {
        "kind": "stage-direction",
        "text": "(தழுவிக்கொள்ளுதல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : குமுதா கங்ராஜுலேஷன்ஸ்..."
      },
      {
        "kind": "stage-direction",
        "text": "(இருவரும் கை கொடுக்க முயலல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி : (பத்திரிகையைக் காட்டி) இந்த பாருங்க நம்பரு. பதினாறு இருபத்தினாலு.."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: இருபத்தினாலு... அட என் வயசுகூட இருபத்தினாலுதான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா: என் வயசு பதினாறுதான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி : பொருத்தமான நம்பருதான்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : (அதட்டல்) ஏய்....சும்மா இரு ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி : இல்லிங்க. குமுதாம்மா எண்ணும் பதினாறு வயசா மார்க்கண்டி மாதிரி இருக்கணுங்கிறேன்."
      },
      {
        "kind": "stage-direction",
        "text": "(எல்லோரும் சிரிப்பு)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : அப்ப ஊருக்குப் புறப்படலாமா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குமுதா",
        "text": "குமுதா : அவர்..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி : அவரைப்பத்தி நீங்க கவலைப்படவேண்டீதில்லைம்மா. இனிமே நம்ப விரட்டினாகூட அவர் நம்பளைவிட்டுப் போமாட்டாரு !"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
