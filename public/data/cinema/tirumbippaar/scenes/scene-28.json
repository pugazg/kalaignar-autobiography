        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 33,
            "printedPage": 25
          }
        ],
        "text": "(Poomalai goes and stands beside Pandiyan. Kumudha prepares to take the photograph.)",
        "notes": []
      },
      {
