  "tamil": {
    "blocks": [
      {
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "text": "உஷா: பரந்தாமன்தான் வழிப்பறிசெய்து நெக்லஸை திருடினான் என்பது பூமாலை பரந்தாமன் சச்சரவின்போது எனக்கு நன்றாக புரிந்து விட்டதப்பா."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி : பாபம் நிரபராதியான பாண்டியனை வீணே கஷ்டப் படுத்தி விட்டேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "text": "உஷா : அந்தப் பாபத்தை போக்கிக்கொள்ள ஒரே வழிதான் இருக்கிறது."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: என்ன உஷா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "text": "உஷா: பாண்டியனின் கொள்கைப்படி பாட்டாளிகளுக்கு சமத்துவம் வழங்குங்கள்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: பாண்டியன்!"
      },
      {
        "kind": "stage-direction",
        "text": "(பாண்டியன் பிரவேசம்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : பல்லைக்காட்டி ஏமாற்ற நினைக்காதீர் மறுபடியும்! இம்முறை இரண்டிலொன்று. அநியாயமாக நீக்கப்பட்ட தொழிலாளருக்கு வேலைதரவேண்டும் உடனடியாக."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: பாண்டியன்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: யாரோ ஒருவன் செய்த தவறுக்காக இத்தனை குடும்பங்கள் மீது பழிவாங்கிக்கொள்வதுதான் மனிதத் தன்மையா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: நான் அதை உணர்கிறேன் பாண்டியன்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : உணர்ந்தால் போதாது. உடனடியாக பரிகாரம் தேட வேண்டும்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: பாண்டியன்! தொழிலாளிகளை வேலைக்கு சேர்ப்பது மட்டுமல்ல. குற்றமற்ற உனக்கு நான் செய்த கொடுமைக்காக சிவசக்தி மில் நிர்வாகமே உன் கொள்கைப்படியும் உஷாவின் கொள்கைப்படியும் நடக்க அனுமதி தருகிறேன்."
      },
      {
        "kind": "stage-direction",
        "text": "(பாட்டாளிகளைக் காட்டி -இதோ மில்லின் சொந்தக்காரர்கள் ! உன் தோழர்கள்! கைபோட்டுக் கொடுத்து -இதோ மில்லின் நிர்வாகம் !)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : அப்படியா ! வாழ்க உங்கள் புகழ்! வளர்க இந்தப் பண்பு தோழர்களே ! சிவசக்தி மில் இன்று முதல் ஜனசக்தி மில்லாக மாறும் ! சக்திக்கேற்ற உழைப்பு, தேவைக்கேற்ற வசதி. சமத்துவம் கொழிக்கும் - சமதர்மம் திகழும்- சமுதாய மறுமலர்ச்சி உருவாகும்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "தொழிலாளர்கள்",
        "text": "தொழிலாளர்கள்: பாண்டியன் வாழ்க! பாண்டியன் வாழ்க!"
      },
      {
        "kind": "stage-direction",
        "text": "(வேலைக்காரன் ஓடிவந்தபடி)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "வேலைக்காரன்",
        "text": "வேலைக்காரன் : எஜமான் பாத்திங்களா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "text": "முதலாளி: ஆ என்ன !"
      },
      {
        "kind": "stage-direction",
        "text": "(பத்திரிகையை பாண்டியனிடம் கொடுத்தல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: ஆங்!"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s091-u001",
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "sourceRecordId": "tirumbippaar-s091-d001",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 109,
            "printedPage": 101
          }
        ],
        "text": "Appa, during the quarrel between Poomaalai and Paranthaman I understood clearly that it was Paranthaman who committed the highway robbery and stole the necklace.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u002",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s091-d002",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 109,
            "printedPage": 101
          }
        ],
        "text": "Poor innocent Pandiyan suffered for nothing because of me.",
        "notes": [
          "The Tamil source is grammatically irregular at the end of the sentence; the translation follows the supported sense without altering the source record."
        ]
      },
      {
        "id": "tirumbippaar-en-s091-u003",
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "sourceRecordId": "tirumbippaar-s091-d003",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 109,
            "printedPage": 101
          }
        ],
        "text": "There is only one way to atone for that sin.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u004",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s091-d004",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 109,
            "printedPage": 101
          }
        ],
        "text": "What is it, Usha?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u005",
        "kind": "dialogue",
        "speakerLabel": "உஷா",
        "sourceRecordId": "tirumbippaar-s091-d005",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 109,
            "printedPage": 101
          }
        ],
        "text": "Grant equality to the workers according to Pandiyan's principles.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u006",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 109,
            "printedPage": 101
          }
        ],
        "text": "(Pandiyan enters.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u007",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s091-d006",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 109,
            "printedPage": 101
          }
        ],
        "text": "Pandiyan!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u008",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s091-d007",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "Don't try to fool me again by baring your teeth in a smile! This time it is one thing or the other. The workers who were unjustly dismissed must be given their jobs back immediately.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u009",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s091-d008",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "Pandiyan!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u010",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s091-d009",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "Is taking revenge on so many families for one man's mistake what you call humanity?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u011",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s091-d010",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "I understand that, Pandiyan!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u012",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s091-d011",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "Understanding is not enough. A remedy must be made immediately.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u013",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s091-d012",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "Pandiyan! Not only will I take the workers back. As atonement for the cruelty I inflicted on you though you were innocent, I give permission for the very administration of Sivasakthi Mill to be run according to your principles and Usha's principles.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u014",
        "kind": "dialogue",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "(Pointing to the workers.) Here are the owners of the mill! Your comrades! (Handing it over.) Here is the administration of the mill!",
        "notes": [
          "The booklet prints this passage in parentheses without repeating a speaker label; the evident contextual attribution is not inserted into metadata."
        ]
      },
      {
        "id": "tirumbippaar-en-s091-u015",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s091-d013",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "Is that so! Long live your fame! May this quality flourish! Comrades! From today Sivasakthi Mill will become Jana Sakthi Mill! Labour according to ability, facilities according to need. Equality will flourish—social justice will shine—a social renaissance will take shape!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u016",
        "kind": "dialogue",
        "speakerLabel": "தொழிலாளர்கள்",
        "sourceRecordId": "tirumbippaar-s091-d014",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "Long live Pandiyan! Long live Pandiyan!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u017",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "(A servant runs in.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u018",
        "kind": "dialogue",
        "speakerLabel": "வேலைக்காரன்",
        "sourceRecordId": "tirumbippaar-s091-d015",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "Master, have you seen this?",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u019",
        "kind": "dialogue",
        "speakerLabel": "முதலாளி",
        "sourceRecordId": "tirumbippaar-s091-d016",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "Ah! What!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u020",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "(The newspaper is handed to Pandiyan.)",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s091-u021",
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "sourceRecordId": "tirumbippaar-s091-d017",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 110,
            "printedPage": 102
          }
        ],
        "text": "Ah!",
        "notes": []
      }
    ]
  }
}
