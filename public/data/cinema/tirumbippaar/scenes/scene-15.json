  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[புண்யகோடி வீடு - இரவு"
      },
      {
        "kind": "stage-direction",
        "text": "(கதவு தட்டப்படுகிறது. பாண்டியன் திறக்க, புண்யகோடி உள்ளே வருகிறான்.]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : அப்பா எங்கப்பா போயிருந்திங்க."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி: எல்லாம் நல்ல காரியமாகத்தான். உள்ளே வந்து உட்காருகிறான்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: ஏம்ப்பா நாடகத்துக்கு வரவில்லை. நாடகம் ரொம்ப ஜோர்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : கேள்விப்பட்டேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: யாருப்பா சொன்னா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : நம்ம மில்லு தொழிலாளிங்க எல்லாம் வந்திரிந்தாங்கள்ள, அவுங்க சொன்னாங்க!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: மில் தொழிலாளிகள் வர முடிந்தது. மேஸ்திரி வர முடியிலே, இல்லேப்பா !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : கோபிக்காதே! நானும் உன் விஷயமாகத்தான் டவுன் வரையிலும் போயிருந்தேன் ........"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : என்ன விஷயமப்பா !"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : உனக்கு கல்யாணம் நிச்சயம் பண்ணிட்டேன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: இப்ப ஏன் எனக்குக் கல்யாணம். ஏதாவது நிலையா ஒரு வேலை கிடைச்சு .. ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி: இருக்கிற வேலை போதும்! எழுத்தாளன் வேலை நிலையான வேலைதானே.இந்தா பாரு தம்பி ! ரொம்ப நல்ல இடம்... பெண்ணும் நல்ல அழகு ! மறுக்காம கல்யாணம் பண்ணிக்க ......."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: பெண்னை நான் பார்க்க வேண்டாமாப்பா?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : தெரியுமே உன் சேதி எனக்கு ! அதுக்குத்தானே போட்டோவை வாங்கிட்டு வந்திருக்கேன்."
      },
      {
        "kind": "stage-direction",
        "text": "(கோட்டுப் பையைத் தேடி)"
      },
      {
        "kind": "prose",
        "text": "என்னடாது ஒவ்வொரு சலவைக்கு ஒவ்வொரு பாக்கட்டா திங்கிறான் .. (போட்டோவை எடுத்துக் கொடுத்தல்)"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : என்னப்பா சொல்றே"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன் : உங்களிஷ்டம்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : அப்படிச் சொல்லு ராஜா / நாளைக்கே மில் முதலாளி கிட்ட போயி கல்யாணத்துக்குக் கொஞ்சம் பணம் கேக்கிறேன்.(ஆத்திரமாக) அவன் எங்க தரப்போறான். கஞ்சன்."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பாண்டியன்",
        "text": "பாண்டியன்: என்கிட்டேயே பணம் இருக்குப்பா!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "புண்யகோடி",
        "text": "புண்யகோடி : அப்போ சீக்கிரமே கல்யாணத்தை நடத்திடலாம்."
      },
      {
        "kind": "stage-direction",
        "text": "(பாண்டியன் புன்னகை)"
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
  "english": {
    "units": [
      {
        "id": "tirumbippaar-en-s015-u001",
        "kind": "stage-direction",
        "speakerLabel": null,
        "sourceRecordId": null,
