        ]
      },
      {
        "id": "tirumbippaar-en-s087-u005",
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "sourceRecordId": "tirumbippaar-s087-d004",
        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 105,
            "printedPage": 97
          }
        ],
        "text": "Only if I go can I save Kumudha from that destroyer!",
        "notes": []
