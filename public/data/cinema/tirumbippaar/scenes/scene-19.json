  "tamil": {
    "blocks": [
      {
        "kind": "stage-direction",
        "text": "[பூமாலை ஊருக்குப் புறப்பட ஏற்பாடு செய்கிறாள்—அவளிடம் பாடம் கற்கும் ஒரு பெண் வந்து]"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பெண்",
        "text": "பெண் : பட்டணத்துக்கு ஏம்மா போறீங்க..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : குமுதாவுக்கு பரிக்ஷை முடிவு ரெண்டுநாளில் தெரிந்துவிடும். அவளை அழைத்து வருவதற்காகப் போகிறேன்"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி: (வந்தபடி) அம்மா! அம்மா! விஷயம் தெரியுமா! நம்ப சின்ன எஜமானுக்குப் பாத்த பெண்ணு ..."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: இன்னைக்கு கல்யாணம் அதுக்கு என்ன?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி: பெண்ணு நேத்தி ராத்திரி ஓடிட்டுதாம்!"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை: அப்படியா! (யோசனை) ம்... பரந்தாமன் எங்கே ?"
      },
      {
        "kind": "dialogue",
        "speakerLabel": "குண்டுமணி",
        "text": "குண்டுமணி : அவரு...அவரு...ம்...அவருகூட மெட்ராஸ் போகணும்னு கருடன் கிட்ட சொல்லிக்கிட்டு இருந்தாரு."
      },
      {
        "kind": "dialogue",
        "speakerLabel": "பூமாலை",
        "text": "பூமாலை : (சிந்தனை) ம்... சரி புறப்படு. ரயிலுக்கு நேரமாச்சு."
      },
      {
        "kind": "separator",
        "text": "★"
      }
    ]
  },
