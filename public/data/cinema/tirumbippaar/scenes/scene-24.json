            "printedPage": 23
          }
        ],
        "text": "The blue sea—what a beautiful sight!",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s024-u002",
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
