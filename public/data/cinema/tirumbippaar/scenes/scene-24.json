        "sourceOccurrenceId": null,
        "pageProvenance": [
          {
            "pdfPage": 31,
            "printedPage": 23
          }
        ],
        "text": "There is always danger beside beauty.",
        "notes": []
      },
      {
        "id": "tirumbippaar-en-s024-u004",
        "kind": "dialogue",
        "speakerLabel": "பரந்தாமன்",
