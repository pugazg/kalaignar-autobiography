   {
    "id": "manohara-en-s021-u009",
    "kind": "dialogue",
    "speakerLabel": "துறவி",
    "text": "The news I am about to utter is no sugarcane! Hmm... human life is but a straw in the sea, Amma!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-021.json",
     "canonicalScenePath": "works/manohara/scenes/scene-021.md",
     "sourceRecordId": "manohara-s021-d007",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 34,
       "printed_page": 33
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The source's `கரும்பு / துரும்பு` sound-play is represented through the literal sugarcane/straw images even though the Tamil rhyme cannot be reproduced exactly."
     ]
    }
   },
   {
    "id": "manohara-en-s021-u010",
    "kind": "dialogue",
    "speakerLabel": "பத்மா",
    "text": "What, Sami; you speak without any connection.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-021.json",
     "canonicalScenePath": "works/manohara/scenes/scene-021.md",
     "sourceRecordId": "manohara-s021-d008",
