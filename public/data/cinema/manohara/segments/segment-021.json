    "kind": "dialogue",
    "speakerLabel": "துறவி",
    "text": "A renunciant is one without ties, is he not!... How greatly you must have rejoiced on hearing that your son had won...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-021.json",
     "canonicalScenePath": "works/manohara/scenes/scene-021.md",
     "sourceRecordId": "manohara-s021-d009",
