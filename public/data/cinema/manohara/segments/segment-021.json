   },
   {
    "id": "manohara-en-s021-u018",
    "kind": "dialogue",
    "speakerLabel": "பத்மா",
    "text": "Ah... Manohara!...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-021.json",
     "canonicalScenePath": "works/manohara/scenes/scene-021.md",
     "sourceRecordId": "manohara-s021-d016",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
