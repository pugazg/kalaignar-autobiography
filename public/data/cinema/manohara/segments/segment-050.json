    }
   },
   {
    "id": "manohara-en-s050-u009",
    "kind": "dialogue",
    "speakerLabel": "சேனா",
    "text": "In this flood of triumph, do not forget that Manoharan is still alive!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-050.json",
