    }
   },
   {
    "id": "manohara-en-s050-u015",
    "kind": "dialogue",
    "speakerLabel": "விஜயா",
    "text": "Atthai! Where do they say he is?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-050.json",
     "canonicalScenePath": "works/manohara/scenes/scene-050.md",
     "sourceRecordId": "manohara-s050-d012",
