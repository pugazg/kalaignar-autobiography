    }
   },
   {
    "id": "manohara-en-s050-u013",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Manoharan... sent me!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-050.json",
