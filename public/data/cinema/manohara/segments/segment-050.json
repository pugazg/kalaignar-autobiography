    }
   },
   {
    "id": "manohara-en-s050-u020",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Yes! Manoharan's secret arrangement. Here is the signet ring. You can leave without fear and without anyone stopping you. Set out.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-050.json",
     "canonicalScenePath": "works/manohara/scenes/scene-050.md",
     "sourceRecordId": "manohara-s050-d017",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 77,
       "printed_page": 76
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s050-u021",
    "kind": "dialogue",
    "speakerLabel": "பத்",
    "text": "To escape by trickery—no, I cannot. I cannot disobey the Maharaja's order. Tell Manoharan that.",
