    }
   },
   {
    "id": "manohara-en-s050-u017",
    "kind": "dialogue",
    "speakerLabel": "பத்",
    "text": "Who are you, son?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-050.json",
     "canonicalScenePath": "works/manohara/scenes/scene-050.md",
     "sourceRecordId": "manohara-s050-d014",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 77,
       "printed_page": 76
      }
     ]
    },
    "translation": {
