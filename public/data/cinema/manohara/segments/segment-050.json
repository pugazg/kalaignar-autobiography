    }
   },
   {
    "id": "manohara-en-s050-u006",
    "kind": "dialogue",
    "speakerLabel": "உக்",
    "text": "Certainly. But before that, we must proclaim that the country is under our control.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-050.json",
     "canonicalScenePath": "works/manohara/scenes/scene-050.md",
     "sourceRecordId": "manohara-s050-d004",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 77,
       "printed_page": 76
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s050-u007",
    "kind": "dialogue",
    "speakerLabel": "சேனா",
    "text": "Will proclaiming it bring any danger?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-050.json",
     "canonicalScenePath": "works/manohara/scenes/scene-050.md",
     "sourceRecordId": "manohara-s050-d005",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 77,
       "printed_page": 76
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s050-u008",
    "kind": "dialogue",
    "speakerLabel": "உக்",
    "text": "Danger!... From whom? Is there anyone in this world capable of opposing me?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-050.json",
     "canonicalScenePath": "works/manohara/scenes/scene-050.md",
     "sourceRecordId": "manohara-s050-d006",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 77,
       "printed_page": 76
      }
     ]
    },
    "translation": {
