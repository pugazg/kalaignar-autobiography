    }
   },
   {
    "id": "manohara-en-s050-u018",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "I will tell you that later. Now both of you must escape from here.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-050.json",
     "canonicalScenePath": "works/manohara/scenes/scene-050.md",
     "sourceRecordId": "manohara-s050-d015",
