    }
   },
   {
    "id": "manohara-en-s050-u016",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Where else could he be, when he is always in your heart?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-050.json",
     "canonicalScenePath": "works/manohara/scenes/scene-050.md",
     "sourceRecordId": "manohara-s050-d013",
