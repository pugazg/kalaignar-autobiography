    }
   },
   {
    "id": "manohara-en-s050-u005",
    "kind": "dialogue",
    "speakerLabel": "சேனா",
    "text": "Tomorrow is Vasanthan's coronation.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-050.json",
     "canonicalScenePath": "works/manohara/scenes/scene-050.md",
     "sourceRecordId": "manohara-s050-d003",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 77,
       "printed_page": 76
      }
     ]
