       "printed_page": 57
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s037-u010",
    "kind": "dialogue",
    "speakerLabel": "கேசரிவர்மன்",
    "text": "Prince!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d008",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 58,
       "printed_page": 57
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s037-u011",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Who are you... who are you... Satyaseelar! Who is this man?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d009",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 58,
       "printed_page": 57
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s037-u012",
    "kind": "dialogue",
    "speakerLabel": "சத்யசீலர்",
    "text": "I shall tell you the details later... he is the one who saved you.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d010",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 58,
       "printed_page": 57
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s037-u013",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Saving me...... saving Manoharan... the king's wish... Mother's loving command.... fulfil them at once... kill me... kill me... kill me, Rajapriya! My beloved friend... you at least carry out my mother's command.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d011",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 58,
       "printed_page": 57
      }
     ]
    },
    "translation": {
     "mode": "semantic-poetic",
     "notes": [
      "The repeated kill-me cadence and contradictory king/mother commands remain explicit."
     ]
    }
   },
   {
    "id": "manohara-en-s037-u014",
    "kind": "dialogue",
    "speakerLabel": "சத்ய",
    "text": "Wait, Manohara!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d012",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 58,
       "printed_page": 57
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s037-u015",
    "kind": "dialogue",
    "speakerLabel": "ராஜப்",
    "text": "Manohara... because a mother's word must not be broken, will you let the mother who sits in prison die abandoned?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d013",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 58,
       "printed_page": 57
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s037-u016",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Ah! Amma is in prison...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d014",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 58,
       "printed_page": 57
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s037-u017",
    "kind": "dialogue",
    "speakerLabel": "ராஜப்",
    "text": "Not only Amma... Vijaya too...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d015",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 58,
       "printed_page": 57
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s037-u018",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Ah...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d016",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 58,
       "printed_page": 57
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s037-u019",
    "kind": "dialogue",
    "speakerLabel": "ராஜப்",
    "text": "At least now understand...... why you must live.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
