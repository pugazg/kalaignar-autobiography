   {
    "id": "manohara-en-s037-u009",
    "kind": "dialogue",
    "speakerLabel": "மனோகரன்",
    "text": "Impossible, Amma... impossible... (looking around) What is this... I, who was killed, am alive...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d007",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
