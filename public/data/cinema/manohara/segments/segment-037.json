    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s037-u006",
    "kind": "dialogue",
    "speakerLabel": "வ. சே",
    "text": "Disaster has begun to grow, Prabhu! Search the entire city; wherever that destroyer is, seize him and bring him here.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d005",
