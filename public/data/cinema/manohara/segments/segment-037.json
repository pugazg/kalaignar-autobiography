   },
   {
    "id": "manohara-en-s037-u005",
    "kind": "dialogue",
    "speakerLabel": "காவலாளி",
    "text": "Yes... someone loosened the bonds and saved him; we could not even see them with our eyes.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-037.json",
     "canonicalScenePath": "works/manohara/scenes/scene-037.md",
     "sourceRecordId": "manohara-s037-d004",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
