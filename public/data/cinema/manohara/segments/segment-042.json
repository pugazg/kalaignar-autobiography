    }
   },
   {
    "id": "manohara-en-s042-u029",
    "kind": "dialogue",
    "speakerLabel": "உக்",
    "text": "Hmm—separate... separate...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d027",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
