    }
   },
   {
    "id": "manohara-en-s042-u014",
    "kind": "dialogue",
    "speakerLabel": "உக்",
    "text": "May Bhagavan's great grace be attained... King Purushothaman... the world itself is a drama; who knows what will happen tomorrow!......",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d012",
