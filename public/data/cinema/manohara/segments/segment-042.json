    }
   },
   {
    "id": "manohara-en-s042-u028",
    "kind": "dialogue",
    "speakerLabel": "அர",
    "text": "Only until tomorrow morning, Vasanthi!...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d026",
