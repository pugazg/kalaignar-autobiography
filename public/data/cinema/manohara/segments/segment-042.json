    }
   },
   {
    "id": "manohara-en-s042-u026",
    "kind": "dialogue",
    "speakerLabel": "உக்ர",
    "text": "Otherwise, death will occur...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d024",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
