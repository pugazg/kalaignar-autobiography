    "kind": "dialogue",
    "speakerLabel": "அக்ஷ",
    "text": "We shall have to think it over...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
