   },
   {
    "id": "manohara-en-s042-u012",
    "kind": "stage-direction",
    "speakerLabel": null,
    "text": "[Ugrasenan's group of sadhus is welcomed with drums, music and devotional cries...... The king and Vasanthi receive and honour the group with devotion, reverence and respect......]",
