    }
   },
   {
    "id": "manohara-en-s042-u020",
    "kind": "dialogue",
    "speakerLabel": "வசந்",
    "text": "May I have the company of those noble ones who, with singleness of mind, think upon Your sacred flower-feet... Vikata, I've forgotten the lesson, da...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d018",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 68,
       "printed_page": 67
      }
     ]
    },
    "translation": {
     "mode": "semantic-poetic",
     "notes": [
      "The half-remembered devotional recitation is kept elevated before Vasanthan breaks it with his comic admission."
     ]
    }
   },
   {
    "id": "manohara-en-s042-u021",
    "kind": "dialogue",
    "speakerLabel": "வ. சே.",
    "text": "Enough... enough.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d019",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 68,
       "printed_page": 67
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s042-u022",
    "kind": "dialogue",
    "speakerLabel": "உக்ர",
    "text": "Long live! Long live...... Hey, King... I have come at just the right time. A great danger is waiting for you........",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d020",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 68,
       "printed_page": 67
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s042-u023",
    "kind": "dialogue",
    "speakerLabel": "அர",
    "text": "Swami!......",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d021",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 68,
       "printed_page": 67
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s042-u024",
    "kind": "dialogue",
    "speakerLabel": "உக்ர",
    "text": "If you are to escape that danger, you and your queen must remain apart from this very moment until tomorrow morning.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d022",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 68,
       "printed_page": 67
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s042-u025",
    "kind": "dialogue",
    "speakerLabel": "அர",
    "text": "Is that so?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d023",
