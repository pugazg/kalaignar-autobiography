       "pdf_page": 67,
       "printed_page": 66
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s042-u013",
    "kind": "dialogue",
    "speakerLabel": "அரசன்",
    "text": "Welcome...... welcome...... I am blessed.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d011",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
