    }
   },
   {
    "id": "manohara-en-s042-u030",
    "kind": "dialogue",
    "speakerLabel": "வசந்",
    "text": "I remember now: may I not mingle in the company of those who keep one thing within and speak another without.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d028",
