    }
   },
   {
    "id": "manohara-en-s042-u027",
    "kind": "dialogue",
    "speakerLabel": "வச",
    "text": "Be separated from Maharaja?......",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-042.json",
     "canonicalScenePath": "works/manohara/scenes/scene-042.md",
     "sourceRecordId": "manohara-s042-d025",
