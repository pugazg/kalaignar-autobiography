    }
   },
   {
    "id": "manohara-en-s015-u005",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Who are you?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d001",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 28,
       "printed_page": 27
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s015-u006",
    "kind": "dialogue",
    "speakerLabel": "விஜயா",
    "text": "I am neither a ghost given another life in the cremation-ground you created, nor a corpse! I am one among the enemies who escaped your sight—a warrior of the Pandiyan land!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d002",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 28,
       "printed_page": 27
      },
      {
       "pdf_page": 29,
       "printed_page": 28
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "englishPageSegments": [
      {
       "pdf_page": 28,
       "printed_page": 27,
       "english_text": "I am neither a ghost given another life in the cremation-ground you created, nor a corpse! I am one among the enemies who escaped your sight—"
      },
      {
       "pdf_page": 29,
       "printed_page": 28,
       "english_text": "a warrior of the Pandiyan land!"
      }
     ],
     "notes": [
