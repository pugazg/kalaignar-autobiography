      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s015-u019",
    "kind": "dialogue",
    "speakerLabel": "விஜ",
    "text": "Do not talk!... If you are a warrior, speak after you defeat me!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d014",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 29,
       "printed_page": 28
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s015-u020",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "History has no record of warriors defeating spear-eyed women, Princess!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d015",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 29,
       "printed_page": 28
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The `வேல்விழி` spear-eye image is retained."
     ]
    }
   },
   {
    "id": "manohara-en-s015-u021",
    "kind": "dialogue",
    "speakerLabel": "விஜ",
    "text": "No need for mockery... draw your sword.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d016",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 29,
       "printed_page": 28
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s015-u022",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "My sword plays only on the battlefield... it does not bruise fruit!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d017",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 30,
       "printed_page": 29
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The source's fruit image is retained rather than domesticated into a generic chivalric phrase."
     ]
    }
   },
   {
    "id": "manohara-en-s015-u023",
    "kind": "dialogue",
    "speakerLabel": "விஜ",
    "text": "If you have courage—if all that talk about the marks of a warrior was not mere tongue-play—swing your sword... let a good judgement be delivered....",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d018",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 30,
       "printed_page": 29
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s015-u024",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "A good judgement... will not be delivered by the sword-point. From now on it must be obtained in the court of law! Tender creeper born of the Pandiyan, you are now a prisoner—a prisoner under protection! Rajapriya! Take her away!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d019",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 30,
       "printed_page": 29
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The `பைங்கொடி` tender-creeper image is preserved."
     ]
    }
   },
   {
    "id": "manohara-en-s015-u025",
    "kind": "dialogue",
    "speakerLabel": "ராஜப்",
    "text": "There is our flag at the fort gate! A flag announcing that Princess Vijaya is Manoharan's slave!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d020",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 30,
       "printed_page": 29
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s015-u026",
    "kind": "dialogue",
    "speakerLabel": "விஜயா",
    "text": "Do not speak! I lived as a princess—I will not live as a slave. I roamed like a skylark—I will not be caught in the cruel grip of vultures. I floated in the breeze of freedom—I will not be trapped in the cyclone of slavery. The lap of death is far better than the feet of an enemy.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d021",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 30,
       "printed_page": 29
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The skylark/vulture, breeze/cyclone and feet/lap parallel imagery is preserved."
     ]
    }
   }
  ]
 }
