   {
    "id": "manohara-en-s015-u004",
    "kind": "stage-direction",
    "speakerLabel": null,
    "text": "Manoharan wakes, catches Vijaya's hand—",
    "source": {
     "sourcePath": "works/manohara/scenes/scene-015.md",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": null,
