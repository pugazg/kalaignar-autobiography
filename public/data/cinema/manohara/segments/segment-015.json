     ]
    }
   },
   {
    "id": "manohara-en-s015-u007",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "A warrior of the Pandiyan land! Hmm... it seems the first lesson under Muthu Vijayan's rule is military training in lurking and pouncing at midnight, you spineless fellow. Is one of those men left who carry a sword in the hand and cowardice in the heart? Run away... save your life...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d003",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 29,
       "printed_page": 28
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The hand/sword and heart/cowardice antithesis is preserved."
     ]
    }
   },
   {
    "id": "manohara-en-s015-u008",
    "kind": "dialogue",
    "speakerLabel": "ராஜப்பிரியன்",
    "text": "Manohara!... We must not let him go...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d004",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 29,
       "printed_page": 28
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s015-u009",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Let the poor fellow go... I have forgiven him.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d005",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 29,
       "printed_page": 28
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s015-u010",
    "kind": "dialogue",
    "speakerLabel": "விஜ",
    "text": "Ours is not a tradition that begs forgiveness...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d006",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 29,
       "printed_page": 28
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s015-u011",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "A tradition of attacking from hiding... great warrior!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d007",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 29,
       "printed_page": 28
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s015-u012",
    "kind": "dialogue",
    "speakerLabel": "ராஜ",
    "text": "Those who cut off a sleeping man's head are warriors too—in the schools of the Pandiyan land! Get out, you worthless coward!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d008",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 29,
       "printed_page": 28
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s015-u013",
    "kind": "dialogue",
    "speakerLabel": "விஜ",
    "text": "Coward... am I a coward! Look here... I shall take my revenge openly, right now....",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-015.json",
     "canonicalScenePath": "works/manohara/scenes/scene-015.md",
     "sourceRecordId": "manohara-s015-d009",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 29,
       "printed_page": 28
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
