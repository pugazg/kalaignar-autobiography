   {
    "id": "manohara-en-s031-u002",
    "kind": "dialogue",
    "speakerLabel": "மனோகரன்",
    "text": "Amma... Amma... Amma... I have stopped the leaping spear, the sword that gathers up fury. Is this deceitful woman who mocked me greater than all of them? Yet it is she whom I cannot oppose, and I have run back here. Because of whom, Amma? Because of you—because of your command—because of the oath!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-031.json",
     "canonicalScenePath": "works/manohara/scenes/scene-031.md",
     "sourceRecordId": "manohara-s031-d001",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 43,
       "printed_page": 42
      }
     ]
    },
    "translation": {
     "mode": "semantic-poetic",
     "notes": [
      "The spear/sword escalation and repeated causal cadence are preserved."
     ]
    }
   },
   {
    "id": "manohara-en-s031-u003",
    "kind": "dialogue",
    "speakerLabel": "பத்மாவதி",
    "text": "Manohara! Tell me the matter! What happened?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-031.json",
     "canonicalScenePath": "works/manohara/scenes/scene-031.md",
     "sourceRecordId": "manohara-s031-d002",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 43,
       "printed_page": 42
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s031-u004",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Self-respect has been levelled to the ground; valour has been put up for price. A symbol of disgrace danced in arrogance! Amma! You must change your command at once.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-031.json",
     "canonicalScenePath": "works/manohara/scenes/scene-031.md",
     "sourceRecordId": "manohara-s031-d003",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 43,
       "printed_page": 42
      }
     ]
    },
    "translation": {
     "mode": "semantic-poetic",
     "notes": [
      "The three-part rhetorical escalation is retained."
     ]
    }
   },
   {
    "id": "manohara-en-s031-u005",
    "kind": "dialogue",
    "speakerLabel": "பத்",
    "text": "You have sworn an oath, my dear!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-031.json",
     "canonicalScenePath": "works/manohara/scenes/scene-031.md",
     "sourceRecordId": "manohara-s031-d004",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 43,
       "printed_page": 42
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s031-u006",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Must a warrior become a coward? Must throbbing shoulders droop? No... let me not keep that disastrous oath......",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-031.json",
     "canonicalScenePath": "works/manohara/scenes/scene-031.md",
