   {
    "id": "manohara-en-s053-u013",
    "kind": "dialogue",
    "speakerLabel": "வச",
    "text": "No... all this is your doing, isn't it! Mother... untie Anna! Hmm!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
     "sourceRecordId": "manohara-s053-d011",
