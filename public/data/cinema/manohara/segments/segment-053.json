   {
    "id": "manohara-en-s053-u007",
    "kind": "dialogue",
    "speakerLabel": "உக்ர",
    "text": "Pitiful creature! Why call your mother until your mouth aches? Wait a little! I shall send you to the very otherworld where your grandmother is.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
