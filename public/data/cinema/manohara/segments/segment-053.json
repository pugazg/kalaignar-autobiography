    }
   },
   {
    "id": "manohara-en-s053-u014",
    "kind": "dialogue",
    "speakerLabel": "வசந்தி",
    "text": "Vasantha... keep quiet. You know nothing.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
     "sourceRecordId": "manohara-s053-d012",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 81,
       "printed_page": 80
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s053-u015",
    "kind": "dialogue",
    "speakerLabel": "வச",
    "text": "I know everything. You put my beloved father, Periyamma and Anni all in prison; then you tied Anna too and started beating him. I cannot allow this.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
     "sourceRecordId": "manohara-s053-d013",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
