    }
   },
   {
    "id": "manohara-en-s053-u022",
    "kind": "dialogue",
    "speakerLabel": "வச",
    "text": "Ah! Tying up Anna and killing him—is that for the younger brother's good?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
     "sourceRecordId": "manohara-s053-d020",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 81,
       "printed_page": 80
      }
     ]
    },
    "translation": {
     "mode": "semantic-poetic"
    }
   },
   {
    "id": "manohara-en-s053-u023",
    "kind": "dialogue",
    "speakerLabel": "வசந்தி",
    "text": "My dear, don't you want to be king?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
     "sourceRecordId": "manohara-s053-d021",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 81,
       "printed_page": 80
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s053-u024",
    "kind": "dialogue",
    "speakerLabel": "வச",
    "text": "King? No! No. Then some queen will come to you and throw you in prison! Let me die if I must. I don't want that throne, Mother!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
     "sourceRecordId": "manohara-s053-d022",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 81,
       "printed_page": 80
      }
     ]
    },
    "translation": {
     "mode": "semantic-poetic"
    }
   },
   {
    "id": "manohara-en-s053-u025",
    "kind": "dialogue",
    "speakerLabel": "வசந்தி",
    "text": "It is all my fate! Of all things, you had to be born from my womb!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
     "sourceRecordId": "manohara-s053-d023",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 81,
       "printed_page": 80
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s053-u026",
    "kind": "dialogue",
    "speakerLabel": "வச",
    "text": "That's exactly what I worry about too.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
     "sourceRecordId": "manohara-s053-d024",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 81,
       "printed_page": 80
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s053-u027",
    "kind": "dialogue",
    "speakerLabel": "வசந்தி",
    "text": "Shut your mouth.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
     "sourceRecordId": "manohara-s053-d025",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 81,
       "printed_page": 80
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s053-u028",
    "kind": "dialogue",
    "speakerLabel": "வச",
    "text": "I can't.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
     "sourceRecordId": "manohara-s053-d026",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 82,
       "printed_page": 81
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s053-u029",
    "kind": "dialogue",
    "speakerLabel": "வசந்தி",
    "text": "You can't?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-053.json",
     "canonicalScenePath": "works/manohara/scenes/scene-053.md",
     "sourceRecordId": "manohara-s053-d027",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
