   {
    "id": "manohara-en-s011-u014",
    "kind": "dialogue",
    "speakerLabel": "வசந்தன்",
    "text": "Mother! Is it you who speaks like this? You, descended from the line of that heroic mother who, hearing that her son had been wounded in the chest on the battlefield, vowed in anguish to break the vessel from which he drank her milk—and who rejoiced when she saw that her son had died with a wound on his back? Is it you who speaks so—coward! Coward!... Coward!...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-011.json",
     "canonicalScenePath": "works/manohara/scenes/scene-011.md",
     "sourceRecordId": "manohara-s011-d011",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 24,
       "printed_page": 23
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The deliberately overblown heroic-mother rhetoric is retained without silently correcting its paradoxical source wording."
     ]
    }
   },
   {
    "id": "manohara-en-s011-u015",
    "kind": "dialogue",
    "speakerLabel": "வசந்தி",
    "text": "Ayyo... fate!......... Vikata! I have sent for the physician—let Vasanthan's treatments begin...... The throne is waiting......",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-011.json",
     "canonicalScenePath": "works/manohara/scenes/scene-011.md",
