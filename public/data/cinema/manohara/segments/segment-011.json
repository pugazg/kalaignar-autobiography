   {
    "id": "manohara-en-s011-u017",
    "kind": "dialogue",
    "speakerLabel": "அரசன்",
    "text": "Manohara! Make the enemy know the glory of the warrior clan! Grind the enemy's arrogance into the dust!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-011.json",
     "canonicalScenePath": "works/manohara/scenes/scene-011.md",
     "sourceRecordId": "manohara-s011-d014",
