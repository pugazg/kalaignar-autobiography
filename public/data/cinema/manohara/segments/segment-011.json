   {
    "id": "manohara-en-s011-u026",
    "kind": "dialogue",
    "speakerLabel": "அரசன்",
    "text": "Vasanthi!...... Are you angry, my dear—\nManoharan is a boy—forgive him!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-011.json",
     "canonicalScenePath": "works/manohara/scenes/scene-011.md",
     "sourceRecordId": "manohara-s011-d020",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 25,
       "printed_page": 24
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s011-u027",
    "kind": "dialogue",
    "speakerLabel": "வசந்தி",
    "text": "I have never once been angry with him—he is the treasure of my desire—my beloved son—he may hate me—but to me he is moonlight—a star! Sugarcane juice!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-011.json",
     "canonicalScenePath": "works/manohara/scenes/scene-011.md",
     "sourceRecordId": "manohara-s011-d021",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 25,
       "printed_page": 24
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The moonlight/star/sugarcane-juice accumulation is retained rather than rationalized."
     ]
    }
   },
