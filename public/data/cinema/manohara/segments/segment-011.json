   {
    "id": "manohara-en-s011-u033",
    "kind": "dialogue",
    "speakerLabel": "பத்மாவதி",
    "text": "Come back a victorious warrior, Manohara, so that the mother who bore you and the golden land where you were born may rejoice!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-011.json",
     "canonicalScenePath": "works/manohara/scenes/scene-011.md",
     "sourceRecordId": "manohara-s011-d025",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 25,
       "printed_page": 24
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "`பொன்னாடு` is kept as the image of the golden native land."
     ]
    }
   },
   {
    "id": "manohara-en-s011-u034",
    "kind": "dialogue",
    "speakerLabel": "மனோகரன்",
    "text": "Amma! If I win, the Ratna throne will return! If not, this blood-soaked warrior's sword will return and bear you my news!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-011.json",
     "canonicalScenePath": "works/manohara/scenes/scene-011.md",
     "sourceRecordId": "manohara-s011-d026",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 25,
       "printed_page": 24
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The paired throne/sword return image is preserved."
     ]
    }
   },
