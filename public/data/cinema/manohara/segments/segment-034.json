   {
    "id": "manohara-en-s034-u004",
    "kind": "dialogue",
    "speakerLabel": "பத்",
    "text": "When I think of Manoharan, I am afraid.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-034.json",
     "canonicalScenePath": "works/manohara/scenes/scene-034.md",
     "sourceRecordId": "manohara-s034-d003",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
