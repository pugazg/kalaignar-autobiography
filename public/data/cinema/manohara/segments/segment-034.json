    }
   },
   {
    "id": "manohara-en-s034-u005",
    "kind": "dialogue",
    "speakerLabel": "சத்",
    "text": "There is no need to fear—I will take care of it.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-034.json",
     "canonicalScenePath": "works/manohara/scenes/scene-034.md",
     "sourceRecordId": "manohara-s034-d004",
