   },
   {
    "id": "manohara-en-s034-u014",
    "kind": "dialogue",
    "speakerLabel": "வ. சே",
    "text": "Listen to this, Maharaja! The queen......",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-034.json",
     "canonicalScenePath": "works/manohara/scenes/scene-034.md",
     "sourceRecordId": "manohara-s034-d009",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 47,
       "printed_page": 46
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s034-u015",
    "kind": "dialogue",
    "speakerLabel": "அர",
    "text": "Queen...... do not say that again! Woman without honour! Vagabond... whore! Vasanthi! You yourself give the order! She must be put in the underground prison.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-034.json",
     "canonicalScenePath": "works/manohara/scenes/scene-034.md",
     "sourceRecordId": "manohara-s034-d010",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 47,
       "printed_page": 46
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The king's escalating insults are translated directly rather than euphemized."
     ]
    }
   },
   {
    "id": "manohara-en-s034-u016",
    "kind": "dialogue",
    "speakerLabel": "வ. சே",
    "text": "Putting the queen in prison will cool your fury. At the spring festival Manoharan leapt at me because I spoke ill of his mother! What will he say now? Will he ask my pardon?...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-034.json",
     "canonicalScenePath": "works/manohara/scenes/scene-034.md",
     "sourceRecordId": "manohara-s034-d011",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 47,
       "printed_page": 46
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s034-u017",
    "kind": "dialogue",
    "speakerLabel": "அர",
    "text": "I shall make him ask... I shall make him apologize in the royal hall itself for speaking against you. Prison for Padmavathi! Manoharan must apologize to Vasantha Sena......",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-034.json",
     "canonicalScenePath": "works/manohara/scenes/scene-034.md",
     "sourceRecordId": "manohara-s034-d012",
