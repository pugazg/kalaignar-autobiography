   {
    "id": "manohara-en-s034-u013",
    "kind": "dialogue",
    "speakerLabel": "அர",
    "text": "Calm! Only in her death will I have calm!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-034.json",
     "canonicalScenePath": "works/manohara/scenes/scene-034.md",
     "sourceRecordId": "manohara-s034-d008",
