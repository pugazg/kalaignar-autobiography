    }
   },
   {
    "id": "manohara-en-s035-u005",
    "kind": "dialogue",
    "speakerLabel": "பத்",
    "text": "Yes, my dear! Do not forget that—the father who begot you.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-035.json",
     "canonicalScenePath": "works/manohara/scenes/scene-035.md",
     "sourceRecordId": "manohara-s035-d004",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 48,
       "printed_page": 47
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s035-u006",
    "kind": "dialogue",
    "speakerLabel": "ராஜப்",
    "text": "Father... he gained a fearless-hearted son... he gained a wife of rare virtue... there is one thing he forgot to gain, Mother! Sense! Sense! That alone he forgot to gain!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-035.json",
     "canonicalScenePath": "works/manohara/scenes/scene-035.md",
     "sourceRecordId": "manohara-s035-d005",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 48,
       "printed_page": 47
      }
     ]
    },
    "translation": {
     "mode": "semantic-poetic",
     "notes": [
      "The repeated `அறிவு! அறிவு!` is retained for Rajapriyan's punchline."
     ]
    }
   },
   {
    "id": "manohara-en-s035-u007",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "I shall remind him of what he forgot...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-035.json",
     "canonicalScenePath": "works/manohara/scenes/scene-035.md",
     "sourceRecordId": "manohara-s035-d006",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 48,
       "printed_page": 47
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s035-u008",
    "kind": "dialogue",
    "speakerLabel": "பத்",
    "text": "I am telling you that you cannot, my treasure! Appa may have erred in haste... whatever it is, go and ask the reason!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-035.json",
     "canonicalScenePath": "works/manohara/scenes/scene-035.md",
     "sourceRecordId": "manohara-s035-d007",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 48,
       "printed_page": 47
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s035-u009",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Ask the reason?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-035.json",
     "canonicalScenePath": "works/manohara/scenes/scene-035.md",
     "sourceRecordId": "manohara-s035-d008",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 48,
       "printed_page": 47
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s035-u010",
    "kind": "dialogue",
    "speakerLabel": "விஜயா",
    "text": "Athai... no... do not send him... no, Athai... do not send him... no, Athai... that is it—you must not go...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-035.json",
     "canonicalScenePath": "works/manohara/scenes/scene-035.md",
     "sourceRecordId": "manohara-s035-d009",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 48,
       "printed_page": 47
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The repeated pleading is preserved rather than compressed."
     ]
    }
   },
   {
    "id": "manohara-en-s035-u011",
    "kind": "dialogue",
    "speakerLabel": "பத்",
    "text": "Brave son... go and return...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-035.json",
     "canonicalScenePath": "works/manohara/scenes/scene-035.md",
     "sourceRecordId": "manohara-s035-d010",
