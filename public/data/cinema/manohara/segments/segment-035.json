   {
    "id": "manohara-en-s035-u013",
    "kind": "dialogue",
    "speakerLabel": "பத்",
    "text": "Vijaya!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-035.json",
     "canonicalScenePath": "works/manohara/scenes/scene-035.md",
     "sourceRecordId": "manohara-s035-d012",
