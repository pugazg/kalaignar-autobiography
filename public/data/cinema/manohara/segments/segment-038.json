   {
    "id": "manohara-en-s038-u012",
    "kind": "dialogue",
    "speakerLabel": "வ. சே",
    "text": "What doubt is there about that, girl?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-038.json",
     "canonicalScenePath": "works/manohara/scenes/scene-038.md",
     "sourceRecordId": "manohara-s038-d010",
