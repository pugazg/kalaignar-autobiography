    }
   },
   {
    "id": "manohara-en-s038-u040",
    "kind": "dialogue",
    "speakerLabel": "விகடன்",
    "text": "Next, if a king from another country comes happily, you must speak happily; if he comes angrily, you must speak angrily...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-038.json",
     "canonicalScenePath": "works/manohara/scenes/scene-038.md",
     "sourceRecordId": "manohara-s038-d036",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
