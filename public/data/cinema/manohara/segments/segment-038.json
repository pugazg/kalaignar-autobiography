    }
   },
   {
    "id": "manohara-en-s038-u039",
    "kind": "dialogue",
    "speakerLabel": "வச",
    "text": "[Grinning]... Shabash....",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-038.json",
     "canonicalScenePath": "works/manohara/scenes/scene-038.md",
     "sourceRecordId": "manohara-s038-d035",
