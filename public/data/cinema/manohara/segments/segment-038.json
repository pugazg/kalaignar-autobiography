    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s038-u037",
    "kind": "dialogue",
    "speakerLabel": "வைத்",
    "text": "There... we can make Malini the queen... come...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-038.json",
     "canonicalScenePath": "works/manohara/scenes/scene-038.md",
     "sourceRecordId": "manohara-s038-d033",
