    }
   },
   {
    "id": "manohara-en-s038-u013",
    "kind": "dialogue",
    "speakerLabel": "தோழி",
    "text": "Leave that... why are you being so careless... Manoharan has escaped too. Shouldn't Vasanthan's coronation be conducted quickly?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-038.json",
     "canonicalScenePath": "works/manohara/scenes/scene-038.md",
     "sourceRecordId": "manohara-s038-d011",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 59,
       "printed_page": 58
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s038-u014",
    "kind": "dialogue",
    "speakerLabel": "வ. சே",
    "text": "What great task is that, girl? I am the king's very Veda-book. If I say the moon is the sun, he is bound to believe it... do not worry! With one flick of my eye, Vasanthan's coronation will be finished!",
    "source": {
