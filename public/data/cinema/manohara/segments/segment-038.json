   {
    "id": "manohara-en-s038-u022",
    "kind": "dialogue",
    "speakerLabel": "விகடன்",
    "text": "Vasantha! Look here... Amma will scold us, get up... it must look like a real durbar... you must do as I say... hmm... sit here, Maharaja!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-038.json",
     "canonicalScenePath": "works/manohara/scenes/scene-038.md",
     "sourceRecordId": "manohara-s038-d019",
