    }
   },
   {
    "id": "manohara-en-s038-u042",
    "kind": "dialogue",
    "speakerLabel": "விக",
    "text": "Hmm—the durbar may begin....",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-038.json",
     "canonicalScenePath": "works/manohara/scenes/scene-038.md",
     "sourceRecordId": "manohara-s038-d038",
