    "kind": "dialogue",
    "speakerLabel": "விக",
    "text": "(To Malini) Listen to me just a little... only for today you are Maharani... go and sit with the Maharaja...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-038.json",
     "canonicalScenePath": "works/manohara/scenes/scene-038.md",
