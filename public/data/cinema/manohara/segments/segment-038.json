    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s038-u036",
    "kind": "dialogue",
    "speakerLabel": "விக",
    "text": "Maharaja... he is the commander...... now who is the Maharani?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-038.json",
     "canonicalScenePath": "works/manohara/scenes/scene-038.md",
     "sourceRecordId": "manohara-s038-d032",
