    }
   },
   {
    "id": "manohara-en-s041-u016",
    "kind": "dialogue",
    "speakerLabel": "போ. அக்ஷ.",
    "text": "Acting? That's easy!... Oh!...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-041.json",
     "canonicalScenePath": "works/manohara/scenes/scene-041.md",
     "sourceRecordId": "manohara-s041-d012",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
