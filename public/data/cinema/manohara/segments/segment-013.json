    }
   },
   {
    "id": "manohara-en-s013-u013",
    "kind": "dialogue",
    "speakerLabel": "முத்து",
    "text": "Come on, little brother!...\nYoung man who does not know how to hold a sword! Do not imagine you have encircled the fort.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-013.json",
     "canonicalScenePath": "works/manohara/scenes/scene-013.md",
     "sourceRecordId": "manohara-s013-d011",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 27,
