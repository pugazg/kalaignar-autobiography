    }
   },
   {
    "id": "manohara-en-s013-u006",
    "kind": "dialogue",
    "speakerLabel": "முத்து விஜயன்",
    "text": "Blood... blood is a swimming pool to me. War is a pastime to me! Not knowing that, this brute comes crashing against Muthu Vijayan!",
