      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s013-u014",
    "kind": "dialogue",
    "speakerLabel": "மனோகரன்",
    "text": "I have heard that you are a warrior... in the swing of your tongue!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-013.json",
     "canonicalScenePath": "works/manohara/scenes/scene-013.md",
     "sourceRecordId": "manohara-s013-d012",
