    "kind": "dialogue",
    "speakerLabel": "மு. வி",
    "text": "Where is the commander? Where is that lion-hearted man?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-013.json",
     "canonicalScenePath": "works/manohara/scenes/scene-013.md",
     "sourceRecordId": "manohara-s013-d007",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
