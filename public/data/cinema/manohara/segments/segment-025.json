    }
   },
   {
    "id": "manohara-en-s025-u005",
    "kind": "dialogue",
    "speakerLabel": "அர",
    "text": "Hmm... you may.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-025.json",
     "canonicalScenePath": "works/manohara/scenes/scene-025.md",
     "sourceRecordId": "manohara-s025-d004",
