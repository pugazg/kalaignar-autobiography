    }
   },
   {
    "id": "manohara-en-s039-u013",
    "kind": "dialogue",
    "speakerLabel": "அர",
    "text": "All right... I am going...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-039.json",
     "canonicalScenePath": "works/manohara/scenes/scene-039.md",
     "sourceRecordId": "manohara-s039-d012",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
