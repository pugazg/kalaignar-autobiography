    }
   },
   {
    "id": "manohara-en-s039-u014",
    "kind": "dialogue",
    "speakerLabel": "வச",
    "text": "Ayyo!... my life will leave me—sit down.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-039.json",
     "canonicalScenePath": "works/manohara/scenes/scene-039.md",
     "sourceRecordId": "manohara-s039-d013",
