   },
   {
    "id": "manohara-en-s045-u007",
    "kind": "dialogue",
    "speakerLabel": "பத்மா",
    "text": "My dear... daughter of the Pandiyan king...... did you come as my daughter-in-law to suffer like this......",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-045.json",
     "canonicalScenePath": "works/manohara/scenes/scene-045.md",
     "sourceRecordId": "manohara-s045-d004",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 71,
       "printed_page": 70
      }
     ]
    },
    "translation": {
     "mode": "semantic-poetic"
    }
   },
   {
    "id": "manohara-en-s045-u008",
    "kind": "dialogue",
    "speakerLabel": "விஜயா",
    "text": "Only after I came, Atthe, have so many torments come upon you and your beloved son...... all of it only after this sinner set foot here........",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-045.json",
     "canonicalScenePath": "works/manohara/scenes/scene-045.md",
     "sourceRecordId": "manohara-s045-d005",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 71,
       "printed_page": 70
      }
     ]
    },
    "translation": {
     "mode": "semantic-poetic",
     "notes": [
      "Vijaya's self-blaming `பாவி` is retained rather than softened."
     ]
    }
   },
   {
    "id": "manohara-en-s045-u009",
    "kind": "dialogue",
    "speakerLabel": "பத்",
    "text": "Vijaya!... No, child... wherever your flower-feet touch, even earth turns to gold... you are not the one who turned the golden mansion into a mound of dust... she lives in bliss......",
