   },
   {
    "id": "manohara-en-s046-u003",
    "kind": "dialogue",
    "speakerLabel": "உக்",
    "text": "Everything your fingers touch turns sweet.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-046.json",
     "canonicalScenePath": "works/manohara/scenes/scene-046.md",
     "sourceRecordId": "manohara-s046-d002",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
