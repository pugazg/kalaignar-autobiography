    }
   },
   {
    "id": "manohara-en-s049-u008",
    "kind": "dialogue",
    "speakerLabel": "சேனா",
    "text": "Who is there but you to do this deed? Here! Go this very moment!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-049.json",
     "canonicalScenePath": "works/manohara/scenes/scene-049.md",
     "sourceRecordId": "manohara-s049-d007",
