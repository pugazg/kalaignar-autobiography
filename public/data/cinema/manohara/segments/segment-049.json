      }
     ]
    },
    "translation": {
     "mode": "semantic-poetic"
    }
   },
   {
    "id": "manohara-en-s049-u007",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Ah! What—me?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-049.json",
     "canonicalScenePath": "works/manohara/scenes/scene-049.md",
     "sourceRecordId": "manohara-s049-d006",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
