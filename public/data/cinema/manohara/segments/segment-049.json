    }
   },
   {
    "id": "manohara-en-s049-u009",
    "kind": "stage-direction",
    "speakerLabel": null,
    "text": "[She gives him the signet ring.]",
    "source": {
     "sourcePath": "works/manohara/scenes/scene-049.md",
