    }
   },
   {
    "id": "manohara-en-s049-u004",
    "kind": "dialogue",
    "speakerLabel": "சேனா",
    "text": "What is it, Akshaya?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-049.json",
     "canonicalScenePath": "works/manohara/scenes/scene-049.md",
     "sourceRecordId": "manohara-s049-d003",
