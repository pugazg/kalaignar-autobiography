    }
   },
   {
    "id": "manohara-en-s049-u006",
    "kind": "dialogue",
    "speakerLabel": "சேனா",
    "text": "Yes. You must pluck out that very bud and cast it away!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-049.json",
     "canonicalScenePath": "works/manohara/scenes/scene-049.md",
     "sourceRecordId": "manohara-s049-d005",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
