   {
    "id": "manohara-en-s049-u012",
    "kind": "dialogue",
    "speakerLabel": "மனக்குரல்",
    "text": "Manohara, stop. Do not give way to fury; do not become a slave to haste! The palace is full of enemies. Your mother is in prison—your father is suffering. You rush forward with sword outstretched... who will protect your unfading flowers? Who will protect your many-coloured parrots?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-049.json",
     "canonicalScenePath": "works/manohara/scenes/scene-049.md",
     "sourceRecordId": "manohara-s049-d009",
     "sourceOccurrenceId": null,
