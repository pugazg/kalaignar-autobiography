   {
    "id": "manohara-en-s049-u005",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "Nothing...... nothing. A bud has sprouted at the very moment of destruction!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-049.json",
     "canonicalScenePath": "works/manohara/scenes/scene-049.md",
     "sourceRecordId": "manohara-s049-d004",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
