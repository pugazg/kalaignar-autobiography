   {
    "id": "manohara-en-s030-u020",
    "kind": "dialogue",
    "speakerLabel": "வசந்தன்",
    "text": "Amma!... Anna and Anni are laughing at me!...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-030.json",
     "canonicalScenePath": "works/manohara/scenes/scene-030.md",
     "sourceRecordId": "manohara-s030-d014",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 41,
       "printed_page": 40
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "Family-address terms are retained."
     ]
    }
   },
   {
    "id": "manohara-en-s030-u021",
    "kind": "dialogue",
    "speakerLabel": "வசந்தி",
    "text": "The town laughs at your brother because he took the Pandiyan's daughter in marriage. The whole world laughs at your Anni because she became wife to the man who killed her father...\n[Grinding her teeth]......\nThey laugh, do they...... I shall laugh away everything... come, you!...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-030.json",
     "canonicalScenePath": "works/manohara/scenes/scene-030.md",
     "sourceRecordId": "manohara-s030-d015",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 42,
       "printed_page": 41
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The source-attached teeth-grinding cue remains within the immutable linked turn."
     ]
    }
   },
   {
    "id": "manohara-en-s030-u022",
    "kind": "dialogue",
    "speakerLabel": "வசந்தன்",
    "text": "You can't do all that, Amma!... Anna is going to make you writhe like a worm—be careful! He just told Anni that. My Anni!",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-030.json",
     "canonicalScenePath": "works/manohara/scenes/scene-030.md",
     "sourceRecordId": "manohara-s030-d016",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 42,
       "printed_page": 41
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s030-u023",
    "kind": "stage-direction",
    "speakerLabel": null,
    "text": "[Mockingly]",
    "source": {
     "sourcePath": "works/manohara/scenes/scene-030.md",
     "canonicalScenePath": "works/manohara/scenes/scene-030.md",
     "sourceRecordId": null,
     "sourceOccurrenceId": null,
     "sourceLocator": {
      "kind": "delivery-cue",
      "ordinal": 1,
      "description": "Vasantha Sena speaks mockingly."
