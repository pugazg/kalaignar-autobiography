    "kind": "dialogue",
    "speakerLabel": "பத்மாவதி",
    "text": "Manohara!... what happened?",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-027.json",
     "canonicalScenePath": "works/manohara/scenes/scene-027.md",
