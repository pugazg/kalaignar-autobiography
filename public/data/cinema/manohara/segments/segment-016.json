      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s016-u015",
    "kind": "dialogue",
    "speakerLabel": "மனோ",
    "text": "The explanation for that—tomorrow, in the inquiry hall.",
    "source": {
