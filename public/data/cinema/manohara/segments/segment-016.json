    }
   },
   {
    "id": "manohara-en-s016-u008",
    "kind": "stage-direction",
    "speakerLabel": null,
    "text": "(Rajapriyan enters.)",
    "source": {
     "sourcePath": "works/manohara/scenes/scene-016.md",
