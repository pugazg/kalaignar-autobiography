    }
   },
   {
    "id": "manohara-en-s016-u005",
    "kind": "dialogue",
    "speakerLabel": "மனோகரன்",
    "text": "Never mind. I have saved a flowering creeper from the storm of death.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-016.json",
     "canonicalScenePath": "works/manohara/scenes/scene-016.md",
     "sourceRecordId": "manohara-s016-d003",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 30,
       "printed_page": 29
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful",
     "notes": [
      "The flower-creeper/death-storm image is retained."
     ]
    }
   },
   {
    "id": "manohara-en-s016-u006",
    "kind": "dialogue",
    "speakerLabel": "விஜயா",
    "text": "No one need stop the death of this slave.",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-016.json",
     "canonicalScenePath": "works/manohara/scenes/scene-016.md",
     "sourceRecordId": "manohara-s016-d004",
     "sourceOccurrenceId": null,
     "sourceLocator": null,
     "pageProvenance": [
      {
       "pdf_page": 30,
       "printed_page": 29
      }
     ]
    },
    "translation": {
     "mode": "prose-faithful"
    }
   },
   {
    "id": "manohara-en-s016-u007",
    "kind": "dialogue",
    "speakerLabel": "மனோகரன்",
    "text": "Slave? Who is a slave? You are a princess made of beauty itself...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-016.json",
     "canonicalScenePath": "works/manohara/scenes/scene-016.md",
     "sourceRecordId": "manohara-s016-d005",
