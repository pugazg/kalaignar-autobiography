    "kind": "dialogue",
    "speakerLabel": "விஜயா",
    "text": "Entering the women's inner chamber in the dark is greater cowardice still...",
    "source": {
     "sourcePath": "works/manohara/dialogues/records/scene-016.json",
     "canonicalScenePath": "works/manohara/scenes/scene-016.md",
     "sourceRecordId": "manohara-s016-d002",
